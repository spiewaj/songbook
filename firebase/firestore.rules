rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSongbookOwner(data) {
      return isAuthenticated() && data != null && (
        (data.get('ownerIds', null) != null && request.auth.uid in data.ownerIds) ||
        (data.get('creatorId', null) == request.auth.uid) ||
        (data.get('ownerId', null) == request.auth.uid) // legacy backwards compatibility
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.get('admin', false) == true) ||
        (request.auth.token.email != null && request.auth.token.email in [
          'piotr.tabor@gmail.com'
        ]) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAcceptingVerifiedInvite(data, nextData, songbookId) {
      return isAuthenticated() &&
        !(request.auth.uid in data.ownerIds) &&
        (request.auth.uid in nextData.ownerIds) &&
        data.yaml == nextData.yaml &&
        data.creatorId == nextData.creatorId &&
        data.id == nextData.id &&
        nextData.get('members', null) != null &&
        nextData.members.get(request.auth.uid, null) != null &&
        nextData.members[request.auth.uid].get('inviteId', null) != null &&
        exists(/databases/$(database)/documents/invites/$(nextData.members[request.auth.uid].inviteId)) &&
        get(/databases/$(database)/documents/invites/$(nextData.members[request.auth.uid].inviteId)).data.songbookId == songbookId &&
        get(/databases/$(database)/documents/invites/$(nextData.members[request.auth.uid].inviteId)).data.status == 'accepted' &&
        get(/databases/$(database)/documents/invites/$(nextData.members[request.auth.uid].inviteId)).data.acceptedByUid == request.auth.uid;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Invites Collection
    match /invites/{inviteId} {
      // Anyone with the invite link can fetch the invite to preview it
      allow get: if true;
      // List invites: only authenticated users
      allow list: if isAuthenticated();

      // Creating invites: authenticated owner or admin
      allow create: if isAuthenticated() && (
        isSongbookOwner(get(/databases/$(database)/documents/songbooks/$(request.resource.data.songbookId)).data) ||
        isAdmin()
      );

      // Updating invites:
      // Invitee can accept/reject; inviter or admin can update/revoke
      allow update: if isAuthenticated() && (
        (resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'rejected'] && request.resource.data.acceptedByUid == request.auth.uid) ||
        (resource.data.inviterUid == request.auth.uid) ||
        isAdmin()
      );

      // Deleting invites: inviter or admin
      allow delete: if isAuthenticated() && (
        (resource.data.inviterUid == request.auth.uid) ||
        isAdmin()
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId) || isAdmin();

      // Favorite Songs Subcollection
      match /favorite_songs/{songId} {
        allow read, write: if isUser(userId) || isAdmin();
      }
    }

    // Songbooks Collection
    match /songbooks/{songbookId} {
      // Single doc read: allow if not found (exists() == false), or public, or owner, or admin
      allow get: if resource == null || resource.data.isPublic == true || isSongbookOwner(resource.data) || isAdmin();

      // Collection list/queries: public or owned or admin
      allow list: if resource.data.isPublic == true || isSongbookOwner(resource.data) || isAdmin();
      
      // Only authenticated users can create songbooks.
      // Creator must list themselves in ownerIds or creatorId (or admin).
      allow create: if isAuthenticated() && (
        (request.resource.data.get('ownerIds', null) != null && request.auth.uid in request.resource.data.ownerIds) ||
        (request.resource.data.get('creatorId', null) == request.auth.uid) ||
        (request.resource.data.get('ownerId', null) == request.auth.uid) ||
        isAdmin()
      );
      
      // Any owner, admin, or invited user accepting an invite can update the songbook.
      allow update: if isSongbookOwner(resource.data) || isAdmin() || isAcceptingVerifiedInvite(resource.data, request.resource.data, songbookId);

      // Deletion allowed for creator, any owner, or admin.
      allow delete: if isAuthenticated() && (
        (resource.data.get('creatorId', null) == request.auth.uid) ||
        isSongbookOwner(resource.data) ||
        isAdmin()
      );
    }
  }
}
