rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSongbookOwner(data) {
      return isAuthenticated() && data != null && (
        (data.get('ownerIds', null) != null && request.auth.uid in data.ownerIds) ||
        (data.get('creatorId', null) == request.auth.uid) ||
        (data.get('ownerId', null) == request.auth.uid) // legacy backwards compatibility
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.get('admin', false) == true) ||
        (request.auth.token.email != null && request.auth.token.email in [
          'piotr.tabor@gmail.com'
        ]) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId) || isAdmin();

      // Favorite Songs Subcollection
      match /favorite_songs/{songId} {
        allow read, write: if isUser(userId) || isAdmin();
      }
    }

    // Songbooks Collection
    match /songbooks/{songbookId} {
      // Single doc read: allow if not found (exists() == false), or public, or owner, or admin
      allow get: if resource == null || resource.data.isPublic == true || isSongbookOwner(resource.data) || isAdmin();

      // Collection list/queries: public or owned or admin
      allow list: if resource.data.isPublic == true || isSongbookOwner(resource.data) || isAdmin();
      
      // Only authenticated users can create songbooks.
      // Creator must list themselves in ownerIds or creatorId (or admin).
      allow create: if isAuthenticated() && (
        (request.resource.data.get('ownerIds', null) != null && request.auth.uid in request.resource.data.ownerIds) ||
        (request.resource.data.get('creatorId', null) == request.auth.uid) ||
        (request.resource.data.get('ownerId', null) == request.auth.uid) ||
        isAdmin()
      );
      
      // Any owner or admin can update the songbook.
      allow update: if isSongbookOwner(resource.data) || isAdmin();

      // Deletion allowed for creator, any owner, or admin.
      allow delete: if isAuthenticated() && (
        (resource.data.get('creatorId', null) == request.auth.uid) ||
        isSongbookOwner(resource.data) ||
        isAdmin()
      );
    }
  }
}
