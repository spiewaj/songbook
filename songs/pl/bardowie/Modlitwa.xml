<?xml version="1.0" encoding="utf-8"?>
<song title="Modlitwa" xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd">
	<alias>Jeśli nas Matka Boska nie obroni</alias>
	<text_author type="solo">Jacek Kaczmarski</text_author>
	<comment>Napisana 20 października 1989 r. Część cyklu „Pięć głosów z kraju”. Program i album „Dzieci Hioba” (1989).</comment>
	<composer type="solo">Jacek Kaczmarski</composer>
	<artist type="solo">Jacek Kaczmarski</artist>
	<lyric xmlns="http://21wdh.staszic.waw.pl">
		<block type="verse">
			<row important_over="true">J<ch a="e"/>eśli nas M<ch a="a"/>atka B<ch a="e"/>oska nie obr<ch a="a"/>oni,</row>
			<row important_over="true"><ch a="C"/> To co się stanie z tym nar<ch a="H7"/>odem?</row>
			<row important_over="true"><ch a="a"/> Codzienne m<ch a="H7"/>odły wi<ch a="C"/>ęc zanoszę d<ch a="a"/>o Niej,</row>
			<row important_over="true"><ch a="G"/> By ocalił<ch a="a"/>a nas przed gł<ch a="H7"/>odem.</row>
		</block>
		<block type="verse">
			<row important_over="false">Prz<ch a="e"/>ed głodem <ch a="a"/>ust, kt<ch a="e"/>órym zabrakło chl<ch a="a"/>eba,</row>
			<row important_over="false"><ch a="C"/> Przed głodem serc, w których nie mieszka m<ch a="H7"/>iłość,</row>
			<row important_over="false"><ch a="a"/> Przed głodem z<ch a="H7"/>emsty, kt<ch a="C"/>órej nam nie trz<ch a="a"/>eba,</row>
			<row important_over="false"><ch a="G"/> Przed głodem władzy,<ch a="a"/> co jest tylko s<ch a="H7"/>iłą.</row>
		</block>
		<block type="verse">
			<row important_over="false">J<ch a="e"/>eśli nas M<ch a="a"/>atka B<ch a="e"/>oska nie obr<ch a="a"/>oni,</row>
			<row important_over="false"><ch a="C"/> To co się stanie z Polak<ch a="H7"/>ami?</row>
			<row important_over="false"><ch a="a"/> Codzienne m<ch a="H7"/>odły wi<ch a="C"/>ęc zanoszę d<ch a="a"/>o Niej,</row>
			<row important_over="false"><ch a="G"/> By ocaliła n<ch a="a"/>as — przed n<ch a="H7"/>ami.</row>
		</block>
		<block type="verse">
			<row important_over="false">N<ch a="e"/>ami, co t<ch a="a"/>oną, t<ch a="e"/>onąc innych t<ch a="a"/>opią,</row>
			<row important_over="false"><ch a="C"/> Co marzą, innym odmawiając m<ch a="H7"/>arzeń,</row>
			<row important_over="false"><ch a="a"/> Co z głową w p<ch a="H7"/>ętli j<ch a="C"/>eszcze nogą k<ch a="a"/>opią,</row>
			<row important_over="false"><ch a="G"/> By ślad zostawić<ch a="a"/> na kopniętej tw<ch a="H7"/>arzy.</row>
		</block>
		<blocklink blocknb="3"/>
	</lyric>
