<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Daktyl">
  <alias>Całus ma słodycz daktyla</alias>
  <text_author type="solo">Tradycyjna</text_author>
  <comment>Piosenka harcerska i biesiadna o nieznanym autorze.</comment>
  <composer type="solo">Tradycyjna</composer>
  <artist type="solo">Tradycyjna</artist>
  <translator/>
  <original_title/>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="C"/>Gdy czarem powabu owi<ch a="F"/>ana motyla,</row>
      <row important_over="true"><ch a="G"/>Dzieweczka jak anioł ust<ch a="C"/>eczka rozchyla,</row>
      <row important_over="false"><ch a="C"/>To wtedy mnie bierze ogr<ch a="F"/>omna pokusa,</row>
      <row important_over="false"><ch a="G"/>By skraść jej przynajmniej j<ch a="C"/>ednego całusa.</row>
    </block>
    <block type="chorus">
      <row important_over="true"><ch a="F"/>Bo całus ma słodycz d<ch a="C"/>aktyla,</row>
      <row important_over="false"><ch a="F"/>On życie harcerza um<ch a="C"/>ila,</row>
      <row important_over="true"><ch a="C"/>On życie harcerza um<ch a="F"/>ila i słodzi —</row>
      <row important_over="false"><ch a="G"/>Całuje się harcmistrz, podh<ch a="C"/>arcmistrz i młodzik.</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="C"/>Lecz czasem się zdarzy, o d<ch a="F"/>olo ma smutna,</row>
      <row important_over="false"><ch a="G"/>Że zjawi się jakaś harc<ch a="C"/>erka okrutna,</row>
      <row important_over="false"><ch a="C"/>A wtedy, choć kruszę jej s<ch a="F"/>erca marmury,</row>
      <row important_over="false"><ch a="G"/>To ona mej duszy zad<ch a="C"/>aje tortury.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false"><ch a="C"/>Lecz częściej się zdarzy, o d<ch a="F"/>olo radosna,</row>
      <row important_over="false"><ch a="G"/>Że znajdzie się jakaś harc<ch a="C"/>erka rozkoszna,</row>
      <row important_over="false"><ch a="C"/>A wtedy z jej ustek p<ch a="F"/>ełnego pucharu</row>
      <row important_over="false"><ch a="G"/>Wypijam ja słodycz rajsk<ch a="C"/>iego nektaru.</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
