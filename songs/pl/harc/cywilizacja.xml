  <lyric>
    <block type="verse">
      <row important_over="true">W l<ch a="a"/>esie na pol<ch a="G"/>anie <ch a="e"/>pali się ogn<ch a="a"/>isko,</row>
      <row important_over="true">a wsz<ch a="a"/>yscy harc<ch a="G"/>erze si<ch a="E"/>edzą przy nim bl<ch a="a"/>isko.</row>
    </block>
    <block type="chorus">
      <row important_over="true">I nik<ch a="F"/>omu niepotrz<ch a="G"/>ebna jest dz<ch a="C"/>iś cywiliz<ch a="a"/>acja,</row>
      <row important_over="true">no bo prz<ch a="F"/>ecież każdy j<ch a="G"/>est na wak<ch a="a"/>acjach.</row>
    </block>
    <block type="verse">
      <row important_over="false">Ż<ch a="a"/>ycie mi um<ch a="G"/>ila zap<ch a="e"/>ach dzikich kwi<ch a="a"/>atów,</row>
      <row important_over="false">sł<ch a="a"/>ońce mi przybl<ch a="G"/>iża świ<ch a="E"/>ergot dzikich pt<ch a="a"/>aków.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false">J<ch a="a"/>utro o tej p<ch a="G"/>orze będz<ch a="e"/>ie tutaj p<ch a="a"/>usto,</row>
      <row important_over="false">b<ch a="a"/>o wszyscy harc<ch a="G"/>erze ob<ch a="E"/>óz ten op<ch a="a"/>uszczą.</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
