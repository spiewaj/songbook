<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Mały obóz">
  <alias>Kiedy rankiem ze skowronkiem</alias>
  <text_author type="solo">Piotr Snarski</text_author>
  <comment/>
  <composer type="solo">Piotr Snarski</composer>
  <artist type="band">Piosenka harcerska</artist>
  <lyric>
    <block type="verse">
      <row important_over="true">Kiedy r<ch a="C"/>ankiem ze skowronkiem</row>
      <row important_over="true">powit<ch a="e"/>amy nowy dzień,</row>
      <row important_over="true">rosy z tr<ch a="A"/>awy się nap<ch a="A7"/>ijesz,</row>
      <row important_over="true">pierwszy sł<ch a="d"/>ońca promień zjesz.</row>
      <row important_over="false">Potem wr<ch a="F"/>acać trzeba b<ch a="f"/>ędzie,</row>
      <row important_over="false">pożegn<ch a="C"/>amy rzekę, l<ch a="a"/>as,</row>
      <row important_over="false">bądźcie zdr<ch a="d"/>owi, nasi bracia,</row>
      <row important_over="false">bądźcie zdr<ch a="G"/>owi, na nas czas!</row>
    </block>
    <block type="chorus">
      <row important_over="true">Ustaw<ch a="C"/>imy mały obóz,</row>
      <row important_over="true">bramę zb<ch a="e"/>udujemy z serc,</row>
      <row important_over="true">a z tych d<ch a="A"/>usz, co tak gor<ch a="A7"/>ące,</row>
      <row important_over="true">zbuduj<ch a="d"/>emy sobie piec.</row>
      <row important_over="true">Rozpal<ch a="F"/>imy mały <ch a="f"/>ogień,</row>
      <row important_over="true">a w tym <ch a="C"/>ogniu będziesz pi<ch a="a"/>ekł</row>
      <row important_over="true">naszą prz<ch a="d"/>yjaźń, która łączy,</row>
      <row important_over="true">która d<ch a="G"/>a ci to, co chcesz.</row>
    </block>
    <block type="verse">
      <row important_over="false">My tu j<ch a="C"/>eszcze powrócimy,</row>
      <row important_over="false">nie za r<ch a="e"/>ok, no to za dwa,</row>
      <row important_over="false">więc dlacz<ch a="A"/>ego płacze rz<ch a="A7"/>eka,</row>
      <row important_over="false">a więc cz<ch a="d"/>emu szumi las?</row>
      <row important_over="false">Wszak przyj<ch a="F"/>aźni naszej wi<ch a="f"/>elkiej</row>
      <row important_over="false">nie rozł<ch a="C"/>ączy promień zł<ch a="a"/>a –</row>
      <row important_over="false">ona m<ch a="d"/>ocna jest bezczelnie,</row>
      <row important_over="false">więc my wsz<ch a="G"/>yscy jeszcze raz:</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
