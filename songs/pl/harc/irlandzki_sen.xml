  <alias>Tylko konia osiodłać</alias>
  <text_author type="solo">tradycyjny</text_author>
  <comment/>
  <composer type="solo">tradycyjny</composer>
  <artist type="band">Piosenka harcerska</artist>
  <translator/>
  <original_title/>
  <lyric>
    <block type="verse">
      <row important_over="true">T<ch a="a"/>ylko konia osiodłać i przez wrzosowiska,</row>
      <row important_over="true">T<ch a="G"/>am, gdzie elfy i czarown<ch a="a"/>ice,</row>
      <row important_over="true">A przydr<ch a="a"/>ożne kamienie imi<ch a="G"/>ona celtyckie</row>
      <row important_over="true">D<ch a="F"/>umnie n<ch a="G"/>oszą jak tajemn<ch a="a"/>ice.</row>
    </block>
    <block type="verse">
      <row important_over="false">T<ch a="a"/>ylko konia osiodłać i przez wrzosowiska,</row>
      <row important_over="false">M<ch a="G"/>yślą z samym ścigać się B<ch a="a"/>ogiem,</row>
      <row important_over="false">Cz<ch a="a"/>arne myśli powkładać jak drw<ch a="G"/>a do ogniska,</row>
      <row important_over="false">Gd<ch a="F"/>y noc chm<ch a="G"/>urna zastąpi ci dr<ch a="a"/>ogę.</row>
    </block>
    <block type="chorus">
      <row important_over="true">Ach, śn<ch a="a"/>ij mi się, śnij, irl<ch a="G"/>andzki śnie,</row>
      <row important_over="true">C<ch a="F"/>ałego p<ch a="G"/>orwij mnie, ach, p<ch a="a"/>orwij mnie,</row>
      <row important_over="true">A od m<ch a="a"/>orza wiatr niech ni<ch a="G"/>esie mnie gdzieś</row>
      <row important_over="true">W irl<ch a="F"/>andzki, zi<ch a="G"/>elony s<ch a="a"/>en.</row>
    </block>
    <block type="verse">
      <row important_over="false">T<ch a="a"/>ylko konia osiodłać i przez wrzosowiska,</row>
      <row important_over="false">N<ch a="G"/>ad leśnego ruczaju kryszt<ch a="a"/>ałem,</row>
      <row important_over="false">W<ch a="a"/>oda moc ma czarowną, koń s<ch a="G"/>iły odzyska,</row>
      <row important_over="false">N<ch a="F"/>ad bezdr<ch a="G"/>ożem przeleci jak strz<ch a="a"/>ała.</row>
    </block>
    <block type="verse">
      <row important_over="false">T<ch a="a"/>ylko konia osiodłać i przez wrzosowiska,</row>
      <row important_over="false">J<ch a="G"/>ak przez miłość do rudej dziewcz<ch a="a"/>yny,</row>
      <row important_over="false">Ki<ch a="a"/>edy w dali zabłyśnie nadzi<ch a="G"/>eja jak iskra,</row>
      <row important_over="false">Sp<ch a="F"/>adła gwi<ch a="G"/>azda czy wioska w dol<ch a="a"/>inie.</row>
    </block>
    <block type="verse">
      <row important_over="false">W k<ch a="a"/>ońcu konia przywiązać i do drzwi zapukać,</row>
      <row important_over="false">Uc<ch a="G"/>ałować te włosy jak pł<ch a="a"/>omień,</row>
      <row important_over="false">I w m<ch a="a"/>odlitwie dziękczynnej spok<ch a="G"/>oju poszukać,</row>
      <row important_over="false">I w ci<ch a="F"/>emn<ch a="G"/>ości popłakać jak czł<ch a="a"/>owiek.</row>
    </block>
  </lyric>
