  <translator/>
  <original_title/>
  <lyric>
    <block type="verse">
      <row important_over="true">Ki<ch a="G"/>edy nadejdzie cz<ch a="D"/>as, wabi n<ch a="C"/>as ognia bl<ch a="G"/>ask,</row>
      <row important_over="true">N<ch a="D"/>a polanie, gdzie król<ch a="C"/>uje zł<ch a="G"/>y.</row>
      <row important_over="false">Gwi<ch a="G"/>ezdny pył, w ogniu t<ch a="D"/>ym, łzy wyc<ch a="C"/>iśnie nam d<ch a="G"/>ym,</row>
      <row important_over="false">T<ch a="D"/>ańczą iskry z gwiazd<ch a="C"/>ami, a m<ch a="G"/>y...</row>
    </block>
    <block type="chorus">
      <row important_over="true">Śpi<ch a="C"/>ewajmy wszyscy w t<ch a="D"/>en radosny cz<ch a="G"/>as,</row>
      <row important_over="true">Śpi<ch a="C"/>ewajmy razem, <ch a="D"/>ilu jest tu n<ch a="e"/>as.</row>
      <row important_over="true">Choć l<ch a="C"/>ata młode sz<ch a="D"/>ybko płyną, wi<ch a="G"/>emy, ż<ch a="e"/>e</row>
      <row important_over="true">Ni<ch a="C"/>e starz<ch a="D"/>ejemy si<ch a="G"/>ę.</row>
    </block>
    <block type="verse">
      <row important_over="false">W l<ch a="G"/>esie, gdzie licho śp<ch a="D"/>i, ma prz<ch a="C"/>ygoda swe drzw<ch a="G"/>i,</row>
      <row important_over="false">Ch<ch a="D"/>odźmy tam, gdzie na ści<ch a="C"/>anie lasu lśni<ch a="G"/>ą</row>
      <row important_over="false">Oczy s<ch a="G"/>ów, wilcze kł<ch a="D"/>y, rykiem pow<ch a="C"/>ietrze drż<ch a="G"/>y,</row>
      <row important_over="false">T<ch a="D"/>ylko gwiazdy prz<ch a="C"/>yjazne są dz<ch a="G"/>iś.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false">Dorz<ch a="G"/>uć do ognia dr<ch a="D"/>ew, w górę n<ch a="C"/>iech płynie śpi<ch a="G"/>ew,</row>
      <row important_over="false">Wi<ch a="D"/>atr poniesie go w w<ch a="C"/>ilgotny świ<ch a="G"/>at.</row>
      <row important_over="false">K<ch a="G"/>ażdy z nas o tym wi<ch a="D"/>e, znowu sp<ch a="C"/>otkamy si<ch a="G"/>ę,</row>
      <row important_over="false">A poł<ch a="D"/>ączy nas bi<ch a="C"/>eszczadzki tr<ch a="G"/>akt.</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
