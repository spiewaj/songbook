<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Kolor zielony">
  <alias>Mój ulubiony kolor zielony</alias>
  <text_author>Wojciech Dąbrowski</text_author>
  <composer>Wojciech Dąbrowski</composer>
  <artist>Piosenka harcerska</artist>
  <music metre="4/4">
    <guitar barre="0"/>
  </music>
  <lyric>
    <block type="verse">
      <row important_over="true" sidechords="d G C a">Można swe <ch a="d"/>życie <ch a="G"/>wieść rozma<ch a="C"/>icie, <ch a="a"/></row>
      <row important_over="true" sidechords="d G C a">stojąc na <ch a="d"/>przykład <ch a="G"/>przy budce z <ch a="C"/>piwem, <ch a="a"/></row>
      <row important_over="never" sidechords="d G C a">ale mieć <ch a="d"/>można <ch a="G"/>ciekawsze <ch a="C"/>życie, <ch a="a"/></row>
      <row important_over="never" sidechords="d G C a">myśmy wy<ch a="d"/>brali <ch a="G"/>szczęś<ch a="C"/>liwe. <ch a="a"/></row>
    </block>
    <block type="chorus">
      <row important_over="true" sidechords="d G C a">Mój ulu<ch a="d"/>biony <ch a="G"/>kolor zie<ch a="C"/>lony, <ch a="a"/></row>
      <row important_over="true" sidechords="d G C a">ogień pach<ch a="d"/>nący <ch a="G"/>sosnowym <ch a="C"/>drzewem, <ch a="a"/></row>
      <row important_over="never" sidechords="d G C a">i te wę<ch a="d"/>drówki <ch a="G"/>we wszystkie <ch a="C"/>strony, <ch a="a"/></row>
      <row important_over="never" sidechords="d G C a">spacery <ch a="d"/>pod go<ch a="G"/>łym <ch a="C"/>niebem. <ch a="a"/></row>
    </block>
    <block type="verse">
      <row important_over="never" sidechords="d G C a">Więc chciałbym zawsze chłopcem być małym,</row>
      <row important_over="never" sidechords="d G C a">z nocnych podchodów wracać nad ranem,</row>
      <row important_over="never" sidechords="d G C a">żeby na zawsze z nami zostały</row>
      <row important_over="never" sidechords="d G C a">te chwile niezapomniane.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="never" sidechords="d G C a">Żachniesz się kiedyś, że to dziecinne,</row>
      <row important_over="never" sidechords="d G C a">albo, że z krótkich wyrosłeś spodni,</row>
      <row important_over="never" sidechords="d G C a">ale czasami myśli masz inne</row>
      <row important_over="never" sidechords="d G C a">i wtedy sobie przypomnisz.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="never" sidechords="d G C a">Więc chciałbym zawsze chłopcem być małym,</row>
      <row important_over="never" sidechords="d G C a">z harcerskim krzyżem jak z talizmanem,</row>
      <row important_over="never" sidechords="d G C a">żeby na zawsze z nami zostały</row>
      <row important_over="never" sidechords="d G C a">te chwile niezapomniane.</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
