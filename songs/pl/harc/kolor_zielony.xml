<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Kolor zielony">
  <alias>Mój ulubiony kolor zielony</alias>
  <text_author>Wojciech Dąbrowski</text_author>
  <composer>Wojciech Dąbrowski</composer>
  <artist>Piosenka harcerska</artist>
  <music metre="4/4">
    <guitar barre="0"/>
  </music>
  <lyric>
    <block type="verse">
      <row important_over="true">Można swe <ch a="d"/>życie <ch a="G"/>wieść rozma<ch a="C"/>icie, <ch a="a"/></row>
      <row important_over="true">stojąc na <ch a="d"/>przykład <ch a="G"/>przy budce z <ch a="C"/>piwem, <ch a="a"/></row>
      <row important_over="false">ale mieć <ch a="d"/>można <ch a="G"/>ciekawsze <ch a="C"/>życie, <ch a="a"/></row>
      <row important_over="false">myśmy wy<ch a="d"/>brali <ch a="G"/>szczęś<ch a="C"/>liwe. <ch a="a"/></row>
    </block>
    <block type="chorus">
      <row important_over="true">Mój ulu<ch a="d"/>biony <ch a="G"/>kolor zie<ch a="C"/>lony, <ch a="a"/></row>
      <row important_over="true">ogień pach<ch a="d"/>nący <ch a="G"/>sosnowym <ch a="C"/>drzewem, <ch a="a"/></row>
      <row important_over="false">i te wę<ch a="d"/>drówki <ch a="G"/>we wszystkie <ch a="C"/>strony, <ch a="a"/></row>
      <row important_over="false">spacery <ch a="d"/>pod go<ch a="G"/>łym <ch a="C"/>niebem. <ch a="a"/></row>
    </block>
    <block type="verse">
      <row important_over="false">Więc chciałbym <ch a="d"/>zawsze <ch a="G"/>chłopcem być <ch a="C"/>małym, <ch a="a"/></row>
      <row important_over="false">z nocnych pod<ch a="d"/>chodów <ch a="G"/>wracać nad <ch a="C"/>ranem, <ch a="a"/></row>
      <row important_over="false">żeby na <ch a="d"/>zawsze <ch a="G"/>z nami zo<ch a="C"/>stały <ch a="a"/></row>
      <row important_over="false">te chwile <ch a="d"/>nieza<ch a="G"/>pom<ch a="C"/>niane. <ch a="a"/></row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false">Żachniesz się <ch a="d"/>kiedyś, <ch a="G"/>że to dzie<ch a="C"/>cinne, <ch a="a"/></row>
      <row important_over="false">albo, że <ch a="d"/>z krótkich <ch a="G"/>wyrosłeś <ch a="C"/>spodni, <ch a="a"/></row>
      <row important_over="false">ale cza<ch a="d"/>sami <ch a="G"/>myśli masz <ch a="C"/>inne <ch a="a"/></row>
      <row important_over="false">i wtedy <ch a="d"/>sobie <ch a="G"/>przy<ch a="C"/>pomnisz. <ch a="a"/></row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false">Więc chciałbym <ch a="d"/>zawsze <ch a="G"/>chłopcem być <ch a="C"/>małym, <ch a="a"/></row>
      <row important_over="false">z harcerskim <ch a="d"/>krzyżem <ch a="G"/>jak z taliz<ch a="C"/>manem, <ch a="a"/></row>
      <row important_over="false">żeby na <ch a="d"/>zawsze <ch a="G"/>z nami zo<ch a="C"/>stały <ch a="a"/></row>
      <row important_over="false">te chwile <ch a="d"/>nieza<ch a="G"/>pom<ch a="C"/>niane. <ch a="a"/></row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
