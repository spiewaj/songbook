<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Jezior błękit">
  <alias>Kraina srebrnych brzóz</alias>
  <text_author type="solo">tradycyjny</text_author>
  <comment>Polska wersja tradycyjnej kanadyjskiej pieśni ludowej i skautowej „Land of the Silver Birch”.</comment>
  <composer type="solo">tradycyjny</composer>
  <artist type="band">Piosenka harcerska</artist>
  <original_title>Land of the Silver Birch</original_title>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="G"/>Kraina sr<ch a="e"/>ebrnych brzóz, żeremia bobrów,</row>
      <row important_over="true"><ch a="C"/>łosi pot<ch a="D"/>ężny ryk wiatr niesie w dal.</row>
    </block>
    <block type="chorus">
      <bis times="2">
        <row important_over="true"><ch a="G"/>Jezior błęk<ch a="e"/>it, <ch a="C"/>groza sk<ch a="D"/>ał – to jest ojczyzna ma.</row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="G"/>Kiedyś powr<ch a="e"/>ócę tam, zbuduję wigwam,</row>
      <row important_over="false"><ch a="C"/>gdzie rzeki b<ch a="D"/>ystry nurt, urwisty brzeg.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false"><ch a="G"/>Srebrna toń w<ch a="e"/>ody, słońce w dolinach,</row>
      <row important_over="false"><ch a="C"/>kiedy zob<ch a="D"/>aczę znów wierzchołki gór.</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
  <music metre="4/4">
    <guitar barre="0"/>
  </music>
