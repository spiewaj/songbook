  <alias/>
  <text_author type="solo">tradycyjny</text_author>
  <comment/>
  <composer type="solo">tradycyjny</composer>
  <artist type="band">Piosenka harcerska</artist>
  <translator/>
  <original_title/>
  <lyric>
    <block type="verse">
      <row important_over="true" sidechords="G"><ch a="G"/>Niech ci kwitną bzy, powoje,</row>
      <row important_over="true" sidechords="e">ni<ch a="e"/>ech cię kocha serce moje,</row>
      <row important_over="true" sidechords="C">ni<ch a="C"/>ech ci kwitnie róży kwiat,</row>
      <row important_over="true" sidechords="D">ni<ch a="D"/>ech cię kocha cały świat.</row>
    </block>
    <block type="chorus">
      <row sidechords="G">Bim bam bom, bim bam parara,</row>
      <row sidechords="e">bim bam bom, bim bam parara,</row>
      <row sidechords="C">bim bam bom, bim bam parara,</row>
      <row sidechords="D">bim bam bom parara.</row>
    </block>
    <block type="verse">
      <row sidechords="G">Szły pchły koło wody,</row>
      <row sidechords="e">pchła pchłę pchnęła do wody,</row>
      <row sidechords="C">i ta pchła płakała,</row>
      <row sidechords="D">że ją tamta pchła wepchnęła.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row sidechords="G">Po angielsku: I love you,</row>
      <row sidechords="e">po rosyjsku: ja lublju,</row>
      <row sidechords="C">po francusku: je t’aime,</row>
      <row sidechords="D">a po polsku: kocham cię!</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row sidechords="G">Róże są piękne, choć kolce mają</row>
      <row sidechords="e">i nie są trwałe, bo przekwitają,</row>
      <row sidechords="C">a nasza miłość niech będzie szczera,</row>
      <row sidechords="D">niech będzie szczera i nie umiera!</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row sidechords="G">Smutno, smutno płynie życie,</row>
      <row sidechords="e">gdy się kogoś kocha skrycie,</row>
      <row sidechords="C">ale jeszcze trudniej żyć,</row>
      <row sidechords="D">nigdy nie kochanym być.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row sidechords="G">Cicho płynie deszcz po szybie,</row>
      <row sidechords="e">jeszcze ciszej płynie łza,</row>
      <row sidechords="C">lecz nie pytaj, kto cię kocha,</row>
      <row sidechords="D">bo to zawsze będę ja.</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
