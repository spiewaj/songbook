<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Idziemy w jasną">
  <alias>Świetlany krzyż</alias>
  <text_author type="solo">tradycyjny</text_author>
  <comment>Piosenka harcerska znana również jako hymn instruktorski lub pod tytułem „Świetlany krzyż”.</comment>
  <composer type="solo">tradycyjny</composer>
  <artist type="band">Piosenka harcerska</artist>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="g"/>Idziemy w jasną, z błęk<ch a="D7"/>itu utkaną <ch a="g"/>dal,</row>
      <bis times="2">
        <row important_over="true"><ch a="c6"/>Drogą wśród pól bezkr<ch a="D"/>esnych,</row>
        <row important_over="true"><ch a="D7"/>I wśród zbóż szumiących <ch a="g"/>fal.</row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false">C<ch a="g"/>icho, szeroko, jak <ch a="D7"/>okiem spojrzenie śl<ch a="g"/>e,</row>
      <bis times="2">
        <row important_over="false">J<ch a="c6"/>akieś się snują marz<ch a="D"/>enia,</row>
        <row important_over="false">W wi<ch a="D7"/>eczornej spowite mgl<ch a="g"/>e.</row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false">Idzi<ch a="g"/>emy naprzód i ci<ch a="D7"/>ągle pniemy się wzw<ch a="g"/>yż,</row>
      <bis times="2">
        <row important_over="false">By zd<ch a="c6"/>obyć szczyt ideał<ch a="D"/>ów –</row>
        <row important_over="false">Świ<ch a="D7"/>etlany, harcerski krz<ch a="g"/>yż.</row>
      </bis>
    </block>
  </lyric>
  <music metre="4/4">
    <guitar barre="0"/>
  </music>
  <keywords/>
  <genre>Piosenka harcerska</genre>
