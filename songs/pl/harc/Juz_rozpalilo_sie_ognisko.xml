  <original_title/>
  <lyric>
    <block type="verse">
      <row important_over="true">J<ch a="C"/>uż rozpaliło się ognisko,</row>
      <row important_over="true">Dając nam d<ch a="G"/>obrej wróżby znak.</row>
      <row>Si<ch a="G"/>edliśmy wszyscy przy nim blisko,</row>
      <row>Bo w c<ch a="G7"/>ałej Polsce si<ch a="C"/>edzą tak.</row>
    </block>
    <block type="chorus">
      <row important_over="true">Si<ch a="C7"/>edzą harc<ch a="F"/>erki przy płomieniach,</row>
      <row important_over="true">Ci<ch a="G"/>epły blask ognia sk<ch a="C"/>upia je.</row>
      <row>Wsz<ch a="C"/>ystko, co złe, to szuka cienia,</row>
      <row>Do świ<ch a="G"/>atła dobro g<ch a="C"/>arnie się.</row>
    </block>
    <block type="verse">
      <row important_over="never">Mówiłaś, druhno komendantko,</row>
      <row important_over="never">Że zaufanie do nas masz,</row>
      <row important_over="never">Że wierzysz w nasze dobre chęci,</row>
      <row important_over="never">Że ty harcerskie serca znasz.</row>
    </block>
    <block type="chorus">
      <row important_over="never">Warunki tylko warunkami,</row>
      <row important_over="never">Od dawna wszak słyszymy to,</row>
      <row important_over="never">Lecz my jesteśmy harcerkami</row>
      <row important_over="never">I zwyciężymy wszelkie zło.</row>
    </block>
  </lyric>
