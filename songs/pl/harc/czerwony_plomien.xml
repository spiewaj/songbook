  <translator/>
  <original_title/>
  <lyric>
    <block type="verse">
      <row important_over="true">Ogn<ch a="a"/>iska płomi<ch a="E"/>enny bl<ch a="a"/>ask,</row>
      <row important_over="true">C<ch a="a"/>iszą zasi<ch a="C"/>any ziel<ch a="a"/>ony las,</row>
      <bis times="2">
        <row important_over="true">Ci<ch a="a"/>esz się z wsz<ch a="C"/>ystkiego t<ch a="G"/>ego, co masz,</row>
        <row important_over="true">D<ch a="a"/>aj l<ch a="C"/>udziom pog<ch a="E"/>odną tw<ch a="a"/>arz.</row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false">Ł<ch a="a"/>ap iskry szcz<ch a="E"/>ęśliwych l<ch a="a"/>at,</row>
      <row important_over="false">W sz<ch a="a"/>arym mund<ch a="C"/>urze l<ch a="a"/>epszy jest świat,</row>
      <row important_over="false">Cz<ch a="a"/>erwony <ch a="C"/>ogień rozp<ch a="G"/>ali ci</row>
      <row important_over="false">Pam<ch a="a"/>iętn<ch a="C"/>ik harc<ch a="E"/>erskich dn<ch a="a"/>i.</row>
    </block>
    <block type="verse">
      <row important_over="false">Gdy wsp<ch a="a"/>omnisz przyj<ch a="E"/>aciół sw<ch a="a"/>ych,</row>
      <row important_over="false">D<ch a="a"/>otkniesz mund<ch a="C"/>uru, pocz<ch a="a"/>ujesz łzy,</row>
      <row important_over="false">Wt<ch a="a"/>edy zob<ch a="C"/>aczysz, jak b<ch a="G"/>ardzo ci</row>
      <row important_over="false">Do szcz<ch a="a"/>ęści<ch a="C"/>a brak<ch a="E"/>uje <ch a="a"/>ich.</row>
      <row important_over="false">Zaw<ch a="a"/>ołasz wn<ch a="C"/>uki, op<ch a="G"/>owiesz im,</row>
      <row important_over="false">J<ch a="a"/>ak d<ch a="C"/>obrze b<ch a="E"/>yło wśród n<ch a="a"/>ich.</row>
    </block>
  </lyric>
