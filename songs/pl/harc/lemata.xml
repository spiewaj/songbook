<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Łemata">
  <alias>Rozważania nad wodospadem</alias>
  <text_author type="solo">Wojciech Warchoł (ps. „Neron”)</text_author>
  <comment/>
  <composer type="solo">Wojciech Warchoł (ps. „Neron”)</composer>
  <artist type="solo">Wojciech Warchoł (ps. „Neron”)</artist>
  <lyric>
    <block type="verse">
      <row important_over="true">Pam<ch a="C"/>iętam, t<ch a="G"/>ylko tabun chm<ch a="a"/>ur się rozw<ch a="e"/>inął</row>
      <row important_over="true">I c<ch a="F"/>ichy wi<ch a="C"/>atr wiej<ch a="G"/>ący k<ch a="F"/>u połon<ch a="G"/>inom,</row>
      <row important_over="false">I tw<ch a="C"/>ardy j<ch a="G"/>ak kamień pl<ch a="a"/>ecak pod m<ch a="e"/>oją głową</row>
      <row important_over="false">I cz<ch a="F"/>yjaś post<ch a="C"/>ać, co ok<ch a="G"/>azał<ch a="F"/>a się t<ch a="G"/>obą.</row>
    </block>
    <block type="chorus">
      <bis times="2">
        <row important_over="true"><ch a="C"/>Idę dołem, <ch a="G"/>a ty górą,</row>
        <row important_over="true">j<ch a="a"/>estem słońcem, t<ch a="e"/>y wichurą,</row>
        <row important_over="true"><ch a="F"/>ogniem ja, w<ch a="C"/>odą ty,</row>
        <row important_over="true">śmi<ch a="G"/>echem ja, ty r<ch a="C"/>onisz łz<ch a="G"/>y.</row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false">B<ch a="C"/>yłaś jak sł<ch a="G"/>ońce w t<ch a="a"/>ę zimną n<ch a="e"/>oc,</row>
      <row important_over="false">jak wi<ch a="F"/>elkie szcz<ch a="C"/>ęście, co z<ch a="G"/>esł<ch a="F"/>ał mi l<ch a="G"/>os.</row>
      <row important_over="false">L<ch a="C"/>ecz nienadł<ch a="G"/>ugo było ci<ch a="a"/>eszyć się n<ch a="e"/>am –</row>
      <row important_over="false">te kł<ch a="F"/>ótnie bez s<ch a="C"/>ensu, sk<ch a="G"/>ąd j<ch a="F"/>a to zn<ch a="G"/>am.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false">I tłum<ch a="C"/>aczyłem, jak napr<ch a="G"/>awdę t<ch a="a"/>o j<ch a="e"/>est,</row>
      <row important_over="false">że m<ch a="F"/>am swój świ<ch a="C"/>at, a w nim s<ch a="G"/>etki tych sw<ch a="F"/>oich spr<ch a="G"/>aw.</row>
      <row important_over="false">A m<ch a="C"/>oje gwi<ch a="G"/>azdy to z dal<ch a="a"/>eka do mnie lśn<ch a="e"/>ią,</row>
      <row important_over="false">śmi<ch a="F"/>echem i łz<ch a="C"/>ami wit<ch a="G"/>ają mój b<ch a="F"/>ukowy d<ch a="G"/>om.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false">I cz<ch a="C"/>as zako<ch a="G"/>ńczyć rozw<ch a="a"/>ażania t<ch a="e"/>e</row>
      <row important_over="false">przy w<ch a="F"/>odosp<ch a="C"/>adzie, tam, gdzi<ch a="G"/>e sł<ch a="F"/>ychać śpi<ch a="G"/>ew.</row>
      <row important_over="false">W źródl<ch a="C"/>anej w<ch a="G"/>odzie czas zan<ch a="a"/>urzyć dł<ch a="e"/>oń,</row>
      <row important_over="false">już ż<ch a="F"/>egnam w<ch a="C"/>as, dziś odch<ch a="G"/>odz<ch a="F"/>ę st<ch a="G"/>ąd.</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
