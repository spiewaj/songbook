	<lyric>
		<block type="verse">
			<row important_over="true">Brn<ch a="D"/>ąłem do ciebie, b<ch a="A"/>arze,</row>
			<row>Przez mr<ch a="G0"/>ozy i wia<ch a="h"/>try,</row>
			<row>Przez śnież<ch a="G"/>yce i za<ch a="fis"/>spy,</row>
			<row>Fag<ch a="G"/>arasz i T<ch a="A"/>atry,</row>
			<row>Przez bezb<ch a="D"/>arwne, bez sma<ch a="A"/>ku</row>
			<row>Kotl<ch a="G0"/>ety sojo<ch a="h"/>we</row>
			<row>I wr<ch a="G"/>eszcie mięso w b<ch a="fis"/>arze</row>
			<row>O tyle l<ch a="G"/>epsze od soi, że <ch a="A"/>aż odbiera m<ch a="D"/>owę.</row>
		</block>
		<block type="chorus">
			<row important_over="true">A teraz j<ch a="D"/>eść, nareszcie j<ch a="A"/>eść</row>
			<row>Mięs<ch a="G0"/>iwa — nie s<ch a="h"/>oję,</row>
			<row>Smakowe k<ch a="G"/>ubki cieszą si<ch a="fis"/>ę,</row>
			<row>A jel<ch a="G"/>ita z tęsknoty aż st<ch a="A"/>oją.</row>
			<row>Cielęcin<ch a="D"/>a, wołowin<ch a="A"/>a</row>
			<row>Zap<ch a="G0"/>achem swym nę<ch a="h"/>ci,</row>
			<row>Od mięsa kr<ch a="G"/>ów, szalonych kr<ch a="fis"/>ów</row>
			<row>Wprost w gł<ch a="G"/>owie się kr<ch a="A"/>ęci — Vivat mi<ch a="D"/>ęso!</row>
		</block>
		<block type="verse">
			<row>Pł<ch a="D"/>yną przeze mnie k<ch a="A"/>ęsy,</row>
			<row>Rozk<ch a="G0"/>oszy doda<ch a="h"/>jąc,</row>
			<row>Wielka j<ch a="G"/>est kiełbasy m<ch a="fis"/>oc,</row>
			<row>O jej sm<ch a="G"/>aku nie wspomin<ch a="A"/>ając.</row>
			<row>Tkw<ch a="D"/>i w moim wnętrzu mi<ch a="A"/>ęso,</row>
			<row>Z mięsa s<ch a="G0"/>iła ogromna powst<ch a="h"/>aje,</row>
			<row>Kwatermistrz — s<ch a="G"/>oi z Tesco f<ch a="fis"/>an,</row>
			<row>Nawet ni<ch a="G"/>e wie, ile d<ch a="A"/>obre mięso d<ch a="D"/>aje.</row>
		</block>
		<block type="chorus">
			<row>Mięso, mięs<ch a="D"/>o wspaniałe j<ch a="A"/>est,</row>
			<row>A s<ch a="G0"/>oja nie ca<ch a="h"/>łkiem,</row>
			<row>Jak soję zj<ch a="G"/>esz, to bardzo chc<ch a="fis"/>esz</row>
			<row>Kwaterm<ch a="G"/>istrza uderzyć w<ch a="A"/>ałkiem.</row>
			<row>Marzy mi si<ch a="D"/>ę, marzy mi si<ch a="A"/>ę</row>
			<row>Z kiełb<ch a="G0"/>asą fas<ch a="h"/>olka,</row>
			<row>Jeśli kwat<ch a="G"/>ermistrz soję d<ch a="fis"/>a,</row>
			<row>To b<ch a="G"/>ędzie rozpierd<ch a="A"/>olk<ch a="D"/>a!</row>
		</block>
	</lyric>
