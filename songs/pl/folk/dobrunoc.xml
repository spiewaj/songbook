  <text_author>słowa tradycyjne</text_author>
  <comment>Tradycyjna pieśń ludowa (słowacka kołysanka „Dobrú noc, má milá”).</comment>
  <composer>melodia tradycyjna</composer>
  <artist>utwór tradycyjny</artist>
  <genre>Folk</genre>
  <lyric>
    <block type="verse">
      <row important_over="true">Do<ch a="d"/>bru noč, ma <ch a="g"/>mila, dobr<ch a="A7"/>u noč, <ch a="d"/></row>
      <row important_over="true">Ne<ch a="d"/>ch ti se sam <ch a="g"/>Pan Boh da po<ch a="A7"/>moč, <ch a="d"/> <ch a="C7"/></row>
      <row important_over="true">Do<ch a="F"/>bru <ch a="C"/>noč, <ch a="F"/>dobre <ch a="C"/>spi<ch a="F"/>j, <ch a="A7"/></row>
      <row important_over="true">Ne<ch a="d"/>ch sa ti sniwa<ch a="g"/>jut slatke <ch a="A7"/>sny. <ch a="d"/> <ch a="C7"/></row>
      <row important_over="false">Do<ch a="F"/>bru <ch a="C"/>noč, <ch a="F"/>dobre <ch a="C"/>spi<ch a="F"/>j, <ch a="A7"/></row>
      <row important_over="false">Ne<ch a="d"/>ch sa ti sniwa<ch a="g"/>jut slatke <ch a="A7"/>sny. <ch a="d"/> <ch a="A7"/></row>
    </block>
    <block type="verse">
      <row important_over="false">Sn<ch a="d"/>ivaj se snič<ch a="g"/>ečku len <ch a="A7"/>snivaj, <ch a="d"/></row>
      <row important_over="false">Ke<ch a="d"/>d staniesz snic<ch a="g"/>zeczku veru <ch a="A7"/>daj, <ch a="d"/> <ch a="C7"/></row>
      <bis times="2">
        <row important_over="false">Że <ch a="F"/>ta <ch a="C"/>ja <ch a="F"/>mi<ch a="C"/>lu<ch a="F"/>jem, <ch a="A7"/></row>
        <row important_over="false">Se<ch a="d"/>rdečko ti m<ch a="g"/>oje daruj<ch a="A7"/>em. <ch a="d"/> <ch a="C7"/></row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false">Do<ch a="d"/>bru noč, ma <ch a="g"/>mila, dobr<ch a="A7"/>u noč, <ch a="d"/></row>
      <row important_over="false">Ne<ch a="d"/>ch ti se sam <ch a="g"/>Pan Boh da po<ch a="A7"/>moč, <ch a="d"/> <ch a="C7"/></row>
      <bis times="2">
        <row important_over="false">Do<ch a="F"/>bru <ch a="C"/>noč, <ch a="F"/>dobre <ch a="C"/>spi<ch a="F"/>j, <ch a="A7"/></row>
        <row important_over="false">Ne<ch a="d"/>ch sa ti sniv<ch a="g"/>ajut o m<ch a="A7"/>ne sny. <ch a="d"/> <ch a="C7"/></row>
      </bis>
    </block>
  </lyric>
