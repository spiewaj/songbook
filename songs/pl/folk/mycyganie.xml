<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="My Cyganie">
  <alias>Ore, ore</alias>
  <text_author>słowa tradycyjne</text_author>
  <composer>melodia tradycyjna</composer>
  <artist type="band">Piosenki biesiadne</artist>
  <genre>Pieśń ludowa</genre>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="C"/>My Cyganie, co <ch a="G"/>pędzimy razem z wiatrem,</row>
      <row important_over="true"><ch a="a"/>My Cyganie, <ch a="e"/>znamy cały świat,</row>
      <row important_over="false"><ch a="a"/>My Cyganie, <ch a="e"/>wszystkim gramy,</row>
      <row important_over="true"><ch a="H7"/>A śpiewamy <ch a="e"/>sobie <ch a="E7"/>tak:</row>
    </block>
    <block type="chorus">
      <row important_over="true"><ch a="C"/>Ore, ore, <ch a="G"/>szabadabada amore,</row>
      <row important_over="true"><ch a="a"/>Ore, ore, <ch a="e"/>szabadabada,</row>
      <row important_over="false"><ch a="a"/>O muriaty, <ch a="e"/>o szogriaty,</row>
      <row important_over="true"><ch a="H7"/>Hajda trojka <ch a="e"/>na mie<ch a="E7"/>nia!</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="C"/>Kiedy tańczę, <ch a="G"/>niebo tańczy razem ze mną,</row>
      <row important_over="false"><ch a="a"/>Kiedy śpiewam, <ch a="e"/>śpiewa ze mną wiatr,</row>
      <row important_over="false"><ch a="a"/>Zamknę oczy, <ch a="e"/>liście więdną,</row>
      <row important_over="false"><ch a="H7"/>Kiedy milknę, <ch a="e"/>milknie <ch a="E7"/>świat.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false"><ch a="C"/>Będzie prościej, <ch a="G"/>będzie prościej, będzie jaśniej,</row>
      <row important_over="false"><ch a="a"/>Całą radość <ch a="e"/>damy dzisiaj wam,</row>
      <row important_over="false"><ch a="a"/>Będzie prościej, <ch a="e"/>będzie jaśniej,</row>
      <row important_over="false"><ch a="H7"/>Gdy zaśpiewa <ch a="e"/>każdy z <ch a="E7"/>was.</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
