<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Pszczółka maja">
  <artist>Zbigniew Wodecki</artist>
  <lyric>
    <block type="verse">
      <row important_over="never">Jest gdzieś lecz nie wiadomo gdzie,<ch a="C"/><ch a="G"/></row>
      <row important_over="never">świat w którym baśń ta dzieje się.<ch a="F"/><ch a="C"/></row>
      <row important_over="never">Malutka pszczółka mieszka w nim,<ch a="G"/></row>
      <row important_over="never">Co wśród owadów wiedze prym<ch a="F"/><ch a="C"/></row>
    </block>
    <block type="verse">
      <row important_over="never">Tę pszczółkę, którą tu widzicie zowią Mają.<ch a="C"/><ch a="F"/><ch a="G"/><ch a="C"/><ch a="d"/></row>
      <row important_over="never">Wszyscy Maja znają i kochają<ch a="G"/><ch a="C"/></row>
      <row important_over="never">Maja fruwa tu i tam<ch a="d"/></row>
      <row important_over="never">Świat swój pokazując nam<ch a="G"/><ch a="C"/></row>
    </block>
    <block type="verse">
      <row important_over="never">Dziś spotka nas maleńka zwinna, pszczółka Maja<ch a="C"/><ch a="F"/><ch a="G"/><ch a="C"/><ch a="d"/></row>
      <row important_over="never">Śmiała, sprytna, rezolutna Maja<ch a="G"/><ch a="C"/></row>
      <row important_over="never">Mała zwinna przyjaciółka Maja<ch a="d"/></row>
      <row important_over="never">Maju, cóż zobaczymy dziś.<ch a="C"/><ch a="G"/><ch a="C"/></row>
    </block>
  </lyric>
</song>
