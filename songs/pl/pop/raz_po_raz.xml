<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Raz po raz">
  <alias>Każde z nas swoje ścieżki ma</alias>
  <text_author type="solo">Bogdan Olewicz</text_author>
  <comment>Utwór z albumu „Śmigło” (1999) zespołu Perfect.</comment>
  <composer type="solo">Dariusz Kozakiewicz</composer>
  <artist type="band">Perfect</artist>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="C"/>Każde z <ch a="G"/>nas swoje <ch a="C"/>ścieżki <ch a="F"/>ma,</row>
      <row important_over="true"><ch a="C"/>Wydep<ch a="G"/>tane i spraw<ch a="a"/>dzone od <ch a="F"/>lat.</row>
      <row important_over="true"><ch a="C"/>Czasem <ch a="G"/>myśl mi nie <ch a="a"/>daje <ch a="G"/>spać: <ch a="F"/></row>
      <row important_over="true">Kto chodzi <ch a="C"/>bokiem? Kto chodzi <ch a="G"/>bokiem?</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="C"/>Kiedy <ch a="G"/>ja chcę zie<ch a="C"/>lonym <ch a="F"/>być,</row>
      <row important_over="false"><ch a="C"/>Dom grzać <ch a="G"/>słońcem i desz<ch a="a"/>czówkę z chmur <ch a="F"/>pić,</row>
      <row important_over="false"><ch a="C"/>Wtedy <ch a="G"/>mnie do<ch a="a"/>pada <ch a="G"/>myśl: <ch a="F"/></row>
      <row important_over="false">Kto ma o<ch a="C"/>chotę o świat lepszy się <ch a="G"/>bić?</row>
    </block>
    <block type="chorus">
      <row important_over="true">Raz po <ch a="C"/>raz straszą <ch a="a"/>nas, mówią <ch a="F"/>wprost, że to <ch a="G"/>finał,</row>
      <row important_over="true"><ch a="C"/>Rok, może <ch a="a"/>pięć, komet <ch a="F"/>deszcz i <ch a="G"/>szlus.</row>
      <row important_over="true">Chyba <ch a="C"/>że tęgi <ch a="a"/>łeb myli <ch a="F"/>się i kur<ch a="G"/>tyna</row>
      <row important_over="true">W dół zamiast <ch a="C"/>spaść, w górę <ch a="a"/>mknie <ch a="F"/><ch a="G"/></row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="C"/>Może <ch a="G"/>ja jadłem <ch a="C"/>inny <ch a="F"/>chleb,</row>
      <row important_over="false"><ch a="C"/>Może <ch a="G"/>księgi czy<ch a="a"/>tywałem <ch a="F"/>nie te,</row>
      <row important_over="false"><ch a="C"/>Patrzę w <ch a="G"/>ekran i <ch a="a"/>wciąż py<ch a="G"/>tam <ch a="F"/>się:</row>
      <row important_over="false">Czy świat na <ch a="C"/>głowie to jedyny nasz <ch a="G"/>wkład?</row>
    </block>
    <block type="chorus">
      <row important_over="false">Raz po <ch a="C"/>raz straszą <ch a="a"/>nas, że nasz <ch a="F"/>ład właśnie <ch a="G"/>mija,</row>
      <row important_over="false">Bo całe <ch a="C"/>zło, krew i <ch a="a"/>pot, to <ch a="F"/>my. <ch a="G"/></row>
      <row important_over="false">Chyba <ch a="C"/>mam lepszy <ch a="a"/>wzrok – niezły <ch a="F"/>plan się roz<ch a="G"/>wija,</row>
      <row important_over="false">Znów łączy <ch a="C"/>nas tęczy <ch a="a"/>most. <ch a="F"/><ch a="G"/></row>
    </block>
    <block type="other">
      <row important_over="true">Gdy o tym myślę, w głowie zamęt mam: <ch a="F"/></row>
      <row important_over="true">Śmiać się czy też włosy <ch a="C"/>rwać? <ch a="G"/></row>
      <row important_over="false">Muzykę słyszę, ciało rusza w tan <ch a="F"/></row>
      <row important_over="false">I tak mogę wieki <ch a="C"/>trwać! <ch a="G"/></row>
    </block>
