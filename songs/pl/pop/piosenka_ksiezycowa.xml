<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Piosenka księżycowa">
  <text_author type="solo">Anita Lipnicka</text_author>
  <composer type="solo">Robert Janson</composer>
  <artist type="band">Varius Manx</artist>
  <lyric>
    <block type="verse">
      <row important_over="false" style="instr"><ch a="a"/></row>
      <row important_over="true"><ch a="a"/>Śpisz pięknie <ch a="G"/>tak</row>
      <row important_over="true"><ch a="F"/>Po kątach cisza <ch a="G"/>gra</row>
      <row important_over="true"><ch a="F"/>Szkoda słów, resztę dop<ch a="e"/>owie księżyc</row>
      <row important_over="false"><ch a="a"/>Śpisz, staram <ch a="G"/>się</row>
      <row important_over="false"><ch a="F"/>Oddychać szeptem, poś<ch a="G"/>ciel jeszcze pachnie</row>
      <row important_over="true"><ch a="F"/>Ogni<ch a="e"/>em naszych <ch a="a"/>ciał</row>
    </block>
    <block type="chorus">
      <row important_over="true"><ch a="d"/>Kiedyś znaj<ch a="e"/>dę dla nas <ch a="F"/>dom</row>
      <row important_over="true">Z wielkim <ch a="G"/>oknem na <ch a="d"/>świat</row>
      <row important_over="false">Znowu za<ch a="e"/>czniesz ufać <ch a="F"/>mi</row>
      <row important_over="false">Nie pozw<ch a="G"/>olę ci się <ch a="d"/>bać</row>
      <row important_over="false">Kiedyś wszy<ch a="e"/>stkie czarne <ch a="F"/>dni</row>
      <row important_over="false">Obró<ch a="G"/>cimy w dobry <ch a="d"/>żart</row>
      <row important_over="false"><ch a="d"/>Znowu będz<ch a="e"/>iesz ufał <ch a="F"/>mi <ch a="G"/></row>
      <row important_over="true"><ch a="a"/>Teraz śpij... <ch a="G"/> <ch a="F"/> <ch a="G"/></row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="a"/>Wiem, dobrze <ch a="G"/>wiem</row>
      <row important_over="false"><ch a="F"/>Potrafię ranić <ch a="G"/>tak jak nikt</row>
      <row important_over="false"><ch a="F"/>Przykro mi, nie wiem, co <ch a="e"/>robić, gdy płaczesz</row>
      <row important_over="false"><ch a="a"/>Już nie śmie<ch a="G"/>jesz się jak kiedyś</row>
      <row important_over="false"><ch a="F"/>Wszystko jest inacze<ch a="G"/>j</row>
      <row important_over="false"><ch a="F"/>Kolejny raz proszę <ch a="e"/>cię o ostatn<ch a="a"/>ią szansę</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
