<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Dziwna">
  <text_author type="solo">Daria Zawiałow</text_author>
  <composer>Daria Zawiałow, Bartosz Dziedzic</composer>
  <artist type="solo">Daria Zawiałow</artist>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="G"/>Może chciałbym <ch a="d"/>uczyć się</row>
      <row important_over="false"><ch a="G"/>Jesteś taka nie<ch a="d"/>zastąpiona</row>
      <row important_over="false"><ch a="G"/>Może nie pójdę <ch a="d"/>więcej tam</row>
      <row important_over="true"><ch a="F"/>Wiesz, tak długo <ch a="C"/>byłem sam</row>
      <row important_over="false"><ch a="G"/>Chciałbym, żebyś zau<ch a="d"/>fała mi</row>
      <row important_over="false"><ch a="G"/>Wiem, że przeze mnie <ch a="d"/>czasem płaczesz</row>
      <row important_over="false"><ch a="G"/>Jutro chciałabyś <ch a="d"/>mieć na dziś</row>
      <row important_over="false"><ch a="F"/>Może mi bra<ch a="C"/>kuje sił</row>
    </block>
    <block type="chorus">
      <row important_over="true">Ty <ch a="G"/>wiesz, że kocham <ch a="d"/>cię,</row>
      <row important_over="true">Lecz sama <ch a="F"/>jestem <ch a="C"/>dziwna</row>
      <row important_over="false">Dziś tylko <ch a="G"/>słowa, twoje <ch a="d"/>słowa</row>
      <row important_over="false">Będą <ch a="F"/>leczyć <ch a="C"/>mnie</row>
      <row important_over="false">Ty <ch a="G"/>wiesz, że chciała<ch a="d"/>bym</row>
      <row important_over="false">Nie patrzeć <ch a="F"/>wstecz, nie <ch a="C"/>szukać</row>
      <row important_over="false">Lecz tylko <ch a="G"/>słowa, tylko <ch a="d"/>słowa</row>
      <row important_over="false">Nie wys<ch a="F"/>tarczą <ch a="C"/>mi</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="G"/>Jestem z tym po <ch a="d"/>prostu sam</row>
      <row important_over="false"><ch a="G"/>Nigdy nie byłem tak <ch a="d"/>zakochany</row>
      <row important_over="false"><ch a="G"/>Dziewczyno, przecież <ch a="d"/>znam twój plan</row>
      <row important_over="false"><ch a="F"/>Musisz jeszcze <ch a="C"/>dać mi czas</row>
      <row important_over="false"><ch a="G"/>Jakbym miał bez <ch a="d"/>ciebie żyć</row>
      <row important_over="false"><ch a="G"/>Przy tobie mogę spać <ch a="d"/>z jaszczurkami</row>
      <row important_over="false"><ch a="G"/>Śniło mi się, że miel<ch a="d"/>iśmy dom</row>
      <row important_over="false"><ch a="F"/>Może ty zrób <ch a="C"/>pierwszy krok</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="true"><ch a="G"/>Wiemy, że nie chcemy już bez <ch a="d"/>siebie żyć</row>
      <row important_over="false"><ch a="G"/>Znów jesteśmy po tej samej <ch a="d"/>stronie</row>
      <row important_over="false"><ch a="G"/>Na parapecie już powoli <ch a="d"/>słychać dzień</row>
      <row important_over="false"><ch a="G"/>Kiedy jednym staną się dwa <ch a="d"/>domy</row>
    </block>
  </lyric>
