    <block type="verse">
      <row important_over="false"><ch a="a"/>Musisz od<ch a="G"/>naleźć na<ch a="d"/>dzieję</row>
      <row important_over="false">I nie<ch a="a"/>ważne, że <ch a="G"/>nazwą cię <ch a="d"/>głupcem</row>
      <row important_over="false"><ch a="a"/>Musisz po<ch a="G"/>zwolić, by <ch a="d"/>sny</row>
