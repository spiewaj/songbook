      <row important_over="true"><ch a="a"/>Spróbuj po<ch a="G"/>wiedzieć <ch a="d"/>to</row>
      <row important_over="true">Nim u<ch a="a"/>wierzysz, że <ch a="G"/>nie warto mówić <ch a="d"/>kocham</row>
      <row important_over="false"><ch a="a"/>Spróbuj u<ch a="G"/>czynić <ch a="d"/>gest</row>
      <row important_over="false">Nim u<ch a="a"/>wierzysz, że <ch a="G"/>nic nie warto <ch a="d"/>robić</row>
    </block>
    <block type="chorus">
      <row important_over="true"><ch a="a"/>Nic, na<ch a="G"/>prawdę <ch a="d"/>nic nie pomoże</row>
      <row important_over="false"><ch a="a"/>Jeśli <ch a="G"/>ty nie po<ch a="d"/>możesz dziś miłości</row>
      <row important_over="false"><ch a="a"/>Nic, na<ch a="G"/>prawdę <ch a="d"/>nic nie pomoże</row>
      <row important_over="false"><ch a="a"/>Jeśli <ch a="G"/>ty nie po<ch a="d"/>możesz dziś miłości</row>
