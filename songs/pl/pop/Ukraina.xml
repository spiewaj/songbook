<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Ukraina">
	<alias>Hej, sokoły</alias>
	<text_author type="solo">tradycyjna</text_author>
	<comment>Popularna polsko-ukraińska pieśń tradycyjna (przypisywana m.in. Tymkowi Padurze), znana powszechnie jako „Hej, sokoły”.</comment>
	<composer type="solo">tradycyjna</composer>
	<artist type="band">Piosenka biesiadna</artist>
	<lyric>
		<block type="verse">
			<row important_over="true">H<ch a="a"/>ej, tam gdzieś znad czarnej w<ch a="E"/>ody</row>
			<row important_over="true">siada na koń Kozak mł<ch a="a"/>ody,</row>
			<row important_over="true">czule żegna się z dziewcz<ch a="d"/>yną,</row>
			<row important_over="true">j<ch a="a"/>eszcze czul<ch a="E"/>ej z Ukrain<ch a="a"/>ą.<ch a="G7"/></row>
		</block>
		<block type="chorus">
			<row important_over="true">H<ch a="C"/>ej, hej, hej, sokoły,</row>
			<row important_over="true">omij<ch a="G"/>ajcie góry, lasy, doły,</row>
			<row important_over="true">dzw<ch a="a"/>oń, dzwoń, dzwoń dzwoneczku,</row>
			<row important_over="true">m<ch a="E"/>ój stepowy skowroneczku,</row>
			<row important_over="true">mój stepowy: dzw<ch a="E"/>oń, dzwoń, dzw<ch a="a"/>oń!</row>
		</block>
		<block type="verse">
			<row important_over="false">Pi<ch a="a"/>ęknych dziewcząt jest niem<ch a="E"/>ało,</row>
			<row important_over="false">lecz najwięcej w Ukrain<ch a="a"/>ie.</row>
			<row important_over="false">Tam me serce pozost<ch a="d"/>ało</row>
			<row important_over="false">prz<ch a="a"/>y kochan<ch a="E"/>ej mej dziewczyn<ch a="a"/>ie.<ch a="G7"/></row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="false">Ona jedna tam zost<ch a="E"/>ała,</row>
			<row important_over="false">jaskółeczka moja m<ch a="a"/>ała,</row>
			<row important_over="false">a ja tutaj w obcej str<ch a="d"/>onie,</row>
			<row important_over="false">dni<ch a="a"/>em i noc<ch a="E"/>ą tęsknię do ni<ch a="a"/>ej.<ch a="G7"/></row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="false">Ż<ch a="a"/>al, żal za dziewcz<ch a="E"/>yną,</row>
			<row important_over="false">za kochaną Ukrain<ch a="a"/>ą,</row>
			<row important_over="false">żal, żal, serce pł<ch a="d"/>acze,</row>
			<row important_over="false">j<ch a="a"/>uż cię wi<ch a="E"/>ęcej nie zob<ch a="a"/>aczę.<ch a="G7"/></row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="false">W<ch a="a"/>ina, wina, wina d<ch a="E"/>ajcie,</row>
			<row important_over="false">a jak umrę, pochow<ch a="a"/>ajcie</row>
			<row important_over="false">na zielonej Ukrain<ch a="d"/>ie,</row>
			<row important_over="false">prz<ch a="a"/>y kochan<ch a="E"/>ej mej dziewczyn<ch a="a"/>ie.<ch a="G7"/></row>
		</block>
		<blocklink blocknb="2"/>
	</lyric>
	<music metre="2/4">
		<guitar barre="0"/>
	</music>
	<genre>folk</genre>
	<status>
