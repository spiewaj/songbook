<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Ukraina">
	<alias>Hej Sokoły</alias>
	<lyric>
		<block type="verse">
			<row important_over="never">Hej, tam gdzieś znad czarnej wody<ch a="a"/></row>
			<row important_over="never">Siada na koń Kozak młody<ch a="E"/></row>
			<row important_over="never">Czule żegna się z dziewczyną<ch a="a"/></row>
			<row important_over="never">Jeszcze czulej z Ukrainą<ch a="E"/><ch a="a"/><ch a="G7"/></row>
		</block>
		<block type="chorus">
			<row important_over="never">Hej, hej, hej sokoły<ch a="C"/></row>
			<row important_over="never">Omijajcie góry, lasy, pola, doły<ch a="E7"/></row>
			<row important_over="never">Dzwoń, dzwoń, dzwoń dzwoneczku<ch a="a"/></row>
			<row important_over="never">Mój stepowy skowroneczku<ch a="E"/><ch a="G7"/></row>
			<row important_over="never">Mój stepowy dzwoń, dzwoń, dzwoń<ch a="E"/><ch a="a"/></row>
		</block>
		<block type="verse">
			<row important_over="never">Ładnych dziewcząt jest nie mało</row>
			<row important_over="never">Lecz najwięcej w Ukrainie</row>
			<row important_over="never">Tam me serce pozostało</row>
			<row important_over="never">Przy kochanej mej dziewczynie</row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="never">Ona jedna tam została</row>
			<row important_over="never">Jaskółeczka moja, miła mała</row>
			<row important_over="never">A ja jeden w obcej stronie</row>
			<row important_over="never">Dniem i nocą tęsknię do niej</row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="never">Żal, żal za dziewczyną</row>
			<row important_over="never">Za kochaną Ukrainą</row>
			<row important_over="never">Żal, żal serce płacze</row>
			<row important_over="never">Już cię więcej nie zobaczę</row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="never">Wina, wina, wina dajcie</row>
			<row important_over="never">A jak umrę pochowajcie</row>
			<row important_over="never">Na zielonej Ukrainie</row>
			<row important_over="never">Przy kochanej mej dziewczynie.</row>
		</block>
		<blocklink blocknb="2"/>
	</lyric>
	<keywords/>
	<genre>Piosenka turystyczna</genre>
	<status>
		<done/>
		<verificators/>
	</status>
</song>
