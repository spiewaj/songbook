<?xml version="1.0" encoding="UTF-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Teksański">
	<artist type="band">Hey</artist>
	<lyric>
		<block type="verse">
			<row important_over="true"><ch a="D"/>Herbata styg<ch a="G"/>nie, zapa<ch a="A"/>da mrok,</row>
			<row important_over="never">a pod piórem ciągle nic.</row>
			<row important_over="never">Obowiązek obowiązkiem jest:</row>
			<row important_over="never">piosenka musi posiadać tekst.</row>
			<row important_over="true">Gdyby <ch a="G"/>chociaż mucha zja<ch a="A"/>wiła <ch a="D"/>się,</row>
			<row important_over="never">mogłabym ją zabić,</row>
			<row important_over="never">a później to opisać.</row>
		</block>
		<block type="chorus">
			<row important_over="true">W moich <ch a="G"/>słowach słoma <ch a="A"/>czai <ch a="D"/>się,</row>
			<row important_over="never">nie znaczą nic.</row>
			<row important_over="never">Jeśli szukasz sensu, prawdy w nich –</row>
			<row important_over="never">zawiedziesz się.</row>
		</block>
		<block type="verse">
			<row important_over="never">A może zmienić zasady gry?</row>
			<row important_over="never">Chcesz usłyszeć słowa,</row>
			<row important_over="never">to sam je sobie wymyśl!</row>
		</block>
		<block type="chorus">
			<bis times="2">
				<row important_over="true">Nabij <ch a="G"/>diabła, chmurę <ch a="A"/>śmierci <ch a="D"/>weź –</row>
				<row important_over="never">pomoże ci.</row>
				<row important_over="never">Wnet twe myśli w słowa zmienią się,</row>
				<row important_over="never">wyśpiewasz je sam.</row>
			</bis>
		</block>
	</lyric>
	<music metre="4/4">
		<guitar/>
	</music>
