<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Zanim pójdę">
	<alias>Miłość to nie pluszowy miś</alias>
	<text_author type="solo">Jakub Kawalec (ps. „Quka”)</text_author>
	<composer type="band">Happysad</composer>
	<artist type="band">Happysad</artist>
	<lyric>
		<block type="verse">
			<row important_over="true"><ch a="a"/>Ile jestem ci winien?</row>
			<row important_over="true"><ch a="d"/>Ile policzyłaś mi za swą <ch a="e"/>przyjaźń?</row>
			<row important_over="false"><ch a="a"/>Ale kiedy wszystko już oddam, czy</row>
			<bis times="2">
				<row important_over="false"><ch a="d"/>będziesz szczęśliwa i wolna, <ch a="e"/>czy…</row>
			</bis>
		</block>
		<block type="other">
			<row important_over="true"><ch a="a"/>Ale zanim <ch a="d"/>pój<ch a="e"/>dę…</row>
			<row important_over="false"><ch a="a"/>ale zanim <ch a="d"/>pój<ch a="e"/>dę…</row>
			<row important_over="false"><ch a="a"/>ale zanim pójdę…</row>
			<row important_over="true"><ch a="d"/>chciałbym po<ch a="e"/>wiedzieć ci, że:</row>
		</block>
		<block type="chorus">
			<row important_over="true"><ch a="a"/>Miłość to nie plu<ch a="d"/>szowy miś ani <ch a="e"/>kwiaty,</row>
			<row important_over="true">to też nie <ch a="d"/>diabeł ro<ch a="e"/>gaty.</row>
			<row important_over="true">Ani <ch a="a"/>miłość, kiedy <ch a="d"/>jedno pła<ch a="G"/>cze,</row>
			<row important_over="true">a <ch a="C"/>drugie po nim <ch a="F"/>skacze.</row>
			<row important_over="false">Bo <ch a="a"/>miłość to żaden <ch a="d"/>film w żadnym <ch a="e"/>kinie,</row>
			<row important_over="false">ani <ch a="a"/>róże, ani ca<ch a="d"/>łusy małe, <ch a="e"/>duże.</row>
			<row important_over="false">Ale <ch a="a"/>miłość, kiedy <ch a="d"/>jedno spada w <ch a="G"/>dół,</row>
			<row important_over="false"><ch a="C"/>drugie ciągnie je ku <ch a="F"/>górze.</row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="a"/>Ile jestem ci winien?</row>
			<row important_over="false"><ch a="d"/>Ile policzyłaś mi za swą <ch a="e"/>przyjaźń?</row>
			<row important_over="false"><ch a="a"/>Ile były warte nasze słowa,</row>
			<bis times="2">
				<row important_over="false"><ch a="d"/>kiedy próbowaliśmy <ch a="e"/>wszystko od nowa?</row>
			</bis>
		</block>
