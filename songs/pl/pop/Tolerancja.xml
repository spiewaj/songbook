      <row important_over="true"><ch a="D"/>Tu tu tu tu <ch a="A"/>tą <ch a="G"/><ch a="A"/></row>
      <bis times="3">
        <row important_over="false"><ch a="D"/>Tu tu tu tu <ch a="A"/>tą <ch a="G"/><ch a="A"/></row>
      </bis>
    </block>
