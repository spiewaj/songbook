<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Pacyfik">
  <alias>Kiedy szliśmy przez Pacyfik</alias>
  <text_author type="solo">Tradycyjna</text_author>
  <comment>Tradycyjna szanta kabestanowa w humorystycznym kumulacyjnym opracowaniu, spopularyzowana m.in. przez zespół Mechanicy Shanty.</comment>
  <composer type="solo">Tradycyjna</composer>
  <artist type="band">Mechanicy Shanty</artist>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="D"/>Kiedy szliśmy przez Pacyfik,</row>
      <row important_over="true">Way, hey, <ch a="A"/>roluj go!</row>
      <row important_over="false"><ch a="D"/>Zwiało nam z pokładu skrzynki,</row>
      <row important_over="false"><ch a="D"/>Pełne śledzia i sardynki,</row>
      <row important_over="false"><ch a="D"/>Kosze krabów, beczkę sera,</row>
      <row important_over="false"><ch a="D"/>Kalesony oficera,</row>
      <row important_over="false"><ch a="D"/>Sieć jeżowców, jedną żabę,</row>
      <row important_over="false"><ch a="D"/>Kapitańską zmyło babę.</row>
      <row important_over="false"><ch a="D"/>Beczki rumu nam nie zwiało –</row>
      <row important_over="false"><ch a="D"/>Pół załogi ją trzymało!</row>
      <row important_over="true">Taki był cho<ch a="A"/>lerny <ch a="D"/>sztorm!</row>
    </block>
    <block type="chorus">
      <row important_over="true"><ch a="D"/>Hej, znowu <ch a="G"/>zmyło coś,</row>
      <row important_over="true"><ch a="D"/>Zniknął w morzu <ch a="A"/>jakiś gość.</row>
      <row important_over="true"><ch a="D"/>Hej, policz, <ch a="G"/>który tam,</row>
      <row important_over="true"><ch a="A"/>Jaki znowu zmyło <ch a="D"/>kram!</row>
      <row important_over="false"><ch a="D"/>Hej, znowu <ch a="G"/>zmyło coś,</row>
      <row important_over="false"><ch a="D"/>Zniknął w morzu <ch a="A"/>jakiś gość.</row>
      <row important_over="false"><ch a="D"/>Postawcie <ch a="G"/>wina dzban,</row>
      <row important_over="false"><ch a="A"/>Opowiemy dalej <ch a="D"/>wam!</row>
    </block>
  </lyric>
  <music metre="4/4">
    <guitar barre="0"/>
  </music>
  <genre>szanta</genre>
