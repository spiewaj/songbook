  <alias>Nowa Szkocja</alias>
  <text_author type="solo">Jerzy Rogacki</text_author>
  <comment/>
  <composer type="solo">tradycyjna</composer>
  <artist type="band">Cztery Refy</artist>
  <translator></translator>
  <original_title>Farewell to Nova Scotia</original_title>
  <lyric>
    <block type="chorus">
      <row important_over="true"><ch a="C"/>Żegluj, <ch a="e"/>żegluj <ch a="a"/>tam gdzie Nowa <ch a="F"/>Szkocja, <ch a="G"/></row>
      <row important_over="true"><ch a="C"/>Żegluj, <ch a="e"/>żegluj <ch a="a"/>gdzie wstaje <ch a="F"/>nowy <ch a="G"/>dzień. <ch a="C"/></row>
    </block>
    <block type="verse">
      <row important_over="true">Głos Nowej <ch a="a"/>Szkocji nam <ch a="G"/>przynosi <ch a="C"/>wiatr,</row>
      <row important_over="true">To zapo<ch a="F"/>wiedź <ch a="C"/>nowych <ch a="F"/>dni.</row>
      <row important_over="true">Znowu <ch a="d"/>woła do <ch a="C"/>nas <ch a="G"/>rykiem <ch a="a"/>fal:</row>
      <row important_over="true">Tam znaj<ch a="F"/>dziecie <ch a="C"/>nowy <ch a="G"/>świat.</row>
      <row important_over="false">Znów dumny <ch a="a"/>brzeg będzie <ch a="G"/>witał <ch a="C"/>was</row>
      <row important_over="false">Maje<ch a="F"/>statem <ch a="C"/>groźnych <ch a="F"/>skał.</row>
      <row important_over="false">Każdy <ch a="d"/>dzień znów <ch a="C"/>świtem przyj<ch a="G"/>mie <ch a="a"/>was,</row>
      <row important_over="false">Coraz <ch a="F"/>bliższym <ch a="C"/>stanie <ch a="F"/>się,</row>
      <row important_over="true">Twoim <ch a="d"/>własnym <ch a="G"/>domem stanie <ch a="C"/>się.</row>
    </block>
    <blocklink blocknb="1"/>
    <block type="verse">
      <row important_over="false">Atlan<ch a="a"/>tyk bije <ch a="G"/>falą w stromy <ch a="C"/>brzeg,</row>
      <row important_over="false">Wściekle <ch a="F"/>ryczy <ch a="C"/>pośród <ch a="F"/>skał.</row>
      <row important_over="false">W górze <ch a="d"/>dzikich <ch a="C"/>ptaków <ch a="G"/>słychać <ch a="a"/>śpiew,</row>
      <row important_over="false">Głos ich <ch a="F"/>płynie <ch a="C"/>z wiatrem w <ch a="G"/>dal.</row>
      <row important_over="false">Tam bujnej <ch a="a"/>trawy się <ch a="G"/>kołysze <ch a="C"/>łan</row>
      <row important_over="false">I stru<ch a="F"/>myków <ch a="C"/>cichy <ch a="F"/>szept.</row>
      <row important_over="false">W mej pa<ch a="d"/>mięci <ch a="C"/>zawsze <ch a="G"/>będzie <ch a="a"/>trwał,</row>
      <row important_over="false">Lecz nie<ch a="F"/>długo <ch a="C"/>powiem <ch a="F"/>wam,</row>
      <row important_over="false">Lecz nie<ch a="d"/>długo <ch a="G"/>wszystkim powiem <ch a="C"/>wam.</row>
    </block>
    <blocklink blocknb="1"/>
    <blocklink blocknb="1"/>
  </lyric>
