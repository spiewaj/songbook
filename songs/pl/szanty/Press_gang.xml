<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Press gang">
  <artist>4 Refy</artist>
  <lyric>
    <block type="verse">
      <row important_over="never">W dół od rzeki poprzez London Street<ch a="c"/><ch a="B"/><ch a="c"/><ch a="B"/></row>
      <row important_over="never">Psów królewskich zwarty oddział szedł:<ch a="c"/><ch a="B"/><ch a="c"/></row>
      <row important_over="never">Ojczyźnie trzeba dziś świeżej krwi -<ch a="g"/><ch a="f"/><ch a="G"/></row>
      <row important_over="never">Marynarzy floty wojennej<ch a="B"/><ch a="c"/><ch a="B"/><ch a="c"/></row>
    </block>
    <block type="verse">
      <row important_over="never">A, że byłem wtedy dość silny chłop,</row>
      <row important_over="never">W tłumie złowił mnie sierżanta wzrok:</row>
      <row important_over="never">W kajdanach z bramy wywlekli mnie -</row>
      <row important_over="never">Marynarza floty wojennej</row>
    </block>
    <block type="verse">
      <row important_over="never">Jak o prawa upominać się</row>
      <row important_over="never">Na gretingu nauczyli mnie:</row>
      <row important_over="never">Niejeden krwią wtedy spłynął grzbiet -</row>
      <row important_over="never">Marynarza floty wojennej</row>
    </block>
    <block type="verse">
      <row important_over="never">Nikt nie zliczy ile krwi i łez</row>
      <row important_over="never">Wsiąka w pokład nim się skończy rejs:</row>
      <row important_over="never">Dla chwały twej słodki kraju mój -</row>
      <row important_over="never">Marynarzy floty wojennej</row>
    </block>
    <block type="verse">
      <row important_over="never">Hej, za rufą miło został dom,</row>
      <row important_over="never">Jesteś tylko parą silnych rąk:</row>
      <row important_over="never">Dowódca tu twoim bogiem jest -</row>
      <row important_over="never">Marynarzu floty wojennej</row>
    </block>
    <block type="verse">
      <row important_over="never">Gdy łapaczy szyk formuje się,</row>
      <row important_over="never">W pierwszym rzędzie możesz ujrzeć mnie:</row>
      <row important_over="never">Kto stanie na mojej drodze dziś -</row>
      <row important_over="never">Łup stanowi floty wojennej</row>
    </block>
  </lyric>
</song>
