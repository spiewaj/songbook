<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Press gang">
  <text_author type="solo">Andrzej Mendygrał</text_author>
  <composer type="solo">tradycyjna</composer>
  <artist type="band">Cztery Refy</artist>
  <original_title>The Press Gang</original_title>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="c"/>W dół od rzeki <ch a="B"/>poprzez <ch a="c"/>London <ch a="B"/>Street</row>
      <row important_over="true"><ch a="c"/>Psów królewskich <ch a="B"/>zwarty oddział <ch a="c"/>szedł:</row>
      <row important_over="true"><ch a="g"/>Ojczyźnie trzeba dziś <ch a="f"/>świeżej <ch a="G"/>krwi –</row>
      <row important_over="true"><ch a="B"/>Mary<ch a="c"/>narzy <ch a="B"/>floty wo<ch a="c"/>jennej.</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="c"/>A że byłem <ch a="B"/>wtedy <ch a="c"/>silny <ch a="B"/>chłop,</row>
      <row important_over="false"><ch a="c"/>W tłumie złowił <ch a="B"/>mnie sierżanta <ch a="c"/>wzrok:</row>
      <row important_over="false"><ch a="g"/>W kajdanach z bramy wy<ch a="f"/>wlekli <ch a="G"/>mnie –</row>
      <row important_over="false"><ch a="B"/>Mary<ch a="c"/>narza <ch a="B"/>floty wo<ch a="c"/>jennej.</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="c"/>Jak o prawa <ch a="B"/>upomi<ch a="c"/>nać <ch a="B"/>się</row>
      <row important_over="false"><ch a="c"/>Na gretingu <ch a="B"/>nauczyli <ch a="c"/>mnie:</row>
      <row important_over="false"><ch a="g"/>Niejeden krwią wtedy <ch a="f"/>spłynął <ch a="G"/>grzbiet –</row>
      <row important_over="false"><ch a="B"/>Mary<ch a="c"/>narza <ch a="B"/>floty wo<ch a="c"/>jennej.</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="c"/>Nikt nie zliczy, <ch a="B"/>ile <ch a="c"/>krwi i <ch a="B"/>łez</row>
      <row important_over="false"><ch a="c"/>Wsiąka w pokład, <ch a="B"/>nim się skończy <ch a="c"/>rejs:</row>
      <row important_over="false"><ch a="g"/>Dla chwały twej, słodki <ch a="f"/>kraju <ch a="G"/>mój –</row>
      <row important_over="false"><ch a="B"/>Mary<ch a="c"/>narzy <ch a="B"/>floty wo<ch a="c"/>jennej.</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="c"/>Hej, za rufą <ch a="B"/>mile <ch a="c"/>został <ch a="B"/>dom,</row>
      <row important_over="false"><ch a="c"/>Jesteś tylko <ch a="B"/>parą silnych <ch a="c"/>rąk:</row>
      <row important_over="false"><ch a="g"/>Dowódca tu twoim <ch a="f"/>bogiem <ch a="G"/>jest –</row>
      <row important_over="false"><ch a="B"/>Mary<ch a="c"/>narzu <ch a="B"/>floty wo<ch a="c"/>jennej.</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="c"/>Gdy łapaczy <ch a="B"/>szyk for<ch a="c"/>muje <ch a="B"/>się,</row>
      <row important_over="false"><ch a="c"/>W pierwszym rzędzie <ch a="B"/>możesz ujrzeć <ch a="c"/>mnie:</row>
      <row important_over="false"><ch a="g"/>Kto stanie na mojej <ch a="f"/>drodze <ch a="G"/>dziś –</row>
      <row important_over="false"><ch a="B"/>Łup sta<ch a="c"/>nowi <ch a="B"/>floty wo<ch a="c"/>jennej.</row>
    </block>
  </lyric>
