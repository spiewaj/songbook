<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Pójdźmy wszyscy do stajenki">
  <text_author type="solo">Tradycyjna</text_author>
  <comment>Tradycyjna polska kolęda powstała w XVII wieku.</comment>
  <composer type="solo">Tradycyjna</composer>
  <artist type="band">Kolęda tradycyjna</artist>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="C"/>Pójdźmy wszyscy do stajenki,</row>
      <row important_over="never">Do Jezusa i Panienki.</row>
      <bis>
        <row important_over="true"><ch a="d"/>Powi<ch a="G"/>tajmy <ch a="C"/>Maleń<ch a="a"/>kiego</row>
        <row important_over="true"><ch a="d"/>I Ma<ch a="G"/>ryję, <ch a="C"/>Matkę <ch a="a"/>Jego. <ch a="C"/></row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="never">Witaj, Jezu ukochany,</row>
      <row important_over="never">Od patriarchów czekany.</row>
      <bis>
        <row important_over="never">Od proroków ogłoszony,</row>
        <row important_over="never">Od narodów upragniony.</row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="never">Witaj, Dzieciąteczko w żłobie,</row>
      <row important_over="never">Wyznajemy Boga w Tobie,</row>
      <bis>
        <row important_over="never">Coś się narodził tej nocy,</row>
        <row important_over="never">Byś nas wyrwał z czarta mocy.</row>
      </bis>
    </block>
  </lyric>
  <music metre="4/4">
    <guitar barre="0"/>
  </music>
  <genre>kolęda</genre>
  <status>
    <done>
      <text/>
