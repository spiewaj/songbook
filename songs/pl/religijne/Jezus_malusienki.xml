  <original_title/>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="a"/>Jezus malusi<ch a="E7"/>eńki,</row>
      <row important_over="true"><ch a="a"/>Leży wśród staj<ch a="E7"/>enki,</row>
      <bis times="2">
        <row important_over="true"><ch a="d"/>Płacze z z<ch a="G7"/>imna, ni<ch a="C"/>e dała M<ch a="a"/>u</row>
        <row important_over="true"><ch a="d"/>Matula suki<ch a="E7"/>enk<ch a="a"/>i.</row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="a"/>Bo uboga b<ch a="E7"/>yła,</row>
      <row important_over="false"><ch a="a"/>Rąbek z głowy zdj<ch a="E7"/>ęła,</row>
      <bis times="2">
        <row important_over="false"><ch a="d"/>W który Dzi<ch a="G7"/>ecię ow<ch a="C"/>inąwszy,<ch a="a"/></row>
        <row important_over="false"><ch a="d"/>Siankiem Je okr<ch a="E7"/>ył<ch a="a"/>a.</row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="a"/>Nie ma koleb<ch a="E7"/>eczki</row>
      <row important_over="false"><ch a="a"/>Ani podusz<ch a="E7"/>eczki,</row>
      <bis times="2">
        <row important_over="false"><ch a="d"/>We żłobie M<ch a="G7"/>u poł<ch a="C"/>ożyła<ch a="a"/></row>
        <row important_over="false"><ch a="d"/>Siana pod główeczk<ch a="E7"/><ch a="a"/>i.</row>
      </bis>
    </block>
  </lyric>
