<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Gdy się Chrystus rodzi">
  <text_author type="solo">Tradycyjna</text_author>
  <comment>Tradycyjna polska kolęda, znana co najmniej od przełomu XVI i XVII wieku. Zapisana m.in. w zbiorze „Pastorałki i kolędy z melodyjami” ks. Michała Mioduszewskiego (1843).</comment>
  <composer type="solo">Tradycyjna</composer>
  <artist type="band">Kolęda tradycyjna</artist>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="A"/>Gdy się <ch a="D"/>Chrystus <ch a="A"/>rodzi</row>
      <row important_over="true">I na <ch a="D"/>świat przy<ch a="E"/>cho<ch a="A"/>dzi,</row>
      <row important_over="true"><ch a="A"/>Ciemna <ch a="D"/>noc w jas<ch a="A"/>ności</row>
      <row important_over="true">Promie<ch a="D"/>nistej <ch a="E"/>bro<ch a="A"/>dzi.</row>
    </block>
    <block type="chorus">
      <bis>
        <row important_over="true"><ch a="E"/>Aniołowie się radują,</row>
        <row important_over="true">Pod niebiosy <ch a="A"/>wyśpiewują:</row>
        <row important_over="true"><ch a="A"/>Gloria, <ch a="D"/>gloria, <ch a="E7"/>gloria</row>
        <row important_over="true"><ch a="A"/>In ex<ch a="D"/>celsis <ch a="A"/>De<ch a="E"/>o!<ch a="A"/></row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="A"/>Mówią <ch a="D"/>do paste<ch a="A"/>rzy,</row>
      <row important_over="false">Którzy <ch a="D"/>trzód swych <ch a="E"/>strze<ch a="A"/>gli,</row>
      <row important_over="false"><ch a="A"/>Aby <ch a="D"/>do Betle<ch a="A"/>jem</row>
      <row important_over="false">Czym prę<ch a="D"/>dzej po<ch a="E"/>bie<ch a="A"/>gli.</row>
    </block>
    <block type="chorus">
      <bis>
        <row important_over="false"><ch a="E"/>Bo się narodził Zbawiciel,</row>
        <row important_over="false">Wszego świata <ch a="A"/>Odkupiciel:</row>
        <row important_over="false"><ch a="A"/>Gloria, <ch a="D"/>gloria, <ch a="E7"/>gloria</row>
        <row important_over="false"><ch a="A"/>In ex<ch a="D"/>celsis <ch a="A"/>De<ch a="E"/>o!<ch a="A"/></row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="A"/>O nie<ch a="D"/>bieskie du<ch a="A"/>chy</row>
      <row important_over="false">I po<ch a="D"/>słowie <ch a="E"/>nie<ch a="A"/>ba,</row>
      <row important_over="false"><ch a="A"/>Powiedz<ch a="D"/>cie wyraź<ch a="A"/>nie,</row>
      <row important_over="false">Co nam <ch a="D"/>czynić <ch a="E"/>trze<ch a="A"/>ba.</row>
    </block>
    <block type="chorus">
      <bis>
        <row important_over="false"><ch a="E"/>Bo my nic nie pojmujemy,</row>
        <row important_over="false">Ledwo od strachu <ch a="A"/>żyjemy:</row>
        <row important_over="false"><ch a="A"/>Gloria, <ch a="D"/>gloria, <ch a="E7"/>gloria</row>
        <row important_over="false"><ch a="A"/>In ex<ch a="D"/>celsis <ch a="A"/>De<ch a="E"/>o!<ch a="A"/></row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="A"/>Idźcie <ch a="D"/>do Betle<ch a="A"/>jem,</row>
      <row important_over="false">Gdzie Dzie<ch a="D"/>cię zro<ch a="E"/>dzo<ch a="A"/>ne,</row>
      <row important_over="false"><ch a="A"/>W pielusz<ch a="D"/>ki powi<ch a="A"/>te,</row>
      <row important_over="false">W żłobie <ch a="D"/>poło<ch a="E"/>żo<ch a="A"/>ne.</row>
    </block>
    <block type="chorus">
      <bis>
        <row important_over="false"><ch a="E"/>Oddajcie Mu pokłon boski,</row>
        <row important_over="false">On osłodzi <ch a="A"/>wasze troski:</row>
        <row important_over="false"><ch a="A"/>Gloria, <ch a="D"/>gloria, <ch a="E7"/>gloria</row>
        <row important_over="false"><ch a="A"/>In ex<ch a="D"/>celsis <ch a="A"/>De<ch a="E"/>o!<ch a="A"/></row>
      </bis>
    </block>
  </lyric>
