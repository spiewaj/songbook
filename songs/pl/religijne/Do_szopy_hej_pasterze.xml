  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="D"/>Do szopy, hej, past<ch a="A"/>erze,</row>
      <row important_over="true"><ch a="A7"/>Do szopy, bo tam c<ch a="D"/>ud,</row>
      <row important_over="false"><ch a="D"/>Syn Boży w żłobie l<ch a="A"/>eży,</row>
      <row important_over="false"><ch a="A7"/>By zbawić ludzki r<ch a="D"/>ód.</row>
    </block>
    <block type="chorus">
      <bis times="2">
        <row important_over="true"><ch a="G"/>Śpiewajcie anioł<ch a="D"/>owie, p<ch a="A"/>asterze grajcie m<ch a="D"/>u,</row>
        <row important_over="true"><ch a="G"/>Kłaniajcie się król<ch a="D"/>owie, ni<ch a="A"/>e zbudźcie go ze sn<ch a="D"/>u.</row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="D"/>Padnijmy na kol<ch a="A"/>ana,</row>
      <row important_over="false"><ch a="A7"/>To dziecię, to nasz B<ch a="D"/>óg,</row>
      <row important_over="false"><ch a="D"/>Witajmy swego P<ch a="A"/>ana,</row>
      <row important_over="false"><ch a="A7"/>Miłości złóżmy dł<ch a="D"/>ug.</row>
    </block>
    <blocklink blocknb="2"/>
