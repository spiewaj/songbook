  <alias/>
  <text_author type="solo">Tradycyjna</text_author>
  <comment>Polska kolęda-kołysanka z początku XVIII wieku.</comment>
  <composer type="solo">Tradycyjna</composer>
  <artist type="band">Kolęda tradycyjna</artist>
  <translator/>
  <original_title/>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="G"/>Gdy śliczna P<ch a="C"/>anna S<ch a="G"/>yna kołys<ch a="e"/>ała,<ch a="a"/><ch a="D"/><ch a="D7"/><ch a="G"/></row>
      <row important_over="true">Z wi<ch a="C"/>elkim wes<ch a="G"/>elem t<ch a="e"/>ak Jemu śpiew<ch a="a"/>ała:<ch a="D"/><ch a="D7"/><ch a="G"/></row>
    </block>
    <block type="chorus">
      <bis times="2">
        <row important_over="true"><ch a="G"/>Li, li, li, li, l<ch a="C"/>aj, m<ch a="G"/>oje Dzieciąt<ch a="e"/>eczko,<ch a="a"/><ch a="D"/><ch a="D7"/><ch a="G"/></row>
        <row important_over="false"><ch a="G"/>Li, li, li, li, l<ch a="C"/>aj, śl<ch a="G"/>iczne Paniąt<ch a="e"/>eczko.<ch a="a"/><ch a="D"/><ch a="D7"/><ch a="G"/></row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="G"/>Wszystko stworz<ch a="C"/>enie, śpi<ch a="G"/>ewaj Panu sw<ch a="e"/>emu,<ch a="a"/><ch a="D"/><ch a="D7"/><ch a="G"/></row>
      <row important_over="false">P<ch a="C"/>omóż rad<ch a="G"/>ości wi<ch a="e"/>elkiej sercu m<ch a="a"/>emu:<ch a="D"/><ch a="D7"/><ch a="G"/></row>
    </block>
    <block type="chorus">
      <bis times="2">
        <row important_over="false"><ch a="G"/>Li, li, li, li, l<ch a="C"/>aj, wi<ch a="G"/>elki Królew<ch a="e"/>iczu,<ch a="a"/><ch a="D"/><ch a="D7"/><ch a="G"/></row>
        <row important_over="false"><ch a="G"/>Li, li, li, li, l<ch a="C"/>aj, ni<ch a="G"/>ebieski Dziedz<ch a="e"/>icu.<ch a="a"/><ch a="D"/><ch a="D7"/><ch a="G"/></row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="G"/>Sypcie się z ni<ch a="C"/>eba, śl<ch a="G"/>iczni anioł<ch a="e"/>owie,<ch a="a"/><ch a="D"/><ch a="D7"/><ch a="G"/></row>
      <row important_over="false">Śpi<ch a="C"/>ewajcie P<ch a="G"/>anu, ni<ch a="e"/>ebiescy duch<ch a="a"/>owie:<ch a="D"/><ch a="D7"/><ch a="G"/></row>
    </block>
    <block type="chorus">
      <bis times="2">
        <row important_over="false"><ch a="G"/>Li, li, li, li, l<ch a="C"/>aj, m<ch a="G"/>ój wonny kwiateczk<ch a="e"/>u,<ch a="a"/><ch a="D"/><ch a="D7"/><ch a="G"/></row>
        <row important_over="false"><ch a="G"/>Li, li, li, li, l<ch a="C"/>aj, w ub<ch a="G"/>ogim żłób<ch a="e"/>eczku.<ch a="a"/><ch a="D"/><ch a="D7"/><ch a="G"/></row>
      </bis>
    </block>
  </lyric>
