<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Bieszczadzka ciuchcia">
  <text_author type="solo">Piotr Frankowicz</text_author>
  <composer type="solo">Piotr Frankowicz</composer>
  <artist type="band">Wołosatki</artist>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="C"/>Jedzie bieszczadzka <ch a="d"/>ciuchcia,</row>
      <row important_over="true"><ch a="F"/>sypie, <ch a="G"/>strzela is<ch a="C"/>krami.</row>
      <row important_over="true"><ch a="C"/>Taka, co przed stu <ch a="d"/>laty</row>
      <row important_over="true">jeź<ch a="F"/>dziła <ch a="G"/>z trape<ch a="C"/>rami.</row>
    </block>
    <block type="chorus">
      <row important_over="true"><ch a="g"/>Bucha <ch a="C"/>dym z komina,</row>
      <row important_over="true"><ch a="g"/>bucha <ch a="C"/>dym z komina,</row>
      <row important_over="true"><ch a="F"/>drzewa <ch a="a"/>ucie<ch a="D"/>kają.</row>
      <row important_over="true"><ch a="g"/>Która <ch a="C"/>to godzina,</row>
      <row important_over="true"><ch a="g"/>która <ch a="C"/>to godzina,</row>
      <row important_over="true"><ch a="F"/>koła <ch a="a"/>rytm stu<ch a="D7"/>kają.</row>
      <row important_over="true"><ch a="g"/>Wjeżdżamy w <ch a="C"/>nasz</row>
      <row important_over="true">zie<ch a="F"/>lony, romantyczny <ch a="D7"/>świat,</row>
      <row important_over="true"><ch a="g"/>z którym <ch a="C"/>już <ch a="F"/>przyjaźnimy się od <ch a="D7"/>lat.</row>
      <row important_over="true"><ch a="g"/>Bucha <ch a="C"/>dym z komina,</row>
      <row important_over="true"><ch a="g"/>bucha <ch a="C"/>dym z komina.</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="C"/>Jedzie bieszczadzka <ch a="d"/>ciuchcia,</row>
      <row important_over="false"><ch a="F"/>stara <ch a="G"/>i śmieszna <ch a="C"/>troszkę,</row>
      <row important_over="false"><ch a="C"/>taką jeździł mój <ch a="d"/>dziadek,</row>
      <row important_over="false">ści<ch a="F"/>gając <ch a="G"/>babci pończ<ch a="C"/>oszkę.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false"><ch a="C"/>Jedzie bieszczadzka <ch a="d"/>ciuchcia,</row>
      <row important_over="false">pokr<ch a="F"/>yta pa<ch a="G"/>tyną cz<ch a="C"/>asu.</row>
      <row important_over="false"><ch a="C"/>Sapie, kicha cz<ch a="d"/>asami</row>
      <row important_over="false">w gł<ch a="F"/>ębi biesz<ch a="G"/>czadzkich l<ch a="C"/>asów.</row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
