<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="We wtorek w schronisku po sezonie">
	<alias>Złotym kobiercem wymoszczone góry</alias>
	<text_author type="solo">Wiesław Buchcic</text_author>
	<comment>Zweryfikowane z oryginalnym nagraniem zespołu Wołosatki.</comment>
	<composer type="solo">Ryszard Pomorski</composer>
	<artist type="band">Wołosatki</artist>
	<lyric xmlns="http://21wdh.staszic.waw.pl">
		<block type="verse">
			<row important_over="true">Złotym k<ch a="G"/>obiercem w<ch a="C"/>ymoszczone g<ch a="G"/>óry,</row>
			<row important_over="true"><ch a="h"/>Jesień w doliny z<ch a="C"/>eszła dziś nad r<ch a="a"/>an<ch a="D"/>em.</row>
			<row important_over="true">Buki cz<ch a="G"/>erwienią z<ch a="C"/>abarwiły chm<ch a="H7"/>ury,<ch a="e"/></row>
			<row important_over="true">Z latem się zł<ch a="C"/>otym wł<ch a="D"/>aśnie pożegnał<ch a="G"/>em.<ch a="D"/></row>
		</block>
		<block type="chorus">
			<row important_over="true"><ch a="G"/>We wtorek w schron<ch a="C"/>isku po sez<ch a="D"/>onie,<ch a="G"/></row>
			<row important_over="true"><ch a="e"/>W doliny wczoraj zsz<ch a="A7"/>edł ostatni g<ch a="D"/>ość.</row>
			<row important_over="true">Za oknem pl<ch a="G"/>ucha, k<ch a="C"/>ubek parzy dł<ch a="H7"/>oni<ch a="e"/>e</row>
			<row important_over="true">I tej herb<ch a="C"/>aty, i tych g<ch a="D"/>ór mam d<ch a="G"/>ość.</row>
		</block>
		<block type="verse">
			<row important_over="false">Szar<ch a="G"/>uga niebo pow<ch a="C"/>oli zasn<ch a="G"/>uwa,</row>
			<row important_over="false"><ch a="h"/>Wiatr już gałęzie po<ch a="C"/>otrząsał z l<ch a="a"/>iśc<ch a="D"/>i.</row>
			<row important_over="false">Pod wiatr, p<ch a="G"/>od górę zn<ch a="C"/>owu sam zas<ch a="H7"/>uwam,<ch a="e"/></row>
			<row important_over="false">M<ch a="C"/>oże w schronisku sp<ch a="D"/>otkam kogoś z bl<ch a="G"/>iskich.<ch a="D"/></row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="false">L<ch a="G"/>udzie tak wiele spr<ch a="C"/>aw muszą zał<ch a="G"/>atwić,</row>
			<row important_over="false"><ch a="h"/>A czas sobie płynie w<ch a="C"/>olno panta rh<ch a="a"/>e<ch a="D"/>i.</row>
			<row important_over="false">Do si<ch a="G"/>ebie tylko j<ch a="C"/>uż nie umiem tr<ch a="H7"/>afić,<ch a="e"/></row>
			<row important_over="false">K<ch a="C"/>ochać to więcej si<ch a="D"/>ebie dać, czy mni<ch a="G"/>ej?<ch a="D"/></row>
		</block>
		<blocklink blocknb="2"/>
	</lyric>
	<music metre="4/4">
		<guitar barre="0"/>
	</music>
	<album>Bieszczady</album>
