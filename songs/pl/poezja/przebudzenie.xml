  <composer>Angelika Ziomek, Michał Ziomek</composer>
  <artist type="band">Ziomkowisko</artist>
  <lyric>
    <block type="other">
      <row important_over="false" style="instr"><ch a="C"/><ch a="e"/><ch a="F"/><ch a="G"/></row>
    </block>
    <block type="verse">
      <bis times="2">
        <row important_over="true"><ch a="C"/>Zamknięte oczy w ciemn<ch a="e"/>ości,</row>
        <row important_over="true"><ch a="F"/>oddech spokojny, dobry to <ch a="G"/>sen,</row>
        <row important_over="false"><ch a="C"/>między wierszami, niczym par<ch a="e"/>ami,</row>
        <row important_over="false"><ch a="F"/>przenika światło i ci<ch a="G"/>eń.</row>
      </bis>
    </block>
    <block type="chorus">
      <bis times="2">
        <row important_over="true"><ch a="C"/>Wybudza mnie z nocy <ch a="e"/>dzień,</row>
        <row important_over="true"><ch a="F"/>tak subtelnie wita <ch a="G"/>świt,</row>
        <row important_over="false"><ch a="C"/>w tej wdzięczności wiem, że życi<ch a="e"/>e – nie –</row>
        <row important_over="false"><ch a="F"/>nie prześpię ci<ch a="G"/>ę.</row>
      </bis>
    </block>
    <block type="verse">
      <bis times="2">
        <row important_over="false">nim <ch a="C"/>bose stopy poczują chł<ch a="e"/>ód,</row>
        <row important_over="false">nim szkł<ch a="F"/>a do patrzenia wł<ch a="G"/>ożę,</row>
        <row important_over="false"><ch a="C"/>ostatni raz o świcie dn<ch a="e"/>ia,</row>
        <row important_over="false">ryt<ch a="F"/>uał – miłosno wtul<ch a="G"/>eni.</row>
      </bis>
    </block>
