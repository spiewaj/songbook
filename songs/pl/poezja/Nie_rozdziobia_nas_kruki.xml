	<lyric>
		<block type="verse">
			<row important_over="true">Nie rozdzi<ch a="D"/>obią nas kr<ch a="G0"/>uki, <ch a="h"/><ch a="G"/></row>
			<row important_over="true">Ni wr<ch a="Fis"/>ony, <ch a="e"/>ani n<ch a="A7/4"/>ic!</row>
			<row important_over="true">Nie rozsz<ch a="D"/>arpią na szt<ch a="G0"/>uki <ch a="h"/><ch a="G"/></row>
			<row important_over="true">Po<ch a="D"/>ezji wści<ch a="A"/>ekłe kł<ch a="G"/>y!</row>
		</block>
		<block type="chorus">
			<row important_over="true">Ruszaj się, Br<ch a="Fis"/>uno, idziemy na p<ch a="h"/>iwo,</row>
			<row important_over="true">Niech<ch a="G"/>ybnie brak<ch a="D"/>uje tam n<ch a="A"/>as!</row>
			<row important_over="true">Od stania w mi<ch a="Fis"/>ejscu niejeden już zg<ch a="h"/>inął,</row>
			<row important_over="true">Niej<ch a="G"/>eden zg<ch a="D"/>inął już kw<ch a="A"/>iat! <ch a="D"/></row>
		</block>
		<block type="verse">
			<row important_over="false">Nie om<ch a="D"/>ami nas f<ch a="G0"/>orsa, <ch a="h"/><ch a="G"/></row>
			<row important_over="false">Ni sł<ch a="Fis"/>awy p<ch a="e"/>usty dźwi<ch a="A7/4"/>ęk!</row>
			<row important_over="false">Inną ści<ch a="D"/>ągamy post<ch a="G0"/>ać: <ch a="h"/><ch a="G"/></row>
			<row important_over="false">Re<ch a="D"/>alnej zj<ch a="A"/>awy tr<ch a="G"/>en!</row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="false">Nie zdechni<ch a="D"/>emy tak sz<ch a="G0"/>ybko, <ch a="h"/><ch a="G"/></row>
			<row important_over="false">Jak s<ch a="Fis"/>obie r<ch a="e"/>oi śmi<ch a="A7/4"/>erć!</row>
			<row important_over="false">Ziemia dl<ch a="D"/>a nas za pł<ch a="G0"/>ytka, <ch a="h"/><ch a="G"/></row>
			<row important_over="false">Fruni<ch a="D"/>emy w g<ch a="A"/>óry gdzi<ch a="G"/>eś!</row>
		</block>
		<blocklink blocknb="2"/>
	</lyric>
