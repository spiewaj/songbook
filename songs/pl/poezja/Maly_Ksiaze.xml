<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Mały Książę">
	<alias/>
	<text_author type="solo">Krzysztof Dzikowski</text_author>
	<comment/>
	<composer type="solo">Ryszard Poznakowski</composer>
	<artist type="solo">Katarzyna Sobczyk</artist>
	<translator/>
	<original_title/>
	<lyric>
		<block type="verse">
			<row important_over="true"><ch a="C"/>Gdzie jesteś, Mały Książę, gdzie?</row>
			<row important_over="true"><ch a="E7"/>Odszedłeś z mej książeczki kart.</row>
			<bis>
				<row important_over="true"><ch a="F"/>Czy po pust<ch a="G"/>yni bł<ch a="C"/>ądzisz zn<ch a="a"/>ów,</row>
				<row important_over="true"><ch a="d"/>Rozmawiasz z <ch a="G"/>echem pośród sk<ch a="C"/>ał?<ch a="C7"/></row>
			</bis>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="C"/>Czy tam, gdzie świeci Złoty Wóz,</row>
			<row important_over="false"><ch a="E7"/>Oglądasz Ziemię w swoich snach?</row>
			<row important_over="false"><ch a="F"/>Czy pozost<ch a="G"/>ała z d<ch a="C"/>awnych dn<ch a="a"/>i</row>
			<row important_over="false"><ch a="d"/>Niby wspomni<ch a="G"/>enie, bajka t<ch a="C"/>a?<ch a="C7"/></row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="C"/>W maleńkiej róży kochał się</row>
			<row important_over="false"><ch a="E7"/>Książę na jednej z wielu gwiazd.</row>
			<row important_over="false"><ch a="F"/>Nie widział j<ch a="G"/>eszcze <ch a="C"/>innych r<ch a="a"/>óż,</row>
			<row important_over="false"><ch a="d"/>Kiedy w dal<ch a="G"/>eki poszedł świ<ch a="C"/>at.<ch a="C7"/></row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="C"/>Na Ziemi zwątpił w miłość swą,</row>
			<row important_over="false"><ch a="E7"/>Ten najpiękniejszy z wszystkich snów,</row>
			<row important_over="false"><ch a="F"/>Bo jak miał w j<ch a="G"/>ednej k<ch a="C"/>ochać si<ch a="a"/>ę,</row>
			<row important_over="false"><ch a="d"/>Gdy ujrzał p<ch a="G"/>ark z tysiącem r<ch a="C"/>óż?<ch a="C7"/></row>
		</block>
		<block type="other">
			<row important_over="never">„Nie wierz swym oczom” – szepnął wiatr,</row>
			<row important_over="never">„Jeżeli kochasz – sercem patrz”.</row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="C"/>Zrozumiał wtedy książę to,</row>
			<row important_over="false"><ch a="E7"/>Że tylko jedna w świecie jest,</row>
			<row important_over="false"><ch a="F"/>Ta, którą k<ch a="G"/>ochał z wsz<ch a="C"/>ystkich s<ch a="a"/>ił,</row>
			<row important_over="false"><ch a="d"/>I wrócił zn<ch a="G"/>ów do róży sw<ch a="C"/>ej.<ch a="C7"/></row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="C"/>Gdzie jesteś, Mały Książę, gdzie?</row>
			<row important_over="false"><ch a="E7"/>Odszedłeś z mej książeczki kart.</row>
			<row important_over="false"><ch a="F"/>W świecie, gdzie n<ch a="G"/>ikt nie k<ch a="C"/>ocha r<ch a="a"/>óż,</row>
			<row important_over="false"><ch a="d"/>Na zawsze kt<ch a="G"/>oś pozostał s<ch a="C"/>am.</row>
		</block>
	</lyric>
