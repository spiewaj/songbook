	<lyric>
		<block type="verse">
			<row important_over="true"><ch a="a"/>Ty się pochyl, r<ch a="e"/>óża-bóg,</row>
			<row important_over="true"><ch a="a"/>ty się do mnie p<ch a="e"/>ochyl i</row>
			<row important_over="true"><ch a="G"/>i na ucho jak k<ch a="a"/>olczyk, róża-bóg,</row>
			<row important_over="true">a<ch a="G"/>aa… <ch a="a"/><ch a="G"/><ch a="a"/></row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="a"/>Moje ucho m<ch a="e"/>a dzban,</row>
			<row important_over="false"><ch a="a"/>z niego pić tylko t<ch a="e"/>obie, nikomu,</row>
			<row important_over="false"><ch a="G"/>a twój kolczyk jak <ch a="a"/>ucho na dzban,</row>
			<row important_over="false">a<ch a="G"/>aa… <ch a="a"/><ch a="G"/><ch a="a"/></row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="a"/>O modlitwy mn<ch a="e"/>ie wabisz,</row>
			<row important_over="false"><ch a="a"/>O, wabisz. Że bł<ch a="e"/>ysk noża</row>
			<row important_over="false"><ch a="G"/>w najpiękniejsze s<ch a="a"/>erce kozy,</row>
			<row important_over="false">a<ch a="G"/>aa… <ch a="a"/><ch a="G"/><ch a="a"/></row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="a"/>Z tobą czystość zach<ch a="e"/>ować to gorzej,</row>
			<row important_over="false"><ch a="a"/>każdy lew by się sp<ch a="e"/>alił już dawno,</row>
			<row important_over="false"><ch a="G"/>las popiołu z jego grz<ch a="a"/>ywy, nic więcej,</row>
			<row important_over="false">a<ch a="G"/>aa… <ch a="a"/><ch a="G"/><ch a="a"/></row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="a"/>Ty się pochyl, r<ch a="e"/>óża-bóg,</row>
			<row important_over="false"><ch a="a"/>Ty się do mnie p<ch a="e"/>ochyl we mnie,</row>
			<row important_over="false"><ch a="G"/>Wytryśniemy jak sł<ch a="a"/>ońce wytryśnie,</row>
			<row important_over="false">a<ch a="G"/>aa… <ch a="a"/><ch a="G"/><ch a="a"/></row>
			<row important_over="false">a<ch a="G"/>aa… <ch a="a"/><ch a="G"/><ch a="a"/></row>
		</block>
	</lyric>
