	<alias>Mur 1, Stoimy pod murem</alias>
	<text_author type="solo">Zbigniew Herbert</text_author>
	<comment>Wiersz Zbigniewa Herberta z tomu „Struna światła” (1956).</comment>
	<composer type="solo">Przemysław Gintrowski</composer>
	<artist type="solo">Przemysław Gintrowski</artist>
	<translator/>
	<original_title/>
	<lyric>
		<block type="verse">
			<row important_over="true"><ch a="e"/>Stoimy pod m<ch a="a"/>ur<ch a="e"/>em,</row>
			<row important_over="true"><ch a="D"/>Zdjęto nam młodość jak koszulę skazańc<ch a="e"/>om,</row>
			<row important_over="true"><ch a="D"/>Czek<ch a="e"/>amy.</row>
			<row important_over="true"><ch a="e"/>Zanim tłusta kula usi<ch a="a"/>ądzie na k<ch a="e"/>arku,<ch a="D"/><ch a="e"/></row>
			<row important_over="true"><ch a="D"/>Mija dziesięć, dwadzieścia l<ch a="e"/>at.</row>
			<row important_over="true"><ch a="G"/>Mur jest wys<ch a="D"/>oki i m<ch a="e"/>ocny,</row>
			<row important_over="true"><ch a="G"/>Za murem jest drzw<ch a="D"/>ewo i gwi<ch a="e"/>azda,</row>
			<row important_over="true"><ch a="G"/>Drzewo podw<ch a="D"/>aża mur korzeni<ch a="G"/>ami,<ch a="D"/></row>
			<row important_over="true"><ch a="G"/>Gwiazda nagr<ch a="D"/>yza kamień jak m<ch a="e"/>ysz.</row>
			<row important_over="false"><ch a="e"/>Za sto, dwieście l<ch a="a"/>at<ch a="e"/></row>
			<row important_over="false"><ch a="D"/>Będzie już małe oki<ch a="e"/>enko,</row>
			<row important_over="false"><ch a="D"/>Będzie już małe oki<ch a="e"/>enko,</row>
			<row important_over="false"><ch a="D"/>Już małe oki<ch a="e"/>enko,</row>
			<row important_over="false"><ch a="D"/>Małe oki<ch a="e"/>enko.</row>
		</block>
	</lyric>
