	<lyric>
		<block type="verse">
			<row important_over="true">N<ch a="a"/>igdy w życiu mym nie umi<ch a="d6"/>ałem zdjąć</row>
			<row important_over="true">cz<ch a="F"/>apki prz<ch a="E"/>ed nik<ch a="a"/>ik<ch a="F"/>im, <ch a="E"/></row>
			<row important_over="true">a t<ch a="a"/>eraz na twarz, na kol<ch a="d6"/>ana ryms</row>
			<row important_over="true">prz<ch a="F"/>ed jej b<ch a="E"/>ucik<ch a="a"/>ie<ch a="F"/>m. <ch a="E"/></row>
			<row important_over="true">B<ch a="a"/>yłem wściekłym psem, ona <ch a="d6"/>uczy mnie,</row>
			<row important_over="true">j<ch a="F"/>ak jeść z j<ch a="E"/>ej rączk<ch a="a"/>i, <ch a="F"/><ch a="E"/></row>
			<row important_over="true">mi<ch a="a"/>ałem wilcze kły, zami<ch a="d6"/>eniłem je</row>
			<row important_over="true">n<ch a="F"/>a mleczn<ch a="E"/>e ząbk<ch a="a"/>i. <ch a="F"/><ch a="E"/></row>
		</block>
		<block type="chorus">
			<row important_over="true">J<ch a="a"/>estem mały miś, własność lali tej, <ch a="H"/><ch a="E"/></row>
			<row important_over="true">co p<ch a="a"/>alec ssie, kiedy zas<ch a="G"/>ypia, <ch a="C"/><ch a="E"/></row>
			<row important_over="true">j<ch a="a"/>estem mały miś, własność lali tej, <ch a="H"/><ch a="E"/></row>
			<row important_over="true">co m<ch a="a"/>amy chce, gdy jej dot<ch a="G"/>ykam. <ch a="C"/><ch a="E"/><ch a="a"/></row>
		</block>
		<block type="verse">
			<row important_over="false">B<ch a="a"/>yłem twardy drań, ona spr<ch a="d6"/>awia, że</row>
			<row important_over="false">j<ch a="F"/>ak z maki<ch a="E"/>em klusk<ch a="a"/>a, <ch a="F"/><ch a="E"/></row>
