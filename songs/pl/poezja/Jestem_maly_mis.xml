			<row important_over="false">wp<ch a="F"/>adam w j<ch a="E"/>ej ust<ch a="a"/>a. <ch a="F"/><ch a="E"/></row>
			<row important_over="false">Ml<ch a="a"/>eczne ząbki ma, kiedy śmi<ch a="d6"/>eje się</row>
			<row important_over="false">i ki<ch a="F"/>edy śpi<ch a="E"/>ew<ch a="a"/>a, <ch a="F"/><ch a="E"/></row>
			<row important_over="false">l<ch a="a"/>ecz ma wilcze kły, gdy jest n<ch a="d6"/>a mnie zła</row>
			<row important_over="false">i gd<ch a="F"/>y się gni<ch a="E"/>ew<ch a="a"/>a. <ch a="F"/><ch a="E"/></row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="false">Si<ch a="a"/>edzę w kącie mym i cich<ch a="d6"/>utko łkam</row>
			<row important_over="false">p<ch a="F"/>od jej pant<ch a="E"/>ofl<ch a="a"/>em, <ch a="F"/><ch a="E"/></row>
			<row important_over="false">ki<ch a="a"/>edy wścieka się, choć pow<ch a="d6"/>odów brak,</row>
			<row important_over="false">b<ch a="F"/>o jest zazdr<ch a="E"/>osn<ch a="a"/>a. <ch a="F"/><ch a="E"/></row>
			<row important_over="false">P<ch a="a"/>ewien śliczny kwiat wydał m<ch a="d6"/>i się raz</row>
			<row important_over="false">ł<ch a="F"/>adniejsz<ch a="E"/>y od ni<ch a="a"/>ej, <ch a="F"/><ch a="E"/></row>
			<row important_over="false">p<ch a="a"/>ewien śliczny kwiat zginąć m<ch a="d6"/>usiał więc</row>
			<row important_over="false">p<ch a="F"/>od jej pant<ch a="E"/>ofl<ch a="a"/>em. <ch a="F"/><ch a="E"/></row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="false">Wsz<ch a="a"/>yscy mędrcy wciąż wykrzyk<ch a="d6"/>ują mi,</row>
			<row important_over="false">ż<ch a="F"/>e w jej rami<ch a="E"/>on<ch a="a"/>ach, <ch a="F"/><ch a="E"/></row>
			<row important_over="false">gdy skrzyż<ch a="a"/>ują się i opl<ch a="d6"/>otą mnie,</row>
			<row important_over="false">ni<ch a="F"/>echybni<ch a="E"/>e skon<ch a="a"/>am. <ch a="F"/><ch a="E"/></row>
			<row important_over="false">M<ch a="a"/>oże będzie tak, może b<ch a="d6"/>ędzie siak,</row>
			<row important_over="false">al<ch a="F"/>e dość krz<ch a="E"/>yk<ch a="a"/>ów: <ch a="F"/><ch a="E"/></row>
			<row important_over="false">j<ch a="a"/>eśli zginąć mam, jeśli wisi<ch a="d6"/>eć mam,</row>
			<row important_over="false">t<ch a="F"/>o na jej krz<ch a="E"/>yż<ch a="a"/>u! <ch a="F"/><ch a="E"/></row>
		</block>
