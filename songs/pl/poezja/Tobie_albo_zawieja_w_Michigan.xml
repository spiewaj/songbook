    <block type="verse">
      <row important_over="never">Zawieja w Michigan</row>
      <row important_over="never">Zapada serce w śnieg</row>
      <row important_over="never">Pustkowie ciągnie się</row>
      <row important_over="never">Wysepki żadnej, drzew</row>
      <row important_over="never">Ni domu, z domu gest</row>
      <row important_over="never">Wejdź, wejdź, wejdź, wejdź, wejdź</row>
      <row important_over="never">Pustkowie hen i hen</row>
      <row important_over="never">Zawieja mróz i biel</row>
      <row important_over="never">Zawyłem aż po kres</row>
      <row important_over="never">Czy spodziewać się, że…</row>
      <row important_over="never">A wicher w trąbki dmie</row>
      <row important_over="never">Nie nie nie nie nie</row>
    </block>
