<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Tobie albo zawieja w Michigan">
	<alias>Zawieja w Michigan</alias>
	<text_author type="solo">Edward Stachura</text_author>
	<comment>Słowa: Edward Stachura (ze zbioru „Po ogrodzie niech hula szarańcza”, 1968).</comment>
	<composer type="solo">Krzysztof Myszkowski</composer>
	<artist type="band">Stare Dobre Małżeństwo</artist>
	<lyric>
		<block type="other">
			<row style="instr"><ch a="G"/><ch a="C"/><ch a="G"/><ch a="a"/><ch a="C"/><ch a="G"/><ch a="D"/><ch a="e"/><ch a="C"/><ch a="D"/></row>
		</block>
		<block type="verse">
			<row important_over="true"><ch a="G"/>Zawieja w Mi<ch a="C"/>chigan</row>
			<row important_over="true"><ch a="G"/>Zapada <ch a="a"/>serce w śnieg</row>
			<row important_over="true"><ch a="C"/>Pustkowie ciągnie się</row>
			<row important_over="true"><ch a="G"/>Wysepki żadnej, <ch a="D"/>drzew</row>
			<row important_over="true"><ch a="e"/>Ni domu, z domu gest</row>
			<row important_over="true"><ch a="C"/>Wejdź, wejdź, wejdź, wejdź, <ch a="D"/>wejdź</row>
			<row important_over="true"><ch a="G"/>Pustkowie hen <ch a="C"/>i hen</row>
			<row important_over="true"><ch a="G"/>Zawieja mróz <ch a="a"/>i biel</row>
			<row important_over="true"><ch a="C"/>Zawyłem aż po kres</row>
			<row important_over="true"><ch a="G"/>Czy spodziewać się, <ch a="D"/>że…</row>
			<row important_over="true"><ch a="e"/>A wicher w trąbki dmie</row>
			<row important_over="true"><ch a="C"/>Nie, nie, nie, nie, <ch a="D"/>nie</row>
		</block>
		<block type="other">
			<row style="instr"><ch a="G"/><ch a="C"/><ch a="G"/><ch a="a"/><ch a="C"/><ch a="G"/><ch a="D"/><ch a="e"/><ch a="C"/><ch a="D"/></row>
		</block>
		<block type="verse">
			<row><ch a="G"/>Miłości na<ch a="C"/>sze tam</row>
			<row><ch a="G"/>Są tam, gdzie nie <ch a="a"/>ma nas</row>
			<row><ch a="C"/>U Boga w środku gwiazd</row>
			<row><ch a="G"/>Pokochał też <ch a="D"/>bym brak</row>
			<row><ch a="e"/>I cały słałbym blask</row>
			<row><ch a="C"/>W dal, w dal, w dal, w dal, <ch a="D"/>w dal</row>
		</block>
		<block type="other">
			<row style="instr"><ch a="G"/><ch a="C"/><ch a="G"/><ch a="a"/><ch a="C"/><ch a="G"/><ch a="D"/><ch a="e"/><ch a="C"/><ch a="D"/><ch a="G"/><ch a="C"/><ch a="G"/></row>
		</block>
	</lyric>
