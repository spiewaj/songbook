    <block type="verse">
      <row important_over="never">Miłości nasze tam</row>
      <row important_over="never">Są tam, gdzie nie ma nas</row>
      <row important_over="never">U Boga w środku gwiazd</row>
      <row important_over="never">Pokochał też bym brak</row>
      <row important_over="never">I cały słałbym blask</row>
      <row important_over="never">W dal, w dal, w dal, w dal, w dal</row>
