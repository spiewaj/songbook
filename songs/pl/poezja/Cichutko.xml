	<lyric>
		<block type="verse">
			<row important_over="true">Cich<ch a="e"/>utko, pomal<ch a="D"/>eńk<ch a="e"/>u,</row>
			<row important_over="true">gdzie wi<ch a="D"/>atr w gałęziach drzew</row>
			<row important_over="true">dog<ch a="C"/>ania ciszę pt<ch a="G"/>asich gni<ch a="D"/>azd.<ch a="e"/></row>
		</block>
		<block type="verse">
			<row important_over="true">Gdzie gwi<ch a="D"/>azd milczących dal,</row>
			<row important_over="true">odl<ch a="e"/>egła, niewiad<ch a="D"/>oma,</row>
			<row important_over="true">ukr<ch a="C"/>yta w bezmiar sw<ch a="G"/>ej pięknośc<ch a="D"/>i...<ch a="e"/></row>
		</block>
		<block type="verse">
			<row>Cich<ch a="e"/>utko, pomal<ch a="D"/>eńk<ch a="e"/>u,</row>
			<row>przez świ<ch a="D"/>ata dziwny świat</row>
			<row>nie zw<ch a="C"/>ażaj na okr<ch a="G"/>utne oczy dni<ch a="D"/>a.<ch a="e"/></row>
		</block>
	</lyric>
