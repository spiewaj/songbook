	<lyric>
		<block type="verse">
			<row important_over="true">Gd<ch a="a"/>ybym miał gitarę, t<ch a="E"/>o bym na niej gr<ch a="a"/>ał, <ch a="A7"/></row>
			<row important_over="true">op<ch a="d"/>owiedziałbym o sw<ch a="a"/>ej miłości, kt<ch a="E"/>órą przeżyłem s<ch a="a"/>am.</row>
		</block>
		<block type="chorus">
			<bis>
				<row important_over="true">A wsz<ch a="a"/>ystko te czarne <ch a="E"/>oczy, gdybym ja je mi<ch a="a"/>ał, <ch a="A7"/></row>
				<row important_over="true">za t<ch a="d"/>e czarne, cudne ocz<ch a="a"/>ęta s<ch a="E"/>erce, duszę bym d<ch a="a"/>ał!</row>
			</bis>
		</block>
		<block type="verse">
			<row>F<ch a="a"/>ajki ja nie palę, w<ch a="E"/>ódki nie pij<ch a="a"/>ę, <ch a="A7"/></row>
			<row>ale z ż<ch a="d"/>alu, żalu wi<ch a="a"/>elkiego l<ch a="E"/>edwo co żyj<ch a="a"/>ę.</row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row>L<ch a="a"/>udzie mówią: głupi, p<ch a="E"/>o coś ty ją br<ch a="a"/>ał, <ch a="A7"/></row>
			<row>po c<ch a="d"/>oś to dziewczę cz<ch a="a"/>arne, figlarne m<ch a="E"/>ocno pokoch<ch a="a"/>ał?</row>
		</block>
		<blocklink blocknb="2"/>
	</lyric>
