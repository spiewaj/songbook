	<lyric>
		<block type="verse">
			<row important_over="true">L<ch a="C"/>etnich wiecz<ch a="E"/>orów wspomni<ch a="a7"/>enie</row>
			<row important_over="true">wr<ch a="F"/>aca jak bumer<ch a="C"/>ang,</row>
			<row important_over="true">w<ch a="C"/>ygasłych <ch a="E"/>ognisk płomi<ch a="a7"/>enie</row>
			<row important_over="true">tl<ch a="F"/>ą się jeszcze we sn<ch a="G"/>ach.</row>
			<row important_over="true">N<ch a="C"/>a twarzy śl<ch a="E"/>ad opalen<ch a="a"/>izny</row>
			<row important_over="true">p<ch a="F"/>o każdym myciu bl<ch a="G"/>edszy,</row>
			<row important_over="true">zacz<ch a="C"/>ynamy się wst<ch a="e"/>ydzić gol<ch a="a"/>izny,</row>
			<row important_over="true">zacz<ch a="d7"/>ynamy ubi<ch a="G"/>erać się ci<ch a="C"/>eple<ch a="F"/>j. <ch a="C"/></row>
		</block>
		<block type="chorus">
			<row important_over="true">Odwij<ch a="C"/>amy wspomni<ch a="E"/>enia ze szp<ch a="a"/>ulek,</row>
			<row important_over="true">wyświetl<ch a="F"/>amy na ści<ch a="G"/>anie kol<ch a="C"/>ory,</row>
			<row important_over="true">przekład<ch a="F"/>amy z plec<ch a="G"/>aków do bi<ch a="C"/>urek</row>
			<row important_over="true">dł<ch a="F"/>ugie wiecz<ch a="G"/>ory.</row>
		</block>
		<block type="verse">
			<row important_over="false">Ci<ch a="C"/>eplej ubr<ch a="E"/>ani w sw<ch a="a7"/>etry,</row>
			<row important_over="false">w gr<ch a="F"/>ube skarpety wełni<ch a="C"/>ane,</row>
			<row important_over="false">ni<ch a="C"/>espokojnie w kal<ch a="E"/>oryfer wpatrz<ch a="a7"/>eni –</row>
			<row important_over="false">a n<ch a="F"/>uż grzać nie będzie wc<ch a="G"/>ale.</row>
			<row important_over="false">N<ch a="C"/>a pociechę si<ch a="E"/>ęgamy do p<ch a="a"/>udeł,</row>
			<row important_over="false">wyciąg<ch a="F"/>amy stare fotogr<ch a="G"/>afie,</row>
			<row important_over="false">zapatrz<ch a="C"/>eni w nie c<ch a="e"/>icho myśl<ch a="a"/>imy</row>
			<row important_over="false">o l<ch a="d7"/>ecie, które b<ch a="G"/>ędzie – j<ch a="C"/>aki<ch a="F"/>e? <ch a="C"/></row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="false">Z<ch a="C"/>a oknem pi<ch a="E"/>erwsze płatki śni<ch a="a7"/>egu,</row>
			<row important_over="false">choć t<ch a="F"/>o jeszcze nie z<ch a="C"/>ima,</row>
			<row important_over="false">mi<ch a="C"/>eszkanie z<ch a="E"/>imne jak bi<ch a="a7"/>egun,</row>
			<row important_over="false">a m<ch a="F"/>y ciągle myśl<ch a="G"/>imy,</row>
			<row important_over="false">c<ch a="C"/>o czeka n<ch a="E"/>as w przyszłym r<ch a="a"/>oku,</row>
			<row important_over="false">j<ch a="F"/>akie nam dane przyg<ch a="G"/>ody,</row>
			<row important_over="false">widz<ch a="C"/>imy sznur pt<ch a="e"/>aków na ni<ch a="a"/>ebie –</row>
			<row important_over="false">j<ch a="d7"/>esień znów str<ch a="G"/>aszy niepog<ch a="C"/>od<ch a="F"/>ą. <ch a="C"/></row>
		</block>
