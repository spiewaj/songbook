<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Zegarmistrz światła">
  <comment>Tekst powtarza się cztery razy. Za pierwszym razem łagodnie, za drugim mocniejszym biciem, za trzecim wyżej (akordy barowe), za czwartym powrót do dynamiki początkowej (wg nagrania z festiwalu w Opolu i kasety Krainy Łagodności).</comment>
  <text_author>Bogdan Chorążuk</text_author>
  <composer type="solo">Tadeusz Woźniak</composer>
  <artist type="solo">Tadeusz Woźniak</artist>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="a"/>A kiedy przyjdzie także p<ch a="G"/>o mnie</row>
      <row important_over="true"><ch a="D"/>Zegarmistrz światła purpur<ch a="a"/>owy,</row>
      <row important_over="true"><ch a="C"/>By mi zabełtać błękit w gł<ch a="G"/>owie,</row>
      <row important_over="false"><ch a="D"/>To będę jasny i got<ch a="a"/>owy.</row>
    </block>
    <block type="chorus">
      <row important_over="true"><ch a="a"/>Spłyną przeze mnie dni na prz<ch a="G"/>estrzał,</row>
      <row important_over="true"><ch a="D"/>Zgasną podłogi i powi<ch a="a"/>etrza,</row>
      <row important_over="true"><ch a="C"/>Na wszystko jeszcze raz pop<ch a="G"/>atrzę</row>
      <row important_over="false"><ch a="D"/>I pójdę, nie wiem gdzie, na z<ch a="a"/>awsze.</row>
    </block>
  </lyric>
  <genre>Poezja śpiewana</genre>
