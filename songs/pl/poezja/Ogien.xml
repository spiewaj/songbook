<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Ogień">
	<alias>Zwyczaj to stary jak świat</alias>
	<text_author type="solo">tradycyjny</text_author>
	<composer type="solo">tradycyjny</composer>
	<artist type="band">tradycyjny</artist>
	<genre>piosenka harcerska</genre>
	<lyric>
		<block type="verse">
			<row important_over="true">Zw<ch a="C"/>yczaj to stary jak świ<ch a="F"/>at:</row>
			<row important_over="true"><ch a="G"/>Ogień, ogień, ogi<ch a="C"/>eń.</row>
			<row important_over="true">R<ch a="C"/>ozpalmy blisko n<ch a="F"/>as</row>
			<row important_over="true"><ch a="G"/>ogień, ogień, ogi<ch a="C"/>eń.</row>
		</block>
		<block type="chorus">
			<row important_over="true">Dl<ch a="C"/>a spóźnionego wędrowc<ch a="F"/>a,</row>
			<row important_over="true">dl<ch a="C"/>a wszystkich spóźnionych w n<ch a="F"/>oc</row>
			<row important_over="true">r<ch a="G"/>ozp<ch a="C"/>almy t<ch a="F"/>u, r<ch a="G"/>ozpalmy t<ch a="C"/>u</row>
			<row important_over="true"><ch a="C"/>ogi<ch a="F"/>eń, <ch a="G"/>ogi<ch a="C"/>eń!</row>
		</block>
		<block type="verse">
			<row important_over="false">Pi<ch a="C"/>erwsza gwiazdka już wz<ch a="F"/>eszła,</row>
			<row important_over="false">cz<ch a="G"/>as, by ogień rozpalić.<ch a="C"/></row>
			<row important_over="false">L<ch a="C"/>ipy, sosny i b<ch a="F"/>uki</row>
			<row important_over="false">ch<ch a="G"/>ylą gałęzie ku n<ch a="C"/>am.</row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="false">N<ch a="C"/>ajpiękniejsze ognisk<ch a="F"/>a,</row>
			<row important_over="false">z trz<ch a="G"/>askiem sypią się skr<ch a="C"/>y.</row>
			<row important_over="false">Wok<ch a="C"/>ół samych przyjaciół m<ch a="F"/>asz,</row>
			<row important_over="false">zaśpi<ch a="G"/>ewaj z nami i t<ch a="C"/>y!</row>
		</block>
		<blocklink blocknb="2"/>
	</lyric>
