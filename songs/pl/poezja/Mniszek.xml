<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Mniszek">
	<alias>Los włóczęgi, Pójdę jak szary brat zakonny</alias>
	<text_author type="solo">Siergiej Jesienin</text_author>
	<comment>Wiersz Siergieja Jesienina „Пойду в скуфье смиренным иноком...” z 1914 r. w przekładzie Jerzego Litwiniuka.</comment>
	<composer type="solo">Andrzej Wojda</composer>
	<artist type="solo">Andrzej Wojda</artist>
	<translator>Jerzy Litwiniuk</translator>
	<original_title>Пойду в скуфье смиренным иноком...</original_title>
	<lyric>
		<block type="verse">
			<row important_over="true"><ch a="a"/>Pójdę jak sz<ch a="F"/>ary br<ch a="a"/>at zak<ch a="F"/>onny,</row>
			<row important_over="true"><ch a="a"/>Albo włóczęga lnianowł<ch a="F"/>osy,</row>
			<row important_over="true"><ch a="a"/>W tę stronę, z kt<ch a="d"/>órej na zagony</row>
			<row important_over="true"><ch a="G"/>Leje się jasne mleko brz<ch a="a"/>ozy.</row>
			<row important_over="false"><ch a="a"/>Chcę Ziemię z kr<ch a="F"/>ańca w kr<ch a="a"/>aniec zmi<ch a="F"/>erzyć,</row>
			<row important_over="false"><ch a="a"/>Idąc za blaskiem gwiazdy pł<ch a="F"/>onnej,</row>
			<row important_over="false"><ch a="a"/>I w szczęście bl<ch a="d"/>iźnich znów uwierzyć</row>
			<row important_over="false"><ch a="G"/>Na miedzy żytem rozdzwonion<ch a="a"/>ej.</row>
		</block>
		<block type="chorus">
			<row important_over="true"><ch a="a"/>I mówię tak sam<ch a="F"/>emu sobie,</row>
			<row important_over="true"><ch a="G"/>Patrząc na wite z łyka kr<ch a="a"/>ęgi:</row>
			<row important_over="false"><ch a="a"/>Szczęśliwy, k<ch a="F"/>ogo przyozdobił</row>
			<row important_over="false"><ch a="G"/>Kijem i torbą los włócz<ch a="a"/>ęgi.</row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="a"/>Kto w swym ubóstwie ni<ch a="F"/>e zna troski,</row>
			<row important_over="false"><ch a="G"/>Ani przyjaciół, ani wr<ch a="a"/>ogów,</row>
			<row important_over="false"><ch a="a"/>I może z wi<ch a="F"/>oski iść do wioski,</row>
			<row important_over="false"><ch a="G"/>Modląc się do spotkanych st<ch a="a"/>ogów.</row>
			<row important_over="false"><ch a="a"/>Świt z ręką p<ch a="F"/>ełną chł<ch a="a"/>odnej r<ch a="F"/>osy</row>
			<row important_over="false"><ch a="a"/>Rumiane jabłka zorzy str<ch a="F"/>ąca,</row>
			<row important_over="false"><ch a="a"/>Kosiarze, gr<ch a="d"/>abiąc traw pokosy,</row>
			<row important_over="false"><ch a="G"/>Pieśnią witają mnie na ł<ch a="a"/>ące.</row>
		</block>
		<blocklink blocknb="2"/>
	</lyric>
