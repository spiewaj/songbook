<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Deszcz jesienny">
	<alias>Deszcz, jesienny deszcz</alias>
	<text_author type="solo">Marian Matuszkiewicz</text_author>
	<comment>Piosenka powstała w 1943 roku w Szarych Szeregach / Armii Krajowej.</comment>
	<composer type="solo">Marian Matuszkiewicz</composer>
	<artist type="band">Czerwone Gitary</artist>
	<translator/>
	<original_title/>
	<lyric>
		<block type="verse">
			<row important_over="true">D<ch a="D"/>eszcz jesienny d<ch a="G"/>eszcz smutne pi<ch a="D"/>eśni łka,</row>
			<row important_over="true">m<ch a="A7"/>okną na nim k<ch a="D"/>arabiny, h<ch a="A7"/>ełmy kryje rdz<ch a="D"/>a.</row>
			<row important_over="true">Ni<ch a="G"/>eś po bł<ch a="D"/>ocie w dal, w z<ch a="G"/>apłakany świ<ch a="D"/>at</row>
			<row important_over="true">prz<ch a="A7"/>emoczone p<ch a="D"/>od plecakiem <ch a="A7"/>osiemnaście l<ch a="D"/>at.</row>
		</block>
		<block type="verse">
			<row>Gdzi<ch a="D"/>eś daleko st<ch a="G"/>ąd mrok zap<ch a="D"/>ada znów,</row>
			<row>ci<ch a="A7"/>emna główka tw<ch a="D"/>ej dziewczyny ch<ch a="A7"/>yli się do sn<ch a="D"/>u.</row>
			<row>M<ch a="G"/>oże właśnie dz<ch a="D"/>iś patrzy w mr<ch a="G"/>oczną mgł<ch a="D"/>ę,</row>
			<row>m<ch a="A7"/>odlitwą pr<ch a="D"/>osi Boga, b<ch a="A7"/>y zachował ci<ch a="D"/>ę.</row>
		</block>
		<block type="verse">
			<row>D<ch a="D"/>eszcz jesienny d<ch a="G"/>eszcz bębni w h<ch a="D"/>ełmu stal,</row>
			<row><ch a="A7"/>idziesz, młody ż<ch a="D"/>ołnierzyku, gdz<ch a="A7"/>ieś w nieznaną d<ch a="D"/>al.</row>
			<row>M<ch a="G"/>oże dobry B<ch a="D"/>óg da, że wr<ch a="G"/>ócisz zn<ch a="D"/>ów,</row>
			<row>b<ch a="A7"/>ędziesz tulił ci<ch a="D"/>emną głowę m<ch a="A7"/>iłej twej do sn<ch a="D"/>u.</row>
		</block>
		<block type="verse">
			<row>D<ch a="G"/>a, że wrócisz zn<ch a="D"/>ów, da, że wr<ch a="G"/>ócisz zn<ch a="D"/>ów,</row>
			<row>b<ch a="A7"/>ędziesz tulił ci<ch a="D"/>emną głowę m<ch a="A7"/>iłej twej do sn<ch a="D"/>u.</row>
		</block>
	</lyric>
