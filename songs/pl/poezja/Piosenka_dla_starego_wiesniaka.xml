  <alias>Chanson pour l'Auvergnat</alias>
  <text_author type="solo">Georges Brassens</text_author>
  <comment></comment>
  <composer type="solo">Georges Brassens</composer>
  <artist type="band">Zespół Reprezentacyjny</artist>
  <translator>Jarosław Gugała</translator>
  <original_title>Chanson pour l'Auvergnat</original_title>
  <lyric>
    <block type="verse">
      <row important_over="true">Dla c<ch a="d"/>iebie śpiewam piosenkę <ch a="A"/>tę,</row>
      <row important_over="false">st<ch a="A"/>ary wieśniaku, za to, <ch a="d"/>że</row>
      <row important_over="true">gdy z<ch a="d"/>imno było w życiu m<ch a="A"/>ym,</row>
      <row important_over="true">ty dr<ch a="d"/>ewno swe oddałeś m<ch a="C"/>i.<ch a="F"/><ch a="A"/></row>
      <row important_over="false">Ty d<ch a="d"/>ałeś ogień wtedy, gd<ch a="A"/>y</row>
      <row important_over="false">ob<ch a="A"/>ywatele godni czc<ch a="d"/>i</row>
      <row important_over="false">i bl<ch a="d"/>iźni nasi wszyscy w kr<ch a="A"/>ąg</row>
      <row important_over="true">zamkn<ch a="B"/>ęli przede mną swe drzw<ch a="C"/>i.<ch a="F"/></row>
    </block>
    <block type="chorus">
      <row important_over="true">To prz<ch a="F"/>ecież nic, to parę dr<ch a="g"/>ew,<ch a="C"/><ch a="F"/></row>
      <row important_over="true">lecz st<ch a="d"/>arczy, żeby ogrzać si<ch a="g6"/>ę,<ch a="d"/></row>
      <row important_over="true">a w d<ch a="d"/>uszy mej płonęły t<ch a="A9-"/>ak,<ch a="d"/></row>
      <row important_over="true">jak pł<ch a="B"/>onąłby cały l<ch a="A"/>as.</row>
      <row important_over="true">Więc k<ch a="d"/>iedy umrzesz kiedyś j<ch a="A"/>uż,</row>
      <row important_over="false">gdy wi<ch a="A"/>eźć cię będzie czarny w<ch a="d"/>óz,</row>
      <row important_over="true">niech prz<ch a="d"/>ez niebiański cię wiedzie szl<ch a="B"/>ak<ch a="g"/><ch a="C"/></row>
      <row important_over="true">aż d<ch a="B"/>o nieba br<ch a="A"/>am.<ch a="d"/></row>
    </block>
    <block type="verse">
      <row important_over="false">Dla c<ch a="d"/>iebie śpiewam piosenkę <ch a="A"/>tę,</row>
      <row important_over="false">d<ch a="A"/>obra kobieto, za to, <ch a="d"/>że</row>
      <row important_over="false">gdy gł<ch a="d"/>odno było w życiu m<ch a="A"/>ym,</row>
      <row important_over="false">ty chl<ch a="d"/>eb swój oddałaś m<ch a="C"/>i.<ch a="F"/><ch a="A"/></row>
      <row important_over="false">Ty otw<ch a="d"/>orzyłaś mi swój d<ch a="A"/>om,</row>
      <row important_over="false">gdy bl<ch a="A"/>iźni nasi wszyscy w kr<ch a="d"/>ąg,</row>
      <row important_over="false">ob<ch a="d"/>ywatele godni czc<ch a="A"/>i</row>
      <row important_over="false">zamkn<ch a="B"/>ęli przede mną swe drzw<ch a="C"/>i.<ch a="F"/></row>
    </block>
    <block type="chorus">
      <row important_over="false">To prz<ch a="F"/>ecież nic, to tylko chl<ch a="g"/>eb,<ch a="C"/><ch a="F"/></row>
      <row important_over="false">lecz st<ch a="d"/>arczy, żeby najeść si<ch a="g6"/>ę,<ch a="d"/></row>
      <row important_over="false">a j<ch a="d"/>a do dzisiaj w sercu m<ch a="A9-"/>am<ch a="d"/></row>
      <row important_over="false">ten z<ch a="B"/>apach chleba i ten sm<ch a="A"/>ak.</row>
      <row important_over="false">Więc j<ch a="d"/>eśli umrzesz kiedyś j<ch a="A"/>uż,</row>
      <row important_over="false">gdy wi<ch a="A"/>eźć cię będzie czarny w<ch a="d"/>óz,</row>
      <row important_over="false">niech prz<ch a="d"/>ez niebiański cię wiedzie szl<ch a="B"/>ak<ch a="g"/><ch a="C"/></row>
      <row important_over="false">aż d<ch a="B"/>o nieba br<ch a="A"/>am.<ch a="d"/></row>
    </block>
    <block type="verse">
      <row important_over="false">Dla c<ch a="d"/>iebie śpiewam piosenkę <ch a="A"/>tę,</row>
      <row important_over="false">obcy czł<ch a="A"/>owieku, bowiem t<ch a="d"/>y</row>
      <row important_over="false">jed<ch a="d"/>ynie mi współczułeś, gd<ch a="A"/>y</row>
      <row important_over="false">żand<ch a="d"/>armi zabrali mn<ch a="C"/>ie.<ch a="F"/><ch a="A"/></row>
      <row important_over="false">Ty j<ch a="d"/>eden smutny miałeś wzr<ch a="A"/>ok,</row>
      <row important_over="false">gdy bl<ch a="A"/>iźni nasi wszyscy w kr<ch a="d"/>ąg,</row>
      <row important_over="false">ob<ch a="d"/>ywatele godni czc<ch a="A"/>i</row>
      <row important_over="false">kl<ch a="B"/>askali w swe dłonie, co s<ch a="C"/>ił.<ch a="F"/></row>
    </block>
    <block type="chorus">
      <row important_over="false">To prz<ch a="F"/>ecież nic, spojrzenie tw<ch a="g"/>e,<ch a="C"/><ch a="F"/></row>
      <row important_over="false">lecz t<ch a="d"/>aka dziwna moc w nim j<ch a="g6"/>est,<ch a="d"/></row>
      <row important_over="false">że bl<ch a="d"/>ask twych oczu jeszcze dz<ch a="A9-"/>iś<ch a="d"/></row>
      <row important_over="false">ot<ch a="B"/>uchy dodaje m<ch a="A"/>i.</row>
      <row important_over="false">Więc j<ch a="d"/>eśli umrzesz kiedyś j<ch a="A"/>uż,</row>
      <row important_over="false">gdy wi<ch a="A"/>eźć cię będzie czarny w<ch a="d"/>óz,</row>
      <row important_over="false">niech prz<ch a="d"/>ez niebiański cię wiedzie szl<ch a="B"/>ak<ch a="g"/><ch a="C"/></row>
      <row important_over="false">aż d<ch a="B"/>o nieba br<ch a="A"/>am.<ch a="d"/></row>
    </block>
  </lyric>
