<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Ballada o nocy czerwcowej">
  <alias>Noc czerwcowa</alias>
  <text_author type="solo">Konstanty Ildefons Gałczyński</text_author>
  <comment>Pieśń ta powinna być wykonywana w rytmie walczyka</comment>
  <composer>Maryla Ochimowska-Teper</composer>
  <artist type="solo">Maryla Ochimowska-Teper</artist>
  <lyric>
    <block type="verse">
      <row important_over="true">Kiedy no<ch a="D"/>c się w powietrzu zaczy<ch a="e"/>na,</row>
      <row important_over="true">Wtedy n<ch a="G"/>oc jest jak młoda dziewczyn<ch a="D"/>a:</row>
      <row important_over="false">Wszystko cie<ch a="D"/>szy ją i wszystko śmies<ch a="e"/>zy,</row>
      <row important_over="false">Wszystko w rę<ch a="G"/>ce chciałaby <ch a="D"/>brać.</row>
    </block>
    <block type="verse">
      <row important_over="false">Diabeł du<ch a="D"/>żo jej daje w podar<ch a="e"/>ku</row>
      <row important_over="false">Gwiazd fałsz<ch a="G"/>ywych z gwiezdnego jarma<ch a="D"/>rku.</row>
      <row important_over="false">Noc te gwia<ch a="D"/>zdy do uszu przymier<ch a="e"/>za</row>
      <row important_over="true">I z gwiazda<ch a="G"/>mi chci<ch a="A7"/>ałaby <ch a="D"/>spać.</row>
    </block>
    <block type="chorus">
      <bis times="2">
        <row important_over="true">Ja je<ch a="D"/>stem noc czerwcow<ch a="e"/>a,</row>
        <row important_over="true">Królo<ch a="G"/>wa jaśminow<ch a="D"/>a.</row>
        <row important_over="false">Zap<ch a="D"/>atrzcie się w moje ręc<ch a="e"/>e,</row>
        <row important_over="true">Wsłucha<ch a="A7"/>jcie się w śpiewny <ch a="D"/>chód.</row>
      </bis>
    </block>
    <block type="verse">
      <row important_over="false">Ale z<ch a="D"/>anim dur gwiezdny ją op<ch a="e"/>lótł,</row>
      <row important_over="false">Idzie kr<ch a="G"/>okiem tanecznym przez o<ch a="D"/>gród.</row>
      <row important_over="false">Do ogr<ch a="D"/>odu przez senne uli<ch a="e"/>ce,</row>
      <row important_over="false">Dzwonią n<ch a="G"/>ocy ciężkie zauszni<ch a="D"/>ce.</row>
    </block>
    <block type="verse">
      <row important_over="false">I po k<ch a="D"/>ażdym tanecznym obr<ch a="e"/>ocie</row>
      <row important_over="false">Szmaragd<ch a="G"/>ami dzwonią kołki w pl<ch a="D"/>ocie.</row>
      <row important_over="false">Wreszcie d<ch a="D"/>o nas pod same o<ch a="e"/>kna,</row>
      <row important_over="false">I tak t<ch a="G"/>ańczy i ś<ch a="A7"/>piewa n<ch a="D"/>am:</row>
    </block>
    <blocklink blocknb="3"/>
  </lyric>
