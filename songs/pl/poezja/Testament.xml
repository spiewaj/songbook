<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Testament">
	<alias>Idę samotny wśród gór, zagubiony w świecie</alias>
	<text_author type="solo">Arkadiusz Belica</text_author>
	<composer type="solo">Arkadiusz Belica</composer>
	<artist type="solo">Arkadiusz Belica</artist>
	<lyric xmlns="http://21wdh.staszic.waw.pl">
		<block type="verse">
			<row important_over="true"><ch a="fis"/>Idę samotny wśród gór, zagubiony w świecie –</row>
			<row important_over="true"><ch a="A"/>Wiatr tylko ścieżki me zna,</row>
			<row important_over="true"><ch a="E"/>Słońce niebawem za horyzont się wyniesie,</row>
			<row important_over="true"><ch a="fis"/>Światem zawładnie mgła.</row>
			<row important_over="false"><ch a="fis"/>Gdy wśród ciemności jakiś ognik ujrzysz,</row>
			<row important_over="false"><ch a="A"/>Będzie to dobry znak,</row>
			<row important_over="false"><ch a="E"/>Nowych ludzi poznam, od nich się nauczę</row>
			<row important_over="false"><ch a="fis"/>Gawęd starych tak jak świat.</row>
		</block>
		<block type="chorus">
			<row important_over="true"><ch a="A"/>Niech każdy z was się d<ch a="E"/>owie,</row>
			<row important_over="true">Co traci, nie będąc t<ch a="fis"/>u,</row>
			<row important_over="false"><ch a="A"/>Świerk szumem ci op<ch a="E"/>owie,</row>
			<row important_over="false">Co zaszło tu przed lat st<ch a="fis"/>u.</row>
			<row important_over="false"><ch a="A"/>Strumień orzeźwi ci st<ch a="E"/>opy,</row>
			<row important_over="false">I on kiedyś wody d<ch a="fis"/>ał</row>
			<row important_over="false"><ch a="A"/>Spragnionym w górach węd<ch a="E"/>rowcom,</row>
			<row important_over="false">Co szli tędy tak jak j<ch a="fis"/>a.</row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="fis"/>Góra za górą chowa swe oblicze,</row>
			<row important_over="false"><ch a="A"/>Lecz te dokładnie już znam,</row>
			<row important_over="false"><ch a="E"/>Żadna mi nie ujdzie, wszystko zaliczę,</row>
			<row important_over="false"><ch a="fis"/>Chociaż o drogi szmat.</row>
			<row important_over="false"><ch a="fis"/>Wciąż lat przybywa i świat się też starzeje,</row>
			<row important_over="false"><ch a="A"/>Cóż – naturalna to rzecz,</row>
			<row important_over="false"><ch a="E"/>Ktoś, kto przeglądać będzie stare szpargały,</row>
			<row important_over="false"><ch a="fis"/>Może przeczyta ten tekst.</row>
		</block>
		<blocklink blocknb="2"/>
	</lyric>
	<music metre="4/4">
		<guitar barre="0"/>
	</music>
