<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Coś">
  <alias>Masz w sobie to coś</alias>
  <text_author type="solo">Barbara Sobolewska</text_author>
  <composer type="solo">Barbara Sobolewska</composer>
  <artist type="band">Mikroklimat</artist>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="A"/>Mam w sobie to <ch a="A7"/>coś, co mnie <ch a="D"/>grzeje w chłodny <ch a="A"/>dzień,</row>
      <row important_over="true">Co <ch a="h7"/>sprawia, że <ch a="E7"/>uśmiecham się do <ch a="A"/>ludzi,</row>
      <row important_over="true">I <ch a="A"/>chętnie wstaję <ch a="A7"/>rano, żeby biec po ser i <ch a="D"/>chleb,</row>
      <row important_over="false">A <ch a="h7"/>każdy spotkany <ch a="E7"/>liść mój zachwyt <ch a="A"/>budzi.</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="A"/>Masz w sobie to <ch a="A7"/>coś, widzę <ch a="D"/>dobrze w twoich <ch a="A"/>oczach,</row>
      <row important_over="false">Sł<ch a="h7"/>yszę w twoich <ch a="E7"/>długich palcach, <ch a="A"/>kiedy grasz,</row>
      <row important_over="false">Gdy wy<ch a="A"/>rywasz perz w og<ch a="A7"/>rodzie, gdy za<ch a="D"/>gadasz do sąsiada</row>
      <row important_over="false">I ci<ch a="h7"/>erpliwie sł<ch a="E7"/>uchasz mnie, choć gł<ch a="A"/>upstwa gadam.</row>
    </block>
    <block type="verse">
      <row important_over="true">To coś <ch a="D9"/>ciągnie nas do siebie,</row>
      <row important_over="true">I <ch a="A"/>ciągnie nas do ludzi,</row>
      <row important_over="true">Co w <ch a="G"/>oczy patrzą i <ch a="a"/>mówią szczerze:</row>
      <row important_over="true"><ch a="C"/>„Spójrz, wszędzie <ch a="h7/4"/>możesz <ch a="E"/>spotkać brata”.</row>
      <row important_over="true"><ch a="A"/>Chrońmy w sobie to coś,</row>
      <row important_over="true">bo <ch a="fis"/>może to jest wszystko,</row>
      <row important_over="true"><ch a="h7/4"/>Tajemnica i <ch a="E7"/>zagadka tego <ch a="A7"/>świata.</row>
    </block>
  </lyric>
