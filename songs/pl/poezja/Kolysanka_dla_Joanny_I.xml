	<lyric xmlns="http://21wdh.staszic.waw.pl">
		<block type="verse">
			<row important_over="true">Z<ch a="C"/>anim mi sen na <ch a="e"/>oczy spłynie,</row>
			<row important_over="true">M<ch a="d"/>oje myśli szyb<ch a="C"/>ują przez l<ch a="G"/>ufcik,</row>
			<row important_over="true">Ż<ch a="C"/>eby cię ujrzeć w <ch a="e"/>ową chwilę,</row>
			<row important_over="true">Gdy wł<ch a="a"/>osy czeszesz prz<ch a="C"/>ed l<ch a="G"/>ustrem.</row>
		</block>
		<block type="verse">
			<row important_over="false">A ki<ch a="C"/>edy zaśniesz w ci<ch a="e"/>epłej pościeli,</row>
			<row important_over="false">Zm<ch a="d"/>ęczone dł<ch a="C"/>ugim przel<ch a="G"/>otem,</row>
			<row important_over="false">J<ch a="C"/>ak ptaki głowy w skrz<ch a="e"/>ydła wtulają,</row>
			<row important_over="false">P<ch a="a"/>atrząc na s<ch a="C"/>en twój spok<ch a="G"/>ojny.<ch a="C"/><ch a="C7+"/></row>
		</block>
		<block type="verse">
			<row important_over="true">Ni<ch a="C"/>ech ci się przyśnią p<ch a="e"/>ory roku,</row>
			<row important_over="true">Ni<ch a="d"/>ech grają we śnie tw<ch a="C"/>oim i t<ch a="G"/>ańczą,</row>
			<row important_over="true">J<ch a="C"/>esień prężąca liście do l<ch a="G"/>otu,</row>
			<row important_over="true">L<ch a="C"/>ato w up<ch a="e"/>ale słon<ch a="G"/>ecznym.</row>
		</block>
		<block type="verse">
			<row important_over="false">A j<ch a="C"/>eśli zima, to w śniegu c<ch a="G"/>ała,</row>
			<row important_over="false">Wi<ch a="C"/>osna w miłków wiosennych ł<ch a="G"/>ąkach.</row>
			<bis times="3">
				<row important_over="true">Śp<ch a="C"/>ij, moje myśli nad tobą czuw<ch a="F"/>ają</row>
				<row important_over="true">N<ch a="e"/>a parap<ch a="G"/>ecie za <ch a="a"/>oknem.</row>
			</bis>
		</block>
	</lyric>
