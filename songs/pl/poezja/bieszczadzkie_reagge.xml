  <alias>Porannej mgły snuje się dym</alias>
  <text_author type="solo">Andrzej Starzec</text_author>
  <comment>Piosenka turystyczna i harcerska napisana w 1984 roku przez Andrzeja Starca.</comment>
  <composer type="solo">Andrzej Starzec</composer>
  <artist type="solo">Andrzej Starzec</artist>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="d"/>Porannej mgły <ch a="C"/>snuje się d<ch a="d"/>ym,<ch a="C"/></row>
      <row important_over="false"><ch a="d"/>Jutrzenki szal <ch a="C"/>na stokach g<ch a="d"/>ór.<ch a="C"/></row>
      <row important_over="true"><ch a="F"/>Nowy dzień <ch a="C"/>budzi się, <ch a="d"/>budzi si<ch a="C"/>ę,</row>
      <row important_over="false"><ch a="d"/>Melodię dnia <ch a="C"/>już rosa gr<ch a="d"/>a.<ch a="C"/></row>
    </block>
    <block type="chorus">
      <row important_over="true">R<ch a="d"/>eggae, bi<ch a="C"/>eszczadzkie r<ch a="d"/>eggae,</row>
      <row important_over="true">Sł<ch a="C"/>ońcem pachn<ch a="d"/>ące, ma j<ch a="C"/>agód sm<ch a="d"/>ak.<ch a="C"/></row>
      <row important_over="false">R<ch a="d"/>eggae, bi<ch a="C"/>eszczadzkie r<ch a="d"/>eggae,</row>
      <row important_over="true">J<ch a="C"/>ak potok rw<ch a="d"/>ący przed si<ch a="C"/>ebie gn<ch a="d"/>a.<ch a="C"/></row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="d"/>Połonin czar <ch a="C"/>ma taką m<ch a="d"/>oc,<ch a="C"/></row>
      <row important_over="false">Ż<ch a="d"/>e gdy je <ch a="C"/>ujrzysz pierwszy r<ch a="d"/>az,<ch a="C"/></row>
      <row important_over="false">Wr<ch a="F"/>ócić chcesz, <ch a="C"/>wrócić chcesz zn<ch a="d"/>ów za r<ch a="C"/>ok,</row>
      <row important_over="false">Z p<ch a="d"/>oranną r<ch a="C"/>osą czekać dni<ch a="d"/>a.<ch a="C"/></row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
