	<lyric>
		<block type="verse">
			<row important_over="true"><ch a="a"/>Gdy tak siedzimy nad b<ch a="G"/>imbrem,</row>
			<row important_over="true"><ch a="d"/>ojczyzna nam umiera,</row>
			<row important_over="true">gn<ch a="C"/>iją w celach kol<ch a="G"/>edzy,</row>
			<row important_over="true">w<ch a="a"/>olno się kręci powi<ch a="E"/>el<ch a="a"/>acz.</row>
			<row important_over="true">Dr<ch a="a"/>ukujemy ul<ch a="G"/>otki</row>
			<row important_over="true">o t<ch a="d"/>ym, że jeszcze żyjemy,</row>
			<row important_over="true">gr<ch a="C"/>ozi nam za to w<ch a="G"/>yrok</row>
			<row important_over="true">dzi<ch a="a"/>esięciu lat więzi<ch a="E"/>eni<ch a="a"/>a.</row>
			<row important_over="true">Gdzi<ch a="a"/>eś niedal<ch a="G"/>eko</row>
			<row important_over="true">p<ch a="d"/>atrol jednego z nas zatrzymał,</row>
			<row important_over="true">pij<ch a="C"/>emy jego zdr<ch a="G"/>owie –</row>
			<row important_over="true">w więzi<ch a="a"/>eniu to mu się prz<ch a="E"/>yd<ch a="a"/>a.</row>
		</block>
	</lyric>
