	<original_title/>
	<lyric>
		<block type="verse">
			<row important_over="true">B<ch a="C"/>yłem u wróżki – Piwna si<ch a="F"/>ed<ch a="G"/>em,<ch a="C"/></row>
			<row important_over="true">Wys<ch a="e"/>okie, kręte sch<ch a="a"/>od<ch a="e"/>y.<ch a="G"/></row>
			<row important_over="true">I<ch a="C"/>le mi jeszcze, chciałem wi<ch a="F"/>edz<ch a="G"/>ieć,<ch a="C"/></row>
			<row important_over="false">Upł<ch a="e"/>ynie w Wiśle w<ch a="a"/>od<ch a="e"/>y?<ch a="G"/></row>
			<row important_over="false">J<ch a="C"/>aka mnie kiedyś czeka bi<ch a="F"/>ed<ch a="G"/>a,<ch a="C"/></row>
			<row important_over="false">Lub j<ch a="e"/>akie urodz<ch a="a"/>aj<ch a="e"/>e?<ch a="G"/></row>
			<row important_over="false">Cz<ch a="C"/>y mi gitarę przyjdzie sprz<ch a="F"/>ed<ch a="G"/>ać,<ch a="C"/></row>
			<row important_over="false">Czy l<ch a="e"/>ecieć na Haw<ch a="a"/>aj<ch a="e"/>e?<ch a="G"/></row>
			<row important_over="true">A wr<ch a="a"/>óżka p<ch a="e"/>uka</row>
			<row important_over="true">W szkl<ch a="a"/>aną k<ch a="e"/>ulę</row>
			<row important_over="true">I m<ch a="a"/>ówi do mnie cz<ch a="e"/>ul<ch a="G"/>e:</row>
		</block>
		<block type="chorus">
			<row important_over="true">Przed t<ch a="C"/>obą sł<ch a="G"/>aw<ch a="C"/>a,</row>
			<row important_over="false">Wi<ch a="C"/>eczna zab<ch a="G"/>aw<ch a="C"/>a,</row>
			<row important_over="true">Wsz<ch a="F"/>ystko jak z n<ch a="G"/>ut,</row>
			<row important_over="false">Pi<ch a="F"/>eniędzy w br<ch a="G"/>ód.</row>
			<row important_over="false">Wspani<ch a="C"/>ałe pł<ch a="G"/>yt<ch a="C"/>y,</row>
			<row important_over="false">Pi<ch a="C"/>ękne kobi<ch a="G"/>et<ch a="C"/>y,</row>
			<row important_over="false">Zdr<ch a="F"/>owie jak dzw<ch a="G"/>on,</row>
			<row important_over="false">Wyg<ch a="F"/>odny tr<ch a="G"/>on.</row>
		</block>
		<block type="verse">
			<row important_over="false">Ż<ch a="C"/>egnam staruszkę lekki c<ch a="F"/>ał<ch a="G"/>y<ch a="C"/></row>
			<row important_over="false">I r<ch a="e"/>uszam w dół po sch<ch a="a"/>od<ch a="e"/>ach,<ch a="G"/></row>
			<row important_over="false">N<ch a="C"/>agle potykam się o m<ch a="F"/>ał<ch a="G"/>y<ch a="C"/></row>
			<row important_over="false">Wyj<ch a="e"/>ątek w jej progn<ch a="a"/>oz<ch a="e"/>ach.<ch a="G"/></row>
			<row important_over="false">I m<ch a="C"/>yślę tak, spadając z h<ch a="F"/>uki<ch a="G"/>em,<ch a="C"/></row>
			<row important_over="false">N<ch a="e"/>iby dojrzała gr<ch a="a"/>uszk<ch a="e"/>a:<ch a="G"/></row>
			<row important_over="false">W k<ch a="C"/>ońcu przyszedłem po na<ch a="F"/>uk<ch a="G"/>ę,<ch a="C"/></row>
			<row important_over="false">Z<ch a="e"/>atem niech żyje wr<ch a="a"/>óżk<ch a="e"/>a!<ch a="G"/></row>
			<row important_over="false">Niech cz<ch a="a"/>ęściej p<ch a="e"/>uka</row>
			<row important_over="false">W szkl<ch a="a"/>aną k<ch a="e"/>ulę</row>
			<row important_over="false">I m<ch a="a"/>ówi do nas cz<ch a="e"/>ul<ch a="G"/>e:</row>
		</block>
		<block type="chorus">
			<bis times="2">
				<row important_over="false">Przed w<ch a="C"/>ami sł<ch a="G"/>aw<ch a="C"/>a,</row>
				<row important_over="false">Wi<ch a="C"/>eczna zab<ch a="G"/>aw<ch a="C"/>a,</row>
				<row important_over="false">Wsz<ch a="F"/>ystko jak z n<ch a="G"/>ut,</row>
				<row important_over="false">Pi<ch a="F"/>eniędzy w br<ch a="G"/>ód,</row>
				<row important_over="false">Wspani<ch a="C"/>ałe pł<ch a="G"/>yt<ch a="C"/>y,</row>
				<row important_over="false">Pi<ch a="C"/>ękne kobi<ch a="G"/>et<ch a="C"/>y,</row>
				<row important_over="false">Zdr<ch a="F"/>owie jak dzw<ch a="G"/>on,</row>
				<row important_over="false">Wyg<ch a="F"/>odny tr<ch a="G"/>on.</row>
			</bis>
		</block>
	</lyric>
