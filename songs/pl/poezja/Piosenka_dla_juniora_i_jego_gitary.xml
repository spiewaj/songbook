<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Piosenka dla juniora i jego gitary">
  <alias>Wskocz w pudło gitary</alias>
  <text_author type="solo">Edward Stachura</text_author>
  <comment></comment>
  <composer type="solo">Krzysztof Myszkowski</composer>
  <artist type="band">Stare Dobre Małżeństwo</artist>
  <translator></translator>
  <original_title></original_title>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="G"/>Gdy pokłócisz się z dzi<ch a="D"/>ewczyną</row>
      <row important_over="true">(N<ch a="e"/>ie życzę ci, lecz r<ch a="C"/>óżnie jest),</row>
      <row important_over="false"><ch a="G"/>nie chciej zaraz marnie g<ch a="D"/>inąć,</row>
      <row important_over="true">z<ch a="C"/>aufaj mi, przek<ch a="D"/>onasz się:</row>
    </block>
    <block type="chorus">
      <row important_over="true">Sk<ch a="a"/>ocz w pudło gitary i t<ch a="C"/>am rozłóż się ob<ch a="G"/>ozem,<ch a="D"/></row>
      <row important_over="false">sk<ch a="a"/>ocz w pudło gitary, rat<ch a="C"/>unkowym ona k<ch a="G"/>ołem,<ch a="D"/></row>
      <row important_over="true">prz<ch a="a"/>eczekaj nachalną nawałn<ch a="C"/>icę,</row>
      <row important_over="true">w<ch a="G"/>yjdź potem ze słońcem na ul<ch a="D"/>icę,</row>
      <row important_over="true">w<ch a="a"/>yjdź potem ze słońcem <ch a="C"/>na ul<ch a="G"/>icę!</row>
    </block>
    <block type="verse">
      <row important_over="false"><ch a="G"/>Gdy ci będzie jakoś n<ch a="D"/>ie tak</row>
      <row important_over="false">(n<ch a="e"/>ie życzę ci, lecz r<ch a="C"/>óżnie jest),</row>
      <row important_over="false"><ch a="G"/>gdy ta słynna smuga ci<ch a="D"/>enia</row>
      <row important_over="false">prz<ch a="C"/>ypęta się, przer<ch a="D"/>azi cię:</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="false"><ch a="G"/>Aż cię znowu noc dop<ch a="D"/>adnie</row>
      <row important_over="false">(n<ch a="e"/>ie życzę ci, lecz r<ch a="C"/>óżnie jest),</row>
      <row important_over="false"><ch a="G"/>Ciemny Bóg się tobą z<ch a="D"/>ajmie,</row>
      <row important_over="false">l<ch a="C"/>ecz wtedy ty wyw<ch a="D"/>ijasz się:</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="other">
      <row important_over="true">I p<ch a="a"/>omóż słońcu, i pomóż sł<ch a="c"/>ońcu,</row>
      <row important_over="true">p<ch a="G"/>omóż słońcu lśnić!</row>
      <row important_over="false">I p<ch a="a"/>omóż słońcu, i pomóż sł<ch a="c"/>ońcu,</row>
      <row important_over="true">p<ch a="G"/>omóż sł<ch a="D"/>ońcu lśn<ch a="C"/>ić!<ch a="G"/></row>
    </block>
  </lyric>
