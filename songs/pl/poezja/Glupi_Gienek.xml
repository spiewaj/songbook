	<lyric>
		<block type="verse">
			<row important_over="true">Gi<ch a="D"/>enek gra na git<ch a="A"/>arze,</row>
			<row important_over="true">mi<ch a="G"/>ał być szewcem, lecz mu nie w<ch a="D"/>yszło.</row>
			<row important_over="true">Z<ch a="e"/>a oknem jes<ch a="h"/>ień</row>
			<row important_over="true">przyb<ch a="e"/>ija podk<ch a="h"/>ówki –</row>
			<row important_over="true">ch<ch a="G"/>yba na przyszł<ch a="A7"/>ość.</row>
		</block>
		<block type="chorus">
			<row important_over="true">Git<ch a="D"/>ara Gienka jest taka ci<ch a="A"/>enka,</row>
			<row important_over="true">p<ch a="G"/>o prostu mało ma str<ch a="D"/>un.</row>
			<row important_over="true">L<ch a="e"/>ecz Gienek jej wi<ch a="h"/>erzy,</row>
			<row important_over="true">wi<ch a="e"/>e, że struna p<ch a="h"/>ęka,</row>
			<row important_over="true">zwł<ch a="G"/>aszcza gdy cienka i j<ch a="A7"/>uż.</row>
		</block>
		<block type="verse">
			<row>Gi<ch a="D"/>enek nie będzie już sz<ch a="A"/>ewcem,</row>
			<row>b<ch a="G"/>o wbił sobie w głowę gw<ch a="D"/>óźdź.</row>
			<row>W<ch a="e"/>oli gitarę mieć za ż<ch a="h"/>onę,</row>
			<row>z git<ch a="e"/>arą bi<ch a="h"/>erze śl<ch a="G"/>ub. <ch a="A7"/></row>
		</block>
