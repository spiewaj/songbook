<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Wizyta u malarki">
	<alias>Wczoraj byłem u malarki</alias>
	<text_author type="solo">Andrzej Sikorowski</text_author>
	<comment/>
	<composer type="solo">Andrzej Sikorowski</composer>
	<artist type="band">Pod Budą</artist>
	<translator/>
	<original_title/>
	<lyric>
		<block type="verse">
			<row important_over="true">Wcz<ch a="C"/>oraj byłem <ch a="F"/>u mal<ch a="C"/>arki,</row>
			<row important_over="true">D<ch a="a"/>om jak dom i <ch a="D7"/>drzwi jak <ch a="G"/>drzwi,</row>
			<row important_over="true">J<ch a="F"/>ak u innych p<ch a="C"/>uste garnki</row>
			<row important_over="true">I w kom<ch a="B"/>inie sz<ch a="G"/>ary dym.</row>
			<row important_over="true">J<ch a="C"/>ak u innych st<ch a="F"/>ara bi<ch a="C"/>eda,</row>
			<row important_over="true">J<ch a="a"/>ak u innych w <ch a="D7"/>oknie k<ch a="G"/>it,</row>
			<row important_over="true">N<ch a="F"/>o i problem j<ch a="C"/>ak się nie dać,</row>
			<row important_over="true">Gdy nadci<ch a="B"/>ągnie t<ch a="G"/>ydzień zły.</row>
		</block>
		<block type="chorus">
			<row important_over="true">A<ch a="C"/>le z<ch a="F"/>a to n<ch a="C"/>a ści<ch a="G"/>an<ch a="B"/>ach kwi<ch a="C"/>aty</row>
			<row important_over="true">Ze wsz<ch a="a"/>ystkich świ<ch a="D7"/>ata ł<ch a="G"/>ąk,<ch a="G7"/></row>
			<row important_over="true">A tuż <ch a="C"/>obok k<ch a="F"/>oń pstr<ch a="C"/>ok<ch a="G"/>at<ch a="C"/>y,</row>
			<row important_over="true">N<ch a="a"/>a nim przy szabli d<ch a="D7"/>umny kt<ch a="G"/>oś.<ch a="G7"/></row>
			<row important_over="true">N<ch a="C"/>a martwych n<ch a="F"/>at<ch a="C"/>ur<ch a="G"/>ach ci<ch a="C"/>asta,</row>
			<row important_over="true">Kt<ch a="a"/>órym zapachu t<ch a="D7"/>ylko br<ch a="G"/>ak,<ch a="G7"/></row>
			<row important_over="true">A w<ch a="F"/>yżej podni<ch a="G"/>ebne mi<ch a="C"/>asto</row>
			<row important_over="true">J<ch a="F"/>ak ciemnozł<ch a="G"/>oty pt<ch a="C"/>ak.</row>
		</block>
		<block type="verse">
			<row important_over="false">Wcz<ch a="C"/>oraj byłem <ch a="F"/>u mal<ch a="C"/>arki</row>
			<row important_over="false">I j<ch a="a"/>uż wiem, dokł<ch a="D7"/>adnie wi<ch a="G"/>em,</row>
			<row important_over="false">Ż<ch a="F"/>e najczęściej p<ch a="C"/>uste garnki</row>
			<row important_over="false">Są dl<ch a="B"/>a życia t<ch a="G"/>ylko tłem,</row>
			<row important_over="false">Ż<ch a="C"/>e się chowa st<ch a="F"/>ara bi<ch a="C"/>eda</row>
			<row important_over="false">I t<ch a="a"/>ężeje w <ch a="D7"/>oknie k<ch a="G"/>it,</row>
			<row important_over="false">Zn<ch a="F"/>ika problem j<ch a="C"/>ak się nie dać</row>
			<row important_over="false">I pyt<ch a="B"/>anie, z k<ch a="G"/>im się bić.</row>
		</block>
		<block type="chorus">
			<row important_over="false">Ki<ch a="C"/>edy r<ch a="F"/>osną n<ch a="C"/>a ści<ch a="G"/>an<ch a="B"/>ach kwi<ch a="C"/>aty</row>
			<row important_over="false">Ze wsz<ch a="a"/>ystkich świ<ch a="D7"/>ata ł<ch a="G"/>ąk,<ch a="G7"/></row>
			<row important_over="false">G<ch a="C"/>alop<ch a="F"/>uje k<ch a="C"/>oń pstr<ch a="G"/>ok<ch a="C"/>aty,</row>
			<row important_over="false">I w<ch a="a"/>ymachuje sz<ch a="D7"/>ablą kt<ch a="G"/>oś.<ch a="G7"/></row>
			<row important_over="false">N<ch a="C"/>a martwych n<ch a="F"/>at<ch a="C"/>ur<ch a="G"/>ach ci<ch a="C"/>asta,</row>
			<bis>
				<row important_over="false">J<ch a="a"/>uż się migdałów cz<ch a="D7"/>uje sm<ch a="G"/>ak,<ch a="G7"/></row>
				<row important_over="false">I fr<ch a="F"/>uwa podni<ch a="G"/>ebne mi<ch a="C"/>asto</row>
				<row important_over="false">P<ch a="F"/>o wszystkich m<ch a="G"/>oich sn<ch a="C"/>ach.</row>
			</bis>
		</block>
	</lyric>
	<music metre="4/4">
		<guitar barre="0"/>
	</music>
