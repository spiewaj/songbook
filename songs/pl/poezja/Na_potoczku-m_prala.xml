<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Na potoczku-m prała">
	<alias/>
	<text_author type="solo">tradycyjny</text_author>
	<comment/>
	<composer type="solo">tradycyjny</composer>
	<artist type="band">Orkiestra św. Mikołaja</artist>
	<lyric>
		<block type="verse">
			<row important_over="true"><ch a="d"/>Na potoczku-m prała,</row>
			<row important_over="true"><ch a="A7"/>Na werboczku-m kłała,</row>
			<row important_over="true"><ch a="d"/>Pomoży mi, Pan’e Boże,</row>
			<row important_over="true"><ch a="A7"/>Szczo-m sobi dum<ch a="d"/>ała.</row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="d"/>Jam sobi dumała</row>
			<row important_over="false"><ch a="A7"/>Chłopcia mołodoho,</row>
			<row important_over="false"><ch a="d"/>A mene wydali</row>
			<row important_over="false"><ch a="A7"/>Za dida star<ch a="d"/>oho.</row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="d"/>Jak mn’e wydawali,</row>
			<row important_over="false"><ch a="A7"/>Tak mene kazali,</row>
			<row important_over="false"><ch a="d"/>Abyś moja Doniu</row>
			<row important_over="false"><ch a="A7"/>Dida czestuw<ch a="d"/>ała.</row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="d"/>Ja dida czesuju,</row>
			<row important_over="false"><ch a="A7"/>Czestuwaty muszu,</row>
			<row important_over="false"><ch a="d"/>Pomoży mi, Pan’e Boże,</row>
			<row important_over="false"><ch a="A7"/>Wiźmi z dida d<ch a="d"/>uszu!</row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="d"/>Wiźmi z dida duszu,</row>
			<row important_over="false"><ch a="A7"/>Taj powiś na chruszu,</row>
			<row important_over="false"><ch a="d"/>Szczuby starym znaty,</row>
			<row important_over="false"><ch a="A7"/>Jak mołodu br<ch a="d"/>aty.</row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="d"/>Zabrał Boh staroho,</row>
			<row important_over="false"><ch a="A7"/>Nie dał mołodoho.</row>
			<row important_over="false"><ch a="d"/>Pomoży mi, Pan’e Boże,</row>
			<row important_over="false"><ch a="A7"/>Widdaj choć star<ch a="d"/>oho!</row>
		</block>
	</lyric>
	<music metre="2/4">
		<guitar/>
	</music>
