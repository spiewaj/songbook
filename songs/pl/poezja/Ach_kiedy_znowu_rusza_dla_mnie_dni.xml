	<alias>Ach, kiedy znowu ruszą…</alias>
	<text_author type="solo">Edward Stachura</text_author>
	<comment/>
	<composer type="solo">Krzysztof Myszkowski</composer>
	<artist type="band">Stare Dobre Małżeństwo</artist>
	<translator/>
	<original_title/>
	<lyric>
		<block type="verse">
			<row important_over="true">Mi<ch a="D"/>nęło wiele mie<ch a="e"/>sięcy,</row>
			<row important_over="true">ale <ch a="G"/>mnie nic nie mi<ch a="D"/>nęło.</row>
			<row>Czas <ch a="D"/>dla mnie w miejscu przy<ch a="e"/>stanął,</row>
			<row>takie jest, <ch a="G"/>chłopcy, <ch a="A"/>takie jest <ch a="D"/>piekło.</row>
			<row>Na <ch a="D"/>odgłos kroków po <ch a="e"/>schodach</row>
			<row>serce <ch a="G"/>wciąż skacze do <ch a="D"/>gardła,</row>
			<row>że <ch a="D"/>może to jednak to <ch a="e"/>ona,</row>
			<row>ona, <ch a="G"/>to piękna <ch a="A"/>moja za<ch a="D"/>głada.</row>
		</block>
		<block type="chorus">
			<row important_over="true">Ach, <ch a="Fis7"/>kiedy znowu ruszą dla mnie dni,</row>
			<row important_over="true">noce i <ch a="h"/>dni,</row>
			<row>i <ch a="G"/>pory <ch a="D"/>roku krążyć <ch a="C"/>zaczną znów,</row>
			<row>jak <ch a="G"/>obieg <ch a="D"/>krwi.</row>
			<row>Lato, jesień, zima, <ch a="Fis7"/>wiosna,</row>
			<row>do Boliwii droga <ch a="h"/>prosta. <ch a="G"/></row>
			<row>Wiosna, <ch a="D"/>lato, <ch a="C"/>jesień, <ch a="G"/>zima,</row>
			<row>nic mi nie przypo<ch a="D"/>mi<ch a="A7"/>na.</row>
		</block>
		<block type="verse">
			<row>Ni <ch a="D"/>żyć już można, ni <ch a="e"/>umrzeć,</row>
			<row>wypła<ch a="G"/>kane łzy do<ch a="D"/>szczętnie.</row>
			<row>Oddy<ch a="D"/>cham ledwie i z <ch a="e"/>bólem,</row>
			<row>kością mi w <ch a="G"/>gardle <ch a="A"/>staje po<ch a="D"/>wietrze.</row>
			<row>Czy <ch a="D"/>tak już będzie i <ch a="e"/>będzie,</row>
			<row>Boże mój, <ch a="G"/>Boże mój, <ch a="D"/>Boże?</row>
			<row>Za<ch a="D"/>wsze i wszędzie w ob<ch a="e"/>łędzie,</row>
			<row>Boże mój, <ch a="G"/>wbiłeś we mnie <ch a="A"/>wszystkie <ch a="D"/>noże!</row>
		</block>
		<blocklink blocknb="2"/>
	</lyric>
