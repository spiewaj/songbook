<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Tęsknica">
  <alias>Na przełęczy przysiadł wrzesień</alias>
  <text_author type="solo">Andrzej Wierzbicki</text_author>
  <comment>Klasyczna ballada turystyczna Andrzeja Wierzbickiego (związana m.in. z grupą Seta).</comment>
  <composer type="solo">Andrzej Wierzbicki</composer>
  <artist type="solo">Andrzej Wierzbicki</artist>
  <lyric>
    <block type="verse">
      <row important_over="true">Na przełęczy pr<ch a="D"/>zysiadł wrzesień,</row>
      <row important_over="true"><ch a="G"/> śmieje si<ch a="D"/>ę ukr<ch a="H7"/>adkiem.</row>
      <row important_over="true"><ch a="e"/> Skrzydłem kruka wł<ch a="D"/>osy czesze</row>
      <row important_over="true"><ch a="e"/> rozczochr<ch a="H7"/>anym wi<ch a="e"/>atrom.</row>
      <row important_over="true">Bucz<ch a="C"/>ynie jej w<ch a="G"/>argi sine</row>
      <row important_over="true">mal<ch a="C"/>uje czerwi<ch a="H7"/>enią</row>
      <row important_over="true"><ch a="e"/> i korale j<ch a="D"/>arzębinie</row>
      <row important_over="true"><ch a="C"/> w bańki c<ch a="H7"/>erkwi l<ch a="e"/>eje.</row>
      <row important_over="false" style="instr"><ch a="e"/><ch a="C"/><ch a="H7"/><ch a="e"/></row>
    </block>
    <block type="chorus">
      <row important_over="true">Do gór, do besk<ch a="C"/>idzkich gór</row>
      <row important_over="true"><ch a="D"/> zawracamy kr<ch a="e"/>oki,</row>
      <row important_over="true">przez równin ziel<ch a="C"/>ony mur,</row>
      <row important_over="true"><ch a="D"/> dolin rzecznych kr<ch a="e"/>ocie.</row>
      <row important_over="true">Do gór, do besk<ch a="C"/>idzkich gór</row>
      <row important_over="true"><ch a="D"/> zawracamy <ch a="G"/>ocz<ch a="H7"/>y,</row>
      <row important_over="true">by d<ch a="e"/>ojrzeć w bucz<ch a="C"/>yny pniach</row>
      <row important_over="true"><ch a="D"/> Madonn twarze zł<ch a="e"/>ote.</row>
      <row important_over="false" style="instr"><ch a="e"/><ch a="C"/><ch a="H7"/><ch a="e"/><ch a="C"/><ch a="H7"/><ch a="e"/></row>
    </block>
    <block type="verse">
      <row important_over="false">Mgły strącając p<ch a="D"/>o dolinach,</row>
      <row important_over="false"><ch a="G"/> jesień w<ch a="D"/>ozem j<ch a="H7"/>edzie,</row>
      <row important_over="false"><ch a="e"/> znarowione k<ch a="D"/>onie spina,</row>
      <row important_over="false"><ch a="e"/> w<ch a="H7"/>orek chl<ch a="e"/>eba wiezie.</row>
      <row important_over="false">I n<ch a="C"/>aszym woł<ch a="G"/>aniem</row>
      <row important_over="false">zmęcz<ch a="C"/>ona odch<ch a="H7"/>odzi,</row>
      <row important_over="false"><ch a="e"/> tylko echo w<ch a="D"/>yprowadza</row>
      <row important_over="false"><ch a="C"/> na rozst<ch a="H7"/>ajne dr<ch a="e"/>ogi.</row>
      <row important_over="false" style="instr"><ch a="e"/><ch a="C"/><ch a="H7"/></row>
    </block>
    <blocklink blocknb="2"/>
  </lyric>
  <music metre="4/4">
    <guitar barre="0"/>
  </music>
