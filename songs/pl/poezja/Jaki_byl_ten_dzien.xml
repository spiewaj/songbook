	<lyric>
		<block type="verse">
			<row important_over="true">P<ch a="d"/>óźno j<ch a="B"/>uż, otwi<ch a="C"/>era się n<ch a="a"/>oc,</row>
			<row important_over="true">sen podch<ch a="B"/>odzi do drz<ch a="F"/>wi na p<ch a="G"/>alcach jak k<ch a="A"/>ot.</row>
			<row important_over="true">N<ch a="d"/>adchodzi cz<ch a="B"/>as uci<ch a="C"/>eczki na a<ch a="a"/>ut,</row>
			<row important_over="true">gdy kol<ch a="B"/>ejny mój dzi<ch a="F"/>eń wspomni<ch a="G"/>eniem się st<ch a="A"/>ał.</row>
		</block>
		<block type="chorus">
			<row important_over="true">Jaki b<ch a="d"/>ył ten dzi<ch a="B"/>eń, co dar<ch a="C"/>ował, co wzi<ch a="a"/>ął?</row>
			<row important_over="true">Czy mnie wyni<ch a="B"/>ósł pod ni<ch a="F"/>ebo, czy rz<ch a="G"/>ucił na dn<ch a="A"/>o?</row>
			<row important_over="true">Jaki b<ch a="d"/>ył ten dzi<ch a="B"/>eń, czy coś zmi<ch a="C"/>enił, czy ni<ch a="a"/>e?</row>
			<row important_over="true">Czy był t<ch a="B"/>ylko nadzi<ch a="F"/>eją na d<ch a="G"/>obre i zł<ch a="A"/>e?</row>
		</block>
		<block type="verse">
			<row important_over="false">Ł<ch a="d"/>agodny mr<ch a="B"/>ok zasł<ch a="C"/>ania mi tw<ch a="a"/>arz,</row>
			<row important_over="false">jakby prz<ch a="B"/>eczuł, że chc<ch a="F"/>ę być s<ch a="G"/>obą choć r<ch a="A"/>az.</row>
			<row important_over="false">Nie sk<ch a="d"/>arżę si<ch a="B"/>ę, że m<ch a="C"/>am to, co m<ch a="a"/>am,</row>
			<row important_over="false">że prz<ch a="B"/>egrałem coś zn<ch a="F"/>ów, że j<ch a="G"/>estem znów s<ch a="A"/>am.</row>
		</block>
		<block type="chorus">
			<row important_over="false">Jaki b<ch a="d"/>ył ten dzi<ch a="B"/>eń, co dar<ch a="C"/>ował, co wzi<ch a="a"/>ął?</row>
			<row important_over="false">Czy mnie wyni<ch a="B"/>ósł pod ni<ch a="F"/>ebo, czy rz<ch a="G"/>ucił na dn<ch a="A"/>o?</row>
			<row important_over="false">Jaki b<ch a="d"/>ył ten dzi<ch a="B"/>eń, czy coś zmi<ch a="C"/>enił, czy ni<ch a="a"/>e?</row>
			<row important_over="false">Czy był t<ch a="B"/>ylko nadzi<ch a="F"/>eją na d<ch a="G"/>obre i zł<ch a="A"/>e?</row>
		</block>
