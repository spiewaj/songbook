<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Zapiszę śniegiem w kominie">
	<alias/>
	<text_author type="solo">Robert Kasprzycki</text_author>
	<comment/>
	<composer type="solo">Robert Kasprzycki</composer>
	<artist type="solo">Robert Kasprzycki</artist>
	<translator/>
	<original_title/>
	<lyric>
		<block type="verse">
			<row important_over="true"><ch a="G"/>A jeśli za<ch a="D"/>braknie na <ch a="C"/>koncie pie<ch a="G"/>niędzy</row>
			<row important_over="true">I w <ch a="G"/>kącie za<ch a="D"/>gnieździ się <ch a="C"/>bieda,</row>
			<row important_over="true">Po <ch a="G"/>rozum do <ch a="D"/>głowy po<ch a="C"/>biegnę, niech <ch a="G"/>powie,</row>
			<row important_over="true">Co <ch a="G"/>sprzedać, by <ch a="D"/>siebie nie <ch a="C"/>sprzedać.</row>
		</block>
		<block type="chorus">
			<row important_over="true"><ch a="G"/>Zapiszę <ch a="D"/>śniegiem w kominie,</row>
			<row important_over="true"><ch a="e"/>Zaplotę z <ch a="D"/>dymu warkoczyk,</row>
			<row important_over="true">I <ch a="C"/>zanim <ch a="G"/>zima z gór spłynie – <ch a="D"/>wrócę.</row>
			<row important_over="false"><ch a="G"/>Zapiszę <ch a="D"/>śniegiem w kominie,</row>
			<row important_over="false"><ch a="e"/>Warkoczyk z <ch a="D"/>dymu zaplotę,</row>
			<row important_over="false">I <ch a="C"/>zanim <ch a="G"/>zima z gór spłynie – <ch a="D"/>wrócę</row>
			<row important_over="true">I <ch a="C"/>będę z po<ch a="G"/>wrotem…</row>
		</block>
		<block type="verse">
			<row important_over="false"><ch a="G"/>A jeśli nie <ch a="D"/>znajdę w swej <ch a="C"/>głowie ro<ch a="G"/>zumu,</row>
			<row important_over="false">To <ch a="G"/>paszport od<ch a="D"/>najdę w szu<ch a="C"/>fladzie,</row>
			<row important_over="false"><ch a="G"/>Zapytam go, <ch a="D"/>może on <ch a="C"/>pewnie po<ch a="G"/>może,</row>
			<row important_over="false">Po<ch a="G"/>radzi, jak <ch a="D"/>sobie po<ch a="C"/>radzić.</row>
		</block>
		<blocklink blocknb="2"/>
		<block type="verse">
			<row important_over="false"><ch a="G"/>A jeśli za<ch a="D"/>braknie Ci <ch a="C"/>w sercu na<ch a="G"/>dziei,</row>
			<row important_over="false">Bo <ch a="G"/>powrót jest <ch a="D"/>zawsze da<ch a="C"/>leko,</row>
			<row important_over="false">Przy<ch a="G"/>pomnij te <ch a="D"/>słowa, wy<ch a="C"/>śpiewaj od <ch a="G"/>nowa,</row>
			<row important_over="false">Bym <ch a="G"/>wiedział, że <ch a="D"/>ktoś na mnie <ch a="C"/>czeka.</row>
		</block>
		<blocklink blocknb="2"/>
	</lyric>
