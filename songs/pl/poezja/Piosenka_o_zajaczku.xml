<?xml version="1.0" encoding="UTF-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Piosenka o zajączku">
  <alias>Letnia piosenka o zajączku</alias>
  <text_author type="solo">Wojciech Bellon</text_author>
  <comment/>
  <composer type="solo">Wojciech Bellon</composer>
  <artist type="band">Wolna Grupa Bukowina</artist>
  <translator/>
  <original_title/>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="G"/>Mam mało cz<ch a="F"/>asu, tak ma<ch a="C"/>ło jak pi<ch a="G"/>achu</row>
      <row important_over="true">W dzi<ch a="D"/>ecięcej g<ch a="A"/>arści nad rz<ch a="G"/>eką,</row>
      <row important_over="true">Zwi<ch a="G"/>eram powi<ch a="F"/>eki, zatrz<ch a="C"/>ymać <ch a="G"/>obraz,</row>
      <row important_over="true">C<ch a="D"/>o z moich wsp<ch a="A"/>omnień uci<ch a="G"/>eka.</row>
    </block>
    <block type="chorus">
      <row important_over="true">Bledną k<ch a="D"/>olory i płynie, p<ch a="F"/>łynie</row>
      <row important_over="true">Rz<ch a="C"/>eka po szarej ł<ch a="G"/>ące</row>
      <row important_over="true">I płynie, płynie, ni<ch a="D"/>erealni<ch a="F"/>ejąc</row>
      <row important_over="true">Rz<ch a="C"/>eką zielony za<ch a="e"/>jączek.</row>
    </block>
    <block type="verse">
      <row><ch a="G"/>Biegnę, wciąż bi<ch a="F"/>egnę przed si<ch a="C"/>ebie, w si<ch a="G"/>ebie,</row>
      <row>T<ch a="D"/>ęczę rozg<ch a="A"/>arniam ręk<ch a="G"/>ami,</row>
      <row>L<ch a="G"/>etnim up<ch a="F"/>ałem wyt<ch a="C"/>rzeć do s<ch a="G"/>ucha</row>
      <row>Sp<ch a="D"/>otniałą, w<ch a="A"/>ilgotną pam<ch a="G"/>ięć.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row>Rz<ch a="G"/>eki jaszcz<ch a="F"/>urka w tr<ch a="C"/>awie się w<ch a="G"/>ije,</row>
      <row>Sł<ch a="D"/>ońce się ch<ch a="A"/>yli zrudzi<ch a="G"/>ałe,</row>
      <row>Wi<ch a="G"/>eczną ziel<ch a="F"/>oność zach<ch a="C"/>ować w <ch a="G"/>oczach,</row>
      <row>T<ch a="D"/>ak wiele pr<ch a="A"/>agnę, tak m<ch a="G"/>ało.</row>
    </block>
    <blocklink blocknb="2"/>
    <block type="verse">
      <row important_over="true">Bl<ch a="D"/>edną wspomnienia i płynie rz<ch a="F"/>eka</row>
      <row important_over="true">B<ch a="C"/>ez końca i bez pocz<ch a="G"/>ątku,</row>
      <row important_over="true">N<ch a="D"/>asyć me oczy kolorem r<ch a="F"/>osy</row>
      <row important_over="true">I drzw<ch a="C"/>i mi otwórz, za<ch a="e"/>jączku.</row>
    </block>
  </lyric>
  <music metre="4/4">
    <guitar/>
  </music>
