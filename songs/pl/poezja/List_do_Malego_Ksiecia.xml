	<lyric>
		<block type="other">
			<row important_over="false" style="instr"><ch a="G"/><ch a="e"/><ch a="C"/><ch a="D"/><ch a="h"/><ch a="C"/><ch a="G"/><ch a="F"/><ch a="C"/><ch a="D"/><ch a="D7"/></row>
		</block>
		<block type="verse">
			<row important_over="true">Z<ch a="G"/>agubieni, Ksi<ch a="e"/>ążę, jesteśmy,</row>
			<row important_over="true">P<ch a="C"/>od gwiazdami grz<ch a="D"/>ejemy ręce,</row>
			<row important_over="true">Ni<ch a="h"/>ebo śmieje się sz<ch a="C"/>eroko,</row>
			<row important_over="true">N<ch a="G"/>asze niebo to j<ch a="F"/>ednak c<ch a="C"/>oś wi<ch a="D"/>ęc<ch a="D7"/>ej.</row>
		</block>
		<block type="verse">
			<row important_over="false">Ni<ch a="G"/>espokojnie, Ksi<ch a="e"/>ążę, żyjemy,</row>
			<row important_over="false">Wśr<ch a="C"/>ód szeptanych kr<ch a="D"/>ucho skarg,</row>
			<row important_over="false">Dzi<ch a="h"/>eń do dnia się d<ch a="C"/>odaje,</row>
			<row important_over="false">W d<ch a="G"/>obrą gwiazdę trzeba wi<ch a="F"/>erz<ch a="C"/>yć n<ch a="D"/>am.<ch a="D7"/></row>
		</block>
		<block type="verse">
			<row important_over="false">N<ch a="G"/>asze wieczne uci<ch a="e"/>eczki-wycieczki,</row>
			<row important_over="false">N<ch a="C"/>asze wzdychanie w ni<ch a="D"/>eznane,</row>
			<row important_over="false">Ki<ch a="h"/>edy niebo cię <ch a="C"/>olśni,</row>
			<row important_over="false">Wi<ch a="G"/>esz, że zaczął się wi<ch a="F"/>elk<ch a="C"/>i t<ch a="D"/>ani<ch a="D7"/>ec.</row>
		</block>
		<block type="other">
			<row important_over="false" style="instr"><ch a="G"/><ch a="e"/><ch a="C"/><ch a="D"/><ch a="h"/><ch a="C"/><ch a="G"/><ch a="F"/><ch a="C"/><ch a="D"/><ch a="D7"/></row>
		</block>
		<block type="verse">
			<row important_over="false">P<ch a="G"/>od gwiazdami, Ksi<ch a="e"/>ążę, jesteśmy,</row>
			<row important_over="false">P<ch a="C"/>od gwiazdami grz<ch a="D"/>ejemy ręce,</row>
			<row important_over="false">Ni<ch a="h"/>ebo śmieje się <ch a="C"/>otwarcie</row>
			<row important_over="false">I ni<ch a="G"/>e trzeba wt<ch a="F"/>edy n<ch a="C"/>ic wi<ch a="D"/>ęc<ch a="D7"/>ej.</row>
		</block>
		<block type="other">
			<row important_over="false" style="instr"><ch a="G"/><ch a="e"/><ch a="C"/><ch a="D"/><ch a="h"/><ch a="C"/><ch a="G"/><ch a="F"/><ch a="C"/><ch a="D"/><ch a="D7"/></row>
		</block>
