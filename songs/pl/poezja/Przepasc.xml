<?xml version="1.0" encoding="utf-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="Przepaść">
  <alias>Tego dnia obcy ludzie</alias>
  <text_author type="solo">autor nieznany</text_author>
  <comment>Piosenka ze środowiskowego repertuaru 21 WDH; autor tekstu, kompozytor i oficjalne źródło nieustalone w ogólnodostępnych bazach muzycznych.</comment>
  <composer type="solo">autor nieznany</composer>
  <lyric>
    <block type="verse">
      <row important_over="true"><ch a="e"/>Tego dnia obcy ludzie</row>
      <row important_over="true"><ch a="C"/>Zadławili we mnie tak zwaną <ch a="G"/><ch a="a"/></row>
      <row important_over="true"><ch a="C"/>Jasność spojrzenia <ch a="G"/></row>
      <row important_over="true"><ch a="e"/>W kanion strachu zagonili</row>
      <row important_over="true"><ch a="C"/>A jemu serce pękło <ch a="G"/><ch a="a"/></row>
      <row important_over="true"><ch a="G"/>W tej samej chwili</row>
      <row important_over="true"><ch a="C"/>A bez jego mocnej dłoni <ch a="G"/></row>
      <row important_over="true"><ch a="C"/>A bez tych pogodnych spojrzeń <ch a="G"/></row>
      <row important_over="true"><ch a="C"/>Czeka mnie <ch a="G"/></row>
      <row important_over="true"><ch a="D"/>Czeka mnie</row>
      <bis>
        <row important_over="false"><ch a="C"/>Przepaść <ch a="D"/><ch a="e"/></row>
        <row important_over="false"><ch a="C"/>Studnia dźwięków i mgła <ch a="D"/><ch a="e"/></row>
        <row important_over="false"><ch a="C"/>Przepaść <ch a="D"/><ch a="e"/></row>
        <row important_over="false"><ch a="C"/>Idę do niej tam <ch a="D"/><ch a="e"/></row>
      </bis>
    </block>
  </lyric>
  <music metre="4/4">
    <guitar barre="0"/>
  </music>
  <genre>piosenka harcerska</genre>
  <status>
    <done>
      <text/>
    </done>
    <verificators>
      <verificator>Piotr Tabernacki</verificator>
    </verificators>
    <to_do>Autor tekstu i muzyki oraz oryginalne nagranie nieustalone w publicznych źródłach; piosenka zachowana w tradycji śpiewnika 21 WDH.</to_do>
  </status>
</song>
