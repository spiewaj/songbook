<?xml version="1.0" encoding="UTF-8"?>
<song xmlns="http://21wdh.staszic.waw.pl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://21wdh.staszic.waw.pl https://spiewaj.com/song.xsd" title="W lesie listopadowym">
	<alias>Wokół góry, góry i góry</alias>
	<text_author type="solo">Jerzy Harasymowicz</text_author>
	<comment>Muzyka: Zbigniew Bogdański i Andrzej Koczewski.</comment>
	<composer type="solo">Zbigniew Bogdański</composer>
	<artist type="band">Dom o Zielonych Progach</artist>
	<lyric xmlns="http://21wdh.staszic.waw.pl">
		<block type="chorus">
			<row important_over="true"><ch a="E"/>Wokół góry, g<ch a="a"/>óry i góry</row>
			<row important_over="true"><ch a="E"/>I całe moje ż<ch a="a"/>ycie w górach</row>
			<row important_over="true"><ch a="C"/>Ileż piękniej drozdy l<ch a="G"/>eśne śpiewają</row>
			<row important_over="true"><ch a="E"/>Niż śpiewak płatny na ch<ch a="a"/>órach</row>
			<row important_over="false"><ch a="E"/>Wokół lasy, l<ch a="a"/>asy i wiatr</row>
			<row important_over="false"><ch a="E"/>I całe życie w wi<ch a="a"/>atru świstach</row>
			<row important_over="false"><ch a="C"/>Wszyscy, których kocham — w<ch a="G"/>ita Was</row>
			<row important_over="false"><ch a="E"/>Modrzewia ikona złoc<ch a="a"/>ista</row>
		</block>
		<block type="verse">
			<row important_over="true"><ch a="d"/>Jak łasiczki śc<ch a="E"/>ieżka w śni<ch a="A"/>egu</row>
			<row important_over="true"><ch a="d"/>Droga życia b<ch a="G"/>yła kr<ch a="C"/>ęta</row>
			<row important_over="true"><ch a="d"/>Teraz z góry z<ch a="E"/>eszła na mn<ch a="A"/>ie</row>
			<row important_over="true"><ch a="E"/>Młodych jodeł zi<ch a="a"/>eleń święta</row>
			<row important_over="false"><ch a="d"/>Nieludzką r<ch a="E"/>ęką malow<ch a="A"/>any</row>
			<row important_over="false"><ch a="d"/>Jest wielki smutek d<ch a="G"/>uszy m<ch a="C"/>ojej</row>
			<row important_over="false"><ch a="d"/>Lecz nawet zł<ch a="E"/>ockiej ik<ch a="A"/>onie</row>
			<row important_over="false"><ch a="E"/>Ja nigdy nic nie powi<ch a="a"/>em</row>
		</block>
		<blocklink blocknb="1"/>
		<block type="verse">
			<row important_over="false"><ch a="d"/>Ważne są tylko kop<ch a="E"/>uły pi<ch a="A"/>eśni</row>
			<row important_over="false"><ch a="d"/>Które na górze wys<ch a="G"/>okiej zost<ch a="C"/>aną</row>
			<row important_over="false"><ch a="d"/>I nikt nie szuka inicj<ch a="E"/>ałów ci<ch a="A"/>eśli</row>
			<row important_over="false"><ch a="E"/>Gdy cieśle dom postawi<ch a="a"/>ą</row>
			<row important_over="false"><ch a="d"/>Przyjaciele, którzy jemi<ch a="E"/>ołę czc<ch a="A"/>icie</row>
			<row important_over="false"><ch a="d"/>Dobrze, że chodz<ch a="G"/>icie świ<ch a="C"/>atem</row>
			<row important_over="false"><ch a="d"/>Wkrótce jodełkę ziel<ch a="E"/>oną spal<ch a="A"/>icie</row>
			<row important_over="false"><ch a="E"/>By darzyła was ciepłym l<ch a="a"/>atem</row>
		</block>
		<blocklink blocknb="1"/>
	</lyric>
	<music metre="4/4">
		<guitar barre="0"/>
	</music>
